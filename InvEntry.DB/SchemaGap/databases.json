{
  "reportsDir": "reports",
  "tools": {
    "sqlpackage": "auto",
    "msbuild": "auto",
    "sqlcmd": "sqlcmd"
  },
  "defaultOptions": {
    "BlockOnPossibleDataLoss": "True",
    "DropObjectsNotInSource": "False",
    "DropIndexesNotInSource": "False",
    "DropConstraintsNotInSource": "False",
    "DropDmlTriggersNotInSource": "False",
    "DropStatisticsNotInSource": "False",
    "DropExtendedPropertiesNotInSource": "False",
    "DropPermissionsNotInSource": "False",
    "DropRoleMembersNotInSource": "False",
    "IgnorePermissions": "True",
    "IgnoreRoleMembership": "True",
    "IgnoreLoginSids": "True",
    "IgnoreColumnOrder": "True",
    "IgnoreWhitespace": "True",
    "IgnoreKeywordCasing": "True",
    "IgnoreSemicolonBetweenStatements": "True",
    "ScriptDatabaseOptions": "False",
    "GenerateSmartDefaults": "False",
    "ExcludeObjectTypes": "Users;Logins;RoleMembership;Permissions;Credentials;DatabaseScopedCredentials;ServerRoles;ServerRoleMembership;DatabaseOptions;Filegroups;Files;EventSessions;Routes;Endpoints;ServerTriggers;LinkedServers;LinkedServerLogins;ErrorMessages;Audits;ServerAuditSpecifications"
  },
  "databases": {
    "mijms": {
      "description": "InvEntry application database",
      "build": "msbuild",
      "project": "..\\InvEntry.DB.sqlproj",
      "dacpac": "..\\bin\\Release\\InvEntry.DB.dacpac",
      "options": {},
      "targets": {
        "dev": {
          "server": ".\\SQLEXPRESS",
          "database": "mijms",
          "auth": "windows"
        },
        "prod": {
          "server": "CHANGE-ME\\SQLEXPRESS",
          "database": "mijms",
          "auth": "windows",
          "requireConfirm": true,
          "backupDir": "D:\\Backup"
        }
      }
    }
  }
}
