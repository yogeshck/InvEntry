<dx:ThemedWindow x:Class="InvEntry.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                 xmlns:dxwuit="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/themekeys"
                 xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                 xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                 xmlns:views="clr-namespace:InvEntry.Views"
                 xmlns:page="clr-namespace:InvEntry.Views.Page"
                 xmlns:ext="clr-namespace:InvEntry.Extension"
                 xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
                 Title="{Binding Identity.WindowTitle}"
                 Height="800"
                 Width="1400"
                 MinHeight="650"
                 MinWidth="1000"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Maximized"
                 ResizeMode="CanResizeWithGrip"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Icon="InvEntry.ico"
                 DataContext="{ext:DISource Type={x:Type viewmodels:MainWindowViewModel}}">


    <!-- =========================================================
         RESOURCES
         ========================================================= -->

    <dx:ThemedWindow.Resources>


        <!-- Application Name -->

        <Style x:Key="AppBrandTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="20" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>


        <!-- Application Subtitle -->

        <Style x:Key="AppBrandSubtitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="10" />

            <Setter Property="FontWeight"
                    Value="Medium" />

            <Setter Property="Opacity"
                    Value="0.60" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>


        <!-- Rate Caption -->

        <Style x:Key="RateCaptionStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="10" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Opacity"
                    Value="0.60" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>


        <!-- Rate Value -->

        <Style x:Key="RateValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <!-- Submenu navigation buttons do not expose a Glyph property.
             Use their standard Tag property as the verified SVG source and
             render it alongside the existing content without changing navigation. -->
        <Style TargetType="dxwui:HamburgerSubMenuNavigationButton">
            <!-- Moving to another flyout item closes any open second-level flyout. -->
            <EventSetter Event="MouseEnter"
                         Handler="OnSubMenuItemMouseEnter" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="18"
                                   Height="18"
                                   Margin="0,0,10,0"
                                   Source="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type dxwui:HamburgerSubMenuNavigationButton}}}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Items of a second-level flyout (e.g. Finance > RD).
             Uses the hamburger theme brushes so it matches the Finance flyout. -->
        <Style x:Key="CascadeFlyoutItemStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource {dxwuit:HamburgerMenuBrushesThemeKey ResourceKey=FlyoutItemForegroundBrush}}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Padding"
                    Value="14,0,24,0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Width="18"
                                       Height="18"
                                       Margin="0,0,10,0"
                                       Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="{DynamicResource {dxwuit:HamburgerMenuBrushesThemeKey ResourceKey=FlyoutItemHoverBackgroundBrush}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {dxwuit:HamburgerMenuBrushesThemeKey ResourceKey=FlyoutItemHoverForegroundBrush}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="{DynamicResource {dxwuit:HamburgerMenuBrushesThemeKey ResourceKey=FlyoutItemHoverBackgroundBrush}}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="{DynamicResource {dxwuit:HamburgerMenuBrushesThemeKey ResourceKey=FlyoutItemPressedBackgroundBrush}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </dx:ThemedWindow.Resources>



    <!-- =========================================================
         MAIN WINDOW
         ========================================================= -->

    <Grid>


        <Grid.RowDefinitions>

            <!-- Application Header -->
            <RowDefinition Height="58" />

            <!-- Navigation + Page -->
            <RowDefinition Height="*" />

            <!-- Status -->
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <!-- =====================================================
             APPLICATION HEADER
             ===================================================== -->

        <Border Grid.Row="0"
                Padding="14,0">

            <Grid>


                <Grid.ColumnDefinitions>

                    <!-- Back -->
                    <ColumnDefinition Width="Auto" />

                    <!-- Branding -->
                    <ColumnDefinition Width="Auto" />

                    <!-- Flexible Space -->
                    <ColumnDefinition Width="*" />

                    <!-- Rates -->
                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>



                <!-- =================================================
                     BACK BUTTON
                     ================================================= -->

                <Button Grid.Column="0"
                        Width="38"
                        Height="38"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ToolTip="Back"
                        Command="{Binding GoBackCommand}">


                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                </Button>



                <!-- =================================================
                     APPLICATION BRAND
                     ================================================= -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">


                    <!-- Logo Placeholder -->

                    <Border Width="36"
                            Height="36"
                            CornerRadius="8"
                            Margin="0,0,11,0">


                        <Viewbox Width="21"
                                 Height="21"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">


                            <TextBlock Text="◆"
                                       FontWeight="Bold" />


                        </Viewbox>

                    </Border>



                    <!-- Application Name -->

                    <StackPanel VerticalAlignment="Center">


                        <TextBlock Text="{Binding Identity.CompanyName}"
                                   Style="{StaticResource AppBrandTitleStyle}" />


                        <TextBlock Text="{Binding Identity.ApplicationName, StringFormat={}{0} · JEWELLERY MANAGEMENT}"
                                   Style="{StaticResource AppBrandSubtitleStyle}" />


                    </StackPanel>


                </StackPanel>



                <!-- =================================================
                     CURRENT RATES
                     ================================================= -->

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Dynamic Metal Rates -->
                    <ItemsControl ItemsSource="{Binding HeaderRates}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,20,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Metal}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Opacity="0.60"
                                               Margin="0,0,6,0" />

                                    <TextBlock Text="{Binding Price,
                           StringFormat={}{0:N2}}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                </StackPanel>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>


                    <!-- Version -->
                    <Border Padding="10,5"
                            CornerRadius="5">

                        <TextBlock Text="{Binding Identity.ApplicationVersion, StringFormat=Version {0}}"
                                   FontSize="10"
                                   Opacity="0.60"
                                   VerticalAlignment="Center" />

                    </Border>

                </StackPanel>


            </Grid>

        </Border>



        <!-- =====================================================
             MAIN NAVIGATION
             ===================================================== -->

        <dxwui:HamburgerMenu Grid.Row="1"
                             NavigationTarget="{Binding ElementName=frame}"
                             OpenPaneWidth="140"
                             AllowBuiltInNavigation="True"
                             Header="Menu"
                             ViewState="Opened"
                             AvailableViewStates="Inline,Overlay">


            <!-- =================================================
                 PAGE CONTENT
                 ================================================= -->

            <dxwui:HamburgerMenu.Content>


                <dxwui:NavigationFrame x:Name="frame"
                                       BackNavigationMode="PreviousScreen"
                                       AnimationDelay="0"
                                       AnimationType="None">

                    <dxmvvm:Interaction.Behaviors>

                        <dxmvvm:EventToCommand EventName="Loaded"
                                               Command="{Binding LoadedCommand}" />

                        <dxmvvm:EventToCommand EventName="Navigated"
                                               Command="{Binding NavigationCompletedCommand}" />

                        <ext:AttachServiceBehavior AtachableService="{Binding NavigationService}" />

                    </dxmvvm:Interaction.Behaviors>

                </dxwui:NavigationFrame>


            </dxwui:HamburgerMenu.Content>



            <!-- =================================================
                 SALES
                 ================================================= -->

            <!-- =================================================
     SALES
     ================================================= -->

            <dxwui:HamburgerSubMenu Content="Sales"
                                    MoreButtonVisibilityMode="Hidden"
                                    Glyph="{dx:DXImage
        'SvgImages/Business Objects/BO_Sale.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <!-- NEW INVOICE -->

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type page:InvoiceEntryPage}"
                                                            Content="New Invoice"
                                                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_Invoice.svg'}"
                                                            HideMenuWhenSelected="False" />


                    <!-- DRAFT INVOICES -->

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:Invoice.DraftInvoiceListView}"
                                                            Content="Draft Invoices"
                                                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_Note.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <!-- FINAL INVOICES -->

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:InvoiceListView}"
                                                            Content="Invoice List"
                                                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_List.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <!-- OLD METAL PURCHASE -->

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:OldMetalPurchaseView}"
                                                            Content="Old Metal Purchase"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Business_Cash.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:VoucherListView}"
                                                            Content="Voucher List"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Shopping_CashVoucher.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <!-- OUTSTANDING -->

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type page:OSVoucherView}"
                                                            Content="Outstanding Entry"
                                                            Tag="{dx:DXImage 'SvgImages/Outlook Inspired/PaymentUnpaid.svg'}"
                                                            HideMenuWhenSelected="True" />


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 ESTIMATE
                 ================================================= -->

            <dxwui:HamburgerSubMenu Content="Estimate"
                                    MoreButtonVisibilityMode="Hidden"
                                    Glyph="{dx:DXImage
                    'SvgImages/Business Objects/BO_Note.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type page:EstimateEntryPage}"
                                                            Content="New Estimate"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Actions_New.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:EstimateListView}"
                                                            Content="Estimate List"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Actions_List.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:OldMetalTransferEntryView}"
                                                            Content="Old Metal Transfer"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Travel_CurrencyExchange.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:OldMetalTransactionListView}"
                                                            Content="Old Metal Transactions"
                                                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_List.svg'}"
                                                            HideMenuWhenSelected="True" />


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 ORDERS
                 ================================================= -->

            <dxwui:HamburgerSubMenu Content="Orders"
                                    MoreButtonVisibilityMode="Hidden"
                                    Glyph="{dx:DXImage
                    'SvgImages/Business Objects/BO_Order.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type page:CustomerOrderEntryPage}"
                                                            Content="New Order / Repair"
                                                            Tag="{dx:DXImage 'SvgImages/Outlook Inspired/NewOrder.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:CustomerOrdersListView}"
                                                            Content="Order List"
                                                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_Order.svg'}"
                                                            HideMenuWhenSelected="True" />


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 FINANCE
                 ================================================= -->

            <dxwui:HamburgerSubMenu
                x:Name="FinanceMenu"
                Content="Finance"

                MoreButtonVisibilityMode="Hidden"

                Glyph="{dx:DXImage
                    'SvgImages/Icon Builder/Business_DollarCircled.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:VoucherEntryPage}"

                        Content="Expense"

                        Tag="{dx:DXImage 'SvgImages/Icon Builder/Business_Money.svg'}"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:CashReceiptEntryPage}"

                        Content="Cash Receipt"

                        Tag="{dx:DXImage 'SvgImages/Icon Builder/Business_Cash.svg'}"

                        HideMenuWhenSelected="True"/>


                    <!-- RD: opens the RD flyout (RdFlyout below) beside this one
                         instead of navigating. -->
                    <dxwui:HamburgerSubMenuNavigationButton
                        x:Name="RdMenuButton"

                        Content="RD"

                        RightContent="›"

                        Tag="{dx:DXImage 'SvgImages/Icon Builder/Business_DollarCircled.svg'}"

                        SelectOnClick="False"
                        CollapseFlyoutOnClick="False"
                        HideMenuWhenSelected="False"

                        PreviewMouseLeftButtonDown="OnRdMenuPreviewMouseLeftButtonDown"
                        PreviewKeyDown="OnRdMenuPreviewKeyDown"
                        IsVisibleChanged="OnRdMenuIsVisibleChanged"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:SchemeImportPage}"

                        Content="Import RD Register"

                        Tag="{dx:DXImage 'SvgImages/Icon Builder/Business_Money.svg'}"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:VoucherListView}"

                        Content="Voucher List"

                        Tag="{dx:DXImage 'SvgImages/Icon Builder/Shopping_CashVoucher.svg'}"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:FinanceSyncStatusPage}"

                        Content="Finance Sync Status"

                        Tag="{dx:DXImage 'Images/Actions/Refresh_32x32.png'}"

                        HideMenuWhenSelected="True"/>


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>

            

            <!-- =================================================
                 INVENTORY
                 ================================================= -->

            <dxwui:HamburgerSubMenu Content="Stock"
                                    MoreButtonVisibilityMode="Hidden"
                                    Glyph="{dx:DXImage
                    'SvgImages/Icon Builder/Shopping_Package.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type page:GRNEntryPage}"
                                                            Content="Material Receipt"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Shopping_Box.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:GRNListView}"
                                                            Content="Material Receipt List"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Shopping_Package.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type page:ProductStockPage}"
                                                            Content="Tag Printing"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Shopping_Barcode.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:StockAdjustmentView}"
                                                            Content="Stock Adjustment"
                                                            Tag="{dx:DXImage 'SvgImages/Format/Replace.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type page:ProductStockVerifyPage}"
                                                            Content="Stock Verify"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Actions_CheckCircled.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:BarCodeTagListView}"
                                                            Content="Barcode Maintenance"
                                                            Tag="{dx:DXImage 'SvgImages/Content/Barcode.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:DailyStockSummaryListView}"
                                                            Content="Manual Stock Register Enquiry"
                                                            Tag="{dx:DXImage 'SvgImages/Data/Summary.svg'}"
                                                            HideMenuWhenSelected="True" />

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:ProductStockSummaryListView}"
                                                            Content="Product Stock Summary"
                                                            Tag="{dx:DXImage 'SvgImages/Data/Summary.svg'}"
                                                            HideMenuWhenSelected="True" />

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:ProductMaintenanceView}"
                                                            Content="Product Maintenance"
                                                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_Product.svg'}"
                                                            HideMenuWhenSelected="True" />


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>


            <!-- =================================================
                 REPORTS
                 ================================================= -->

            <dxwui:HamburgerSubMenu Content="Tax"
                                    MoreButtonVisibilityMode="Hidden"
                                    Glyph="{dx:DXImage
                    'SvgImages/Icon Builder/Shopping_Percent.svg'}">


                <dxwui:HamburgerSubMenu.Items>

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:Gstr1ReturnView}"
                                                            Content="GSTR-1 Return"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Shopping_Percent.svg'}"
                                                            HideMenuWhenSelected="True" />

                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>


            <!-- =================================================
                 REPORTS
                 ================================================= -->

            <dxwui:HamburgerSubMenu Content="Daily Activity"
                                    MoreButtonVisibilityMode="Hidden"
                                    Glyph="{dx:DXImage
                    'SvgImages/Business Objects/BO_Report.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type page:GenericReportPage}"
                                                            Content="Daily Sales Report"
                                                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Business_Report.svg'}"
                                                            HideMenuWhenSelected="True" />


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:DailyStockEntryView}"
                                                            Content="Stock Summary Entry"
                                                            Tag="{dx:DXImage 'SvgImages/Chart/ChartType_Stock.svg'}"
                                                            HideMenuWhenSelected="True" />

                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 SETTINGS
                 ================================================= -->

            <dxwui:HamburgerSubMenu Content="Settings"
                                    MoreButtonVisibilityMode="Hidden"
                                    Glyph="{dx:DXImage
                    'SvgImages/Icon Builder/Actions_Settings.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type page:SettingsPage}"
                                                            Content="Price Setting"
                                                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_Price.svg'}"
                                                            HideMenuWhenSelected="True" />

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:VoucherTypeMaintenanceView}"
                                                            Content="Voucher Types"
                                                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_Price.svg'}"
                                                            HideMenuWhenSelected="True" />

                    <dxwui:HamburgerSubMenuNavigationButton NavigationTargetType="{x:Type views:CompanyMaintenanceView}"
                                                            Content="Company Master"
                                                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_Price.svg'}"
                                                            HideMenuWhenSelected="True" />


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>


        </dxwui:HamburgerMenu>


        <!-- =====================================================
             FINANCE > RD FLYOUT
             HamburgerSubMenu only nests one level, so RD's items
             open in this popup to the right of the RD item.
             ===================================================== -->

        <Popup x:Name="RdFlyout"
               Placement="Right"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="None"
               MouseLeave="OnRdFlyoutMouseLeave">

            <Border MinWidth="220"
                    Padding="0,6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {dxwuit:HamburgerMenuBrushesThemeKey ResourceKey=ItemSeparatorBrush}}"
                    Background="{DynamicResource {dxwuit:HamburgerMenuBrushesThemeKey ResourceKey=SubMenuPaneBackgroundBrush}}">

                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">

                    <Button Style="{StaticResource CascadeFlyoutItemStyle}"
                            Content="Scheme Enrollment"
                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Business_Money.svg'}"
                            CommandParameter="SchemeEnrollmentPage"
                            Click="OnRdItemClick" />

                    <Button Style="{StaticResource CascadeFlyoutItemStyle}"
                            Content="RD Dues / Collections"
                            Tag="{dx:DXImage 'SvgImages/Business Objects/BO_List.svg'}"
                            CommandParameter="RdDuesPage"
                            Click="OnRdItemClick" />

                    <Button Style="{StaticResource CascadeFlyoutItemStyle}"
                            Content="Scheme Plans"
                            Tag="{dx:DXImage 'SvgImages/Icon Builder/Shopping_CashVoucher.svg'}"
                            CommandParameter="SchemePlanPage"
                            Click="OnRdItemClick" />

                </StackPanel>

            </Border>

        </Popup>



        <!-- =====================================================
             STATUS BAR
             ===================================================== -->

        <dxb:BarContainerControl Grid.Row="2"
                                 ContainerType="Bottom">


            <dxb:StatusBarControl Caption="Status">


                <dxb:BarStaticItem Content="Ready" />

                <!-- Finance sync: refreshed every few minutes; opens the status page. -->
                <dxb:BarButtonItem Content="{Binding FinanceSync.StatusBarText}"
                                   Alignment="Far"
                                   Command="{Binding OpenFinanceSyncStatusCommand}" />


            </dxb:StatusBarControl>


        </dxb:BarContainerControl>

        <!-- =====================================================
     GLOBAL WAIT INDICATOR
     ===================================================== -->

        <dx:WaitIndicator Grid.RowSpan="3"
                          Panel.ZIndex="9999"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Visibility="Visible"
                          Content="TEST - WAIT INDICATOR" />


    </Grid>


</dx:ThemedWindow>
