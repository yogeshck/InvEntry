<dx:ThemedWindow
    x:Class="InvEntry.MainWindow"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"

    xmlns:views="clr-namespace:InvEntry.Views"
    xmlns:page="clr-namespace:InvEntry.Views.Page"
    xmlns:ext="clr-namespace:InvEntry.Extension"
    xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"

    Title="InvEntry"

    Height="800"
    Width="1400"

    MinHeight="650"
    MinWidth="1000"

    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"

    ResizeMode="CanResizeWithGrip"

    UseLayoutRounding="True"
    SnapsToDevicePixels="True"

    Icon="InvEntry.ico"

    DataContext="{ext:DISource Type={x:Type viewmodels:MainWindowViewModel}}">


    <!-- =========================================================
         RESOURCES
         ========================================================= -->

    <dx:ThemedWindow.Resources>


        <!-- Application Name -->

        <Style
            x:Key="AppBrandTitleStyle"
            TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="20"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="VerticalAlignment"
                Value="Center"/>

        </Style>


        <!-- Application Subtitle -->

        <Style
            x:Key="AppBrandSubtitleStyle"
            TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="10"/>

            <Setter
                Property="FontWeight"
                Value="Medium"/>

            <Setter
                Property="Opacity"
                Value="0.60"/>

            <Setter
                Property="VerticalAlignment"
                Value="Center"/>

        </Style>


        <!-- Rate Caption -->

        <Style
            x:Key="RateCaptionStyle"
            TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="10"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Opacity"
                Value="0.60"/>

            <Setter
                Property="VerticalAlignment"
                Value="Center"/>

        </Style>


        <!-- Rate Value -->

        <Style
            x:Key="RateValueStyle"
            TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="14"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="VerticalAlignment"
                Value="Center"/>

        </Style>


    </dx:ThemedWindow.Resources>



    <!-- =========================================================
         MAIN WINDOW
         ========================================================= -->

    <Grid>


        <Grid.RowDefinitions>

            <!-- Application Header -->
            <RowDefinition Height="58"/>

            <!-- Navigation + Page -->
            <RowDefinition Height="*"/>

            <!-- Status -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- =====================================================
             APPLICATION HEADER
             ===================================================== -->

        <Border
            Grid.Row="0"
            Padding="14,0">

            <Grid>


                <Grid.ColumnDefinitions>

                    <!-- Back -->
                    <ColumnDefinition Width="Auto"/>

                    <!-- Branding -->
                    <ColumnDefinition Width="Auto"/>

                    <!-- Flexible Space -->
                    <ColumnDefinition Width="*"/>

                    <!-- Rates -->
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>



                <!-- =================================================
                     BACK BUTTON
                     ================================================= -->

                <Button
                    Grid.Column="0"

                    Width="38"
                    Height="38"

                    Margin="0,0,12,0"

                    VerticalAlignment="Center"

                    ToolTip="Back"

                    Command="{Binding GoBackCommand}">


                    <TextBlock
                        Text="&#xE72B;"

                        FontFamily="Segoe MDL2 Assets"
                        FontSize="17"

                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Button>



                <!-- =================================================
                     APPLICATION BRAND
                     ================================================= -->

                <StackPanel
                    Grid.Column="1"

                    Orientation="Horizontal"

                    VerticalAlignment="Center">


                    <!-- Logo Placeholder -->

                    <Border
                        Width="36"
                        Height="36"

                        CornerRadius="8"

                        Margin="0,0,11,0">


                        <Viewbox
                            Width="21"
                            Height="21"

                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">


                            <TextBlock
                                Text="◆"
                                FontWeight="Bold"/>


                        </Viewbox>

                    </Border>



                    <!-- Application Name -->

                    <StackPanel
                        VerticalAlignment="Center">


                        <TextBlock
                            Text="InvEntry"

                            Style=
                                "{StaticResource AppBrandTitleStyle}"/>


                        <TextBlock
                            Text="JEWELLERY MANAGEMENT"

                            Style=
                                "{StaticResource AppBrandSubtitleStyle}"/>


                    </StackPanel>


                </StackPanel>



                <!-- =================================================
                     CURRENT RATES
                     ================================================= -->

                <StackPanel
    Grid.Column="3"
    Orientation="Horizontal"
    VerticalAlignment="Center">

                    <!-- Dynamic Metal Rates -->
                    <ItemsControl
    ItemsSource="{Binding HeaderRates}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <StackPanel
                Orientation="Horizontal"
                Margin="0,0,20,0"
                VerticalAlignment="Center">

                                    <TextBlock
                    Text="{Binding Metal}"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Opacity="0.60"
                    Margin="0,0,6,0"/>

                                    <TextBlock
                    Text="{Binding Price,
                           StringFormat={}{0:N2}}"
                    FontSize="14"
                    FontWeight="SemiBold"/>

                                </StackPanel>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>


                    <!-- Version -->
                    <Border
        Padding="10,5"
        CornerRadius="5">

                        <TextBlock
            Text="{Binding Version}"
            FontSize="10"
            Opacity="0.60"
            VerticalAlignment="Center"/>

                    </Border>

                </StackPanel>


            </Grid>

        </Border>



        <!-- =====================================================
             MAIN NAVIGATION
             ===================================================== -->

        <dxwui:HamburgerMenu
            Grid.Row="1"

            NavigationTarget="{Binding ElementName=frame}"

            OpenPaneWidth="210"

            AllowBuiltInNavigation="True"

            Header="Menu"

            ViewState="Opened"

            AvailableViewStates="Inline,Overlay">


            <!-- =================================================
                 PAGE CONTENT
                 ================================================= -->

            <dxwui:HamburgerMenu.Content>


                <dxwui:NavigationFrame
    x:Name="frame"

    BackNavigationMode="PreviousScreen"

    AnimationDelay="0"

    AnimationType="None">

                    <dxmvvm:Interaction.Behaviors>

                        <dxmvvm:EventToCommand
            EventName="Loaded"
            Command="{Binding LoadedCommand}"/>

                        <dxmvvm:EventToCommand
            EventName="Navigated"
            Command="{Binding NavigationCompletedCommand}"/>

                        <ext:AttachServiceBehavior
            AtachableService="{Binding NavigationService}"/>

                    </dxmvvm:Interaction.Behaviors>

                </dxwui:NavigationFrame>


            </dxwui:HamburgerMenu.Content>



            <!-- =================================================
                 SALES
                 ================================================= -->

            <!-- =================================================
     SALES
     ================================================= -->

            <dxwui:HamburgerSubMenu
    Content="Sales"

    MoreButtonVisibilityMode="Hidden"

    Glyph="{dx:DXImage
        'SvgImages/Business Objects/BO_Sale.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <!-- NEW INVOICE -->

                    <dxwui:HamburgerSubMenuNavigationButton
            NavigationTargetType=
                "{x:Type page:InvoiceEntryPage}"

            Content="New Invoice"

            HideMenuWhenSelected="False"/>


                    <!-- DRAFT INVOICES -->

                    <dxwui:HamburgerSubMenuNavigationButton
            NavigationTargetType=
                "{x:Type views:Invoice.DraftInvoiceListView}"

            Content="Draft Invoices"

            HideMenuWhenSelected="True"/>


                    <!-- FINAL INVOICES -->

                    <dxwui:HamburgerSubMenuNavigationButton
            NavigationTargetType=
                "{x:Type views:InvoiceListView}"

            Content="Invoice List"

            HideMenuWhenSelected="True"/>


                    <!-- OLD GOLD PURCHASE -->

                    <dxwui:HamburgerSubMenuNavigationButton
            NavigationTargetType=
                "{x:Type views:OldMetalPurchaseView}"

            Content="Old Gold Purchase"

            HideMenuWhenSelected="True"/>


                    <!-- OUTSTANDING -->

                    <dxwui:HamburgerSubMenuNavigationButton
            NavigationTargetType=
                "{x:Type page:OSVoucherView}"

            Content="Outstanding Entry"

            HideMenuWhenSelected="True"/>


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 ESTIMATE
                 ================================================= -->

            <dxwui:HamburgerSubMenu
                Content="Estimate"

                MoreButtonVisibilityMode="Hidden"

                Glyph="{dx:DXImage
                    'SvgImages/Business Objects/BO_Note.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:EstimateEntryPage}"

                        Content="New Estimate"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:EstimateListView}"

                        Content="Estimate List"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:OldMetalTransferEntryView}"

                        Content="Old Metal Transfer"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:OldMetalTransactionListView}"

                        Content="Old Metal Transactions"

                        HideMenuWhenSelected="True"/>


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 ORDERS
                 ================================================= -->

            <dxwui:HamburgerSubMenu
                Content="Orders"

                MoreButtonVisibilityMode="Hidden"

                Glyph="{dx:DXImage
                    'SvgImages/Business Objects/BO_Note.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:CustomerOrderEntryPage}"

                        Content="New Order / Repair"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:CustomerOrdersListView}"

                        Content="Order List"

                        HideMenuWhenSelected="True"/>


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 FINANCE
                 ================================================= -->

            <dxwui:HamburgerSubMenu
                Content="Finance"

                MoreButtonVisibilityMode="Hidden"

                Glyph="{dx:DXImage
                    'SvgImages/Icon Builder/Business_DollarCircled.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:VoucherEntryPage}"

                        Content="Expense"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:CashReceiptEntryPage}"

                        Content="Cash Receipt"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:VoucherListView}"

                        Content="Voucher List"

                        HideMenuWhenSelected="True"/>


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 INVENTORY
                 ================================================= -->

            <dxwui:HamburgerSubMenu
                Content="Inventory"

                MoreButtonVisibilityMode="Hidden"

                Glyph="{dx:DXImage
                    'SvgImages/XAF/ActionGroup_EasyTestRecorder.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:GRNEntryPage}"

                        Content="Material Receipt"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:GRNListView}"

                        Content="MRN List"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:ProductStockPage}"

                        Content="Stock Closing"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:StockAdjustmentView}"

                        Content="Stock Adjustment"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:ProductStockVerifyPage}"

                        Content="Stock Verify"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:BarCodeTagListView}"

                        Content="Barcode"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:DailyStockSummaryListView}"

                        Content="Daily Stock Summary"

                        HideMenuWhenSelected="True"/>


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 REPORTS
                 ================================================= -->

            <dxwui:HamburgerSubMenu
                Content="Reports"

                MoreButtonVisibilityMode="Hidden"

                Glyph="{dx:DXImage
                    'SvgImages/XAF/ActionGroup_EasyTestRecorder.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:GenericReportPage}"

                        Content="Daily Report"

                        HideMenuWhenSelected="True"/>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type views:DailyStockEntryView}"

                        Content="Stock Report"

                        HideMenuWhenSelected="True"/>


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>



            <!-- =================================================
                 SETTINGS
                 ================================================= -->

            <dxwui:HamburgerSubMenu
                Content="Settings"

                MoreButtonVisibilityMode="Hidden"

                Glyph="{dx:DXImage
                    'SvgImages/XAF/Action_OrganizeDashboard.svg'}">


                <dxwui:HamburgerSubMenu.Items>


                    <dxwui:HamburgerSubMenuNavigationButton
                        NavigationTargetType=
                            "{x:Type page:SettingsPage}"

                        Content="Price Setting"

                        HideMenuWhenSelected="True"/>


                </dxwui:HamburgerSubMenu.Items>


            </dxwui:HamburgerSubMenu>


        </dxwui:HamburgerMenu>



        <!-- =====================================================
             STATUS BAR
             ===================================================== -->

        <dxb:BarContainerControl
            Grid.Row="2"

            ContainerType="Bottom">


            <dxb:StatusBarControl
                Caption="Status">


                <dxb:BarStaticItem
                    Content="Ready"/>


            </dxb:StatusBarControl>


        </dxb:BarContainerControl>

        <!-- =====================================================
     GLOBAL WAIT INDICATOR
     ===================================================== -->

        <dx:WaitIndicator
    Grid.RowSpan="3"
    Panel.ZIndex="9999"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Visibility="Visible"
    Content="TEST - WAIT INDICATOR"/>


    </Grid>


</dx:ThemedWindow>