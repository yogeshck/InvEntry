<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"

    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid">


    <!-- ============================================================
         APPLICATION DIMENSIONS

         These define the common InvEntry visual language.
         No light/dark background colours are defined here.
         ============================================================ -->

    <sys:Double x:Key="AppEditorHeight">35</sys:Double>
    <sys:Double x:Key="AppEditorFontSize">14</sys:Double>

    <Thickness x:Key="AppPageMargin">16</Thickness>
    <Thickness x:Key="AppCardPadding">16</Thickness>
    <CornerRadius x:Key="AppCardCornerRadius">6</CornerRadius>


    <!-- ============================================================
         PAGE TITLE
         ============================================================ -->

    <Style x:Key="AppPageTitleStyle"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="24"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <Style x:Key="AppPageSubtitleStyle"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="Opacity"
                Value="0.60"/>

        <Setter Property="Margin"
                Value="0,3,0,0"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <!-- ============================================================
         CARD
         ============================================================ -->

    <Style x:Key="AppCardStyle"
           TargetType="Border">

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="CornerRadius"
                Value="{StaticResource AppCardCornerRadius}"/>

        <Setter Property="Padding"
                Value="{StaticResource AppCardPadding}"/>

    </Style>


    <!-- ============================================================
         SECTION TITLE
         ============================================================ -->

    <Style x:Key="AppSectionTitleStyle"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Opacity"
                Value="0.65"/>

        <Setter Property="Margin"
                Value="0,0,0,12"/>

    </Style>


    <Style x:Key="AppSectionTitleNoMarginStyle"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Opacity"
                Value="0.65"/>

    </Style>


    <!-- ============================================================
         FIELD LABEL
         ============================================================ -->

    <Style x:Key="AppFieldLabelStyle"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

        <Setter Property="Margin"
                Value="0,6,10,6"/>

    </Style>


    <!-- ============================================================
         NORMAL EDITORS
         ============================================================ -->

    <Style x:Key="AppTextEditStyle"
           TargetType="dxe:TextEdit">

        <Setter Property="Height"
                Value="{StaticResource AppEditorHeight}"/>

        <Setter Property="FontSize"
                Value="{StaticResource AppEditorFontSize}"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        <Setter Property="EditValuePostMode"
                Value="Immediate"/>

    </Style>


    <Style x:Key="AppDateEditStyle"
           TargetType="dxe:DateEdit">

        <Setter Property="Height"
                Value="{StaticResource AppEditorHeight}"/>

        <Setter Property="FontSize"
                Value="{StaticResource AppEditorFontSize}"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

    </Style>


    <Style x:Key="AppComboEditStyle"
           TargetType="dxe:ComboBoxEdit">

        <Setter Property="Height"
                Value="{StaticResource AppEditorHeight}"/>

        <Setter Property="FontSize"
                Value="{StaticResource AppEditorFontSize}"/>

        <Setter Property="IsTextEditable"
                Value="False"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

    </Style>


    <Style x:Key="AppLookupEditStyle"
           TargetType="dxg:LookUpEdit">

        <Setter Property="Height"
                Value="{StaticResource AppEditorHeight}"/>

        <Setter Property="FontSize"
                Value="{StaticResource AppEditorFontSize}"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

    </Style>


    <!-- ============================================================
         STANDARD BUTTONS

         Keep button colours controlled by the selected theme.
         ============================================================ -->

    <Style x:Key="AppActionButtonStyle"
           TargetType="Button">

        <Setter Property="Height"
                Value="36"/>

        <Setter Property="MinWidth"
                Value="90"/>

        <Setter Property="Padding"
                Value="14,0"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

    </Style>


    <Style x:Key="AppPrimaryActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppActionButtonStyle}">

        <Setter Property="MinWidth"
                Value="130"/>

    </Style>


    <!-- DevExpress button equivalent -->

    <Style x:Key="AppDxActionButtonStyle"
           TargetType="dx:SimpleButton">

        <Setter Property="Height"
                Value="36"/>

        <Setter Property="MinWidth"
                Value="90"/>

        <Setter Property="Padding"
                Value="12,0"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

    </Style>


    <Style x:Key="AppDxPrimaryActionButtonStyle"
           TargetType="dx:SimpleButton"
           BasedOn="{StaticResource AppDxActionButtonStyle}">

        <Setter Property="MinWidth"
                Value="130"/>

    </Style>


    <!-- ============================================================
         ICON BUTTON
         ============================================================ -->

    <Style x:Key="AppIconButtonStyle"
           TargetType="dx:SimpleButton">

        <Setter Property="Width"
                Value="36"/>

        <Setter Property="Height"
                Value="36"/>

        <Setter Property="Padding"
                Value="4"/>

    </Style>


    <!-- ============================================================
         GRID
         ============================================================ -->

    <Style x:Key="AppGridHeaderStyle"
           TargetType="dxg:BaseGridHeader">

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Setter Property="FontSize"
                Value="14"/>

    </Style>


    <Style x:Key="AppGridColumnStyle"
           TargetType="dxg:GridColumn">

        <Setter Property="HeaderStyle"
                Value="{StaticResource AppGridHeaderStyle}"/>

    </Style>


    <!-- ============================================================
         WEIGHT
         125.450
         ============================================================ -->

    <Style x:Key="AppWeightEditSettingsStyle"
           TargetType="dxe:TextEditSettings">

        <Setter Property="MaskType"
                Value="Numeric"/>

        <Setter Property="Mask"
                Value="n3"/>

        <Setter Property="MaskShowPlaceHolders"
                Value="False"/>

        <Setter Property="MaskUseAsDisplayFormat"
                Value="True"/>

        <Setter Property="dxe:NumericMaskOptions.AlwaysShowDecimalSeparator"
                Value="False"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Right"/>

    </Style>


    <!-- ============================================================
         NUMBER / AMOUNT
         1,25,000.00
         ============================================================ -->

    <Style x:Key="AppNumberEditStyle"
           TargetType="dxe:TextEdit"
           BasedOn="{StaticResource AppTextEditStyle}">

        <Setter Property="MaskType"
                Value="Numeric"/>

        <Setter Property="Mask"
                Value="#,##,##0.00"/>

        <Setter Property="MaskShowPlaceHolders"
                Value="False"/>

        <Setter Property="MaskUseAsDisplayFormat"
                Value="True"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Right"/>

    </Style>


    <Style x:Key="AppNumberEditSettingsStyle"
           TargetType="dxe:TextEditSettings">

        <Setter Property="MaskType"
                Value="Numeric"/>

        <Setter Property="Mask"
                Value="#,##,##0.00"/>

        <Setter Property="MaskShowPlaceHolders"
                Value="False"/>

        <Setter Property="MaskUseAsDisplayFormat"
                Value="True"/>

        <Setter Property="AllowNullInput"
                Value="False"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Right"/>

    </Style>


    <!-- ============================================================
         CURRENCY
         ₹ 1,25,000.00
         ============================================================ -->

    <Style x:Key="AppCurrencyEditSettingsStyle"
           TargetType="dxe:TextEditSettings">

        <Setter Property="MaskType"
                Value="Numeric"/>

        <Setter Property="Mask"
                Value="₹ #,##,##0.00"/>

        <Setter Property="MaskShowPlaceHolders"
                Value="False"/>

        <Setter Property="MaskUseAsDisplayFormat"
                Value="True"/>

        <Setter Property="AllowNullInput"
                Value="False"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Right"/>

    </Style>


    <!-- ============================================================
         SUMMARY BAR
         ============================================================ -->

    <Style x:Key="AppSummaryBarStyle"
           TargetType="Border">

        <Setter Property="Margin"
                Value="0,8,0,0"/>

        <Setter Property="Padding"
                Value="12,8"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="CornerRadius"
                Value="6"/>

    </Style>


    <Style x:Key="AppSummaryLabelStyle"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="Opacity"
                Value="0.60"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <Style x:Key="AppSummaryValueStyle"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="15"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>


    <Style x:Key="AppSummaryAmountStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppSummaryValueStyle}">

        <Setter Property="FontSize"
                Value="16"/>

    </Style>


    <!-- ============================================================
         SUMMARY SEPARATOR

         Opacity allows it to work in both themes without using
         a hard-coded light-grey brush.
         ============================================================ -->

    <Style x:Key="AppSummarySeparatorStyle"
           TargetType="Border">

        <Setter Property="Width"
                Value="1"/>

        <Setter Property="Height"
                Value="20"/>

        <Setter Property="Background"
                Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>

        <Setter Property="Opacity"
                Value="0.20"/>

        <Setter Property="HorizontalAlignment"
                Value="Center"/>

        <Setter Property="VerticalAlignment"
                Value="Center"/>

    </Style>

</ResourceDictionary>