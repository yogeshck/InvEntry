{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.\\SQLEXPRESS;Initial Catalog=mijms;TrustServerCertificate=True;Trusted_Connection=True"
  },
  "TallyConfig": {
    "BaseAddress" :  "http://localhost:9000/"
  },
  "LabelPrinting": {
    // "Physical" prints to the label printer; "Simulation" shows a preview only and
    // reports success without printing (for development without a printer).
    "Mode": "Physical",
    "SimulationOutcome": "Success"
  },
  "ReceiptPrinting": {
    // Advance / RD installment receipts:
    //   "A4TwoCopies" = customer copy + shop copy side by side on one A4 (landscape)
    //   "A5"          = one copy on A5
    "Layout": "A4TwoCopies",
    // RD passbook / statement: "A4" (one page per RD) or "A5" (passbook page)
    "StatementPaper": "A4"
  }
}
