<UserControl
    x:Class="InvEntry.Views.Gstr1ReturnView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
    xmlns:ext="clr-namespace:InvEntry.Extension"

    mc:Ignorable="d"

    d:DataContext="{d:DesignInstance Type=viewmodels:Gstr1ReturnViewModel}"
    DataContext="{ext:DISource Type=viewmodels:Gstr1ReturnViewModel}"

    d:DesignHeight="900"
    d:DesignWidth="1500"

    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">


    <!-- =========================================================
         RESOURCES
         ========================================================= -->

    <UserControl.Resources>

        <SolidColorBrush
            x:Key="GstAccentBrush"
            Color="#FF7A59"/>


        <!-- SECTION TITLE -->

        <Style
            x:Key="SectionTitleStyle"
            TargetType="TextBlock">

            <Setter
                Property="Foreground"
                Value="{StaticResource GstAccentBrush}"/>

            <Setter
                Property="FontSize"
                Value="15"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>


        <!-- FIELD LABEL -->

        <Style
            x:Key="FieldLabelStyle"
            TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="10"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="Opacity"
                Value="0.60"/>

        </Style>


        <!-- SUMMARY VALUE -->

        <Style
            x:Key="SummaryValueStyle"
            TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="18"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>


        <!-- SUMMARY CARD -->

        <Style
            x:Key="SummaryCardStyle"
            TargetType="Border">

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="CornerRadius"
                Value="6"/>

            <Setter
                Property="Padding"
                Value="12,6"/>

            <Setter
                Property="Margin"
                Value="4,2"/>

        </Style>


        <!-- GRID HEADER -->

        <Style
            x:Key="GridHeaderStyle"
            TargetType="dxg:BaseGridHeader">

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

            <Setter
                Property="FontSize"
                Value="11"/>

        </Style>


        <Style
            TargetType="dxg:GridColumn">

            <Setter
                Property="HeaderStyle"
                Value="{StaticResource GridHeaderStyle}"/>

        </Style>


        <!-- MONEY -->

        <Style
            x:Key="MoneyEditSettingsStyle"
            TargetType="dxe:TextEditSettings">

            <Setter
                Property="MaskType"
                Value="Numeric"/>

            <Setter
                Property="Mask"
                Value="n2"/>

            <Setter
                Property="MaskUseAsDisplayFormat"
                Value="True"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Right"/>

        </Style>


        <!-- QUANTITY -->

        <Style
            x:Key="QuantityEditSettingsStyle"
            TargetType="dxe:TextEditSettings">

            <Setter
                Property="MaskType"
                Value="Numeric"/>

            <Setter
                Property="Mask"
                Value="n3"/>

            <Setter
                Property="MaskUseAsDisplayFormat"
                Value="True"/>

            <Setter
                Property="HorizontalContentAlignment"
                Value="Right"/>

        </Style>

    </UserControl.Resources>


    <!-- =========================================================
         ROOT
         ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <!-- Header / Return Month / Load -->
            <RowDefinition Height="Auto"/>

            <!-- Compact Summary -->
            <RowDefinition Height="Auto"/>

            <!-- Category Summary -->
            <RowDefinition Height="145"/>

            <!-- Documents - PRIMARY WORK AREA -->
            <RowDefinition
                Height="3*"
                MinHeight="300"/>

            <!-- Selected Document / HSN -->
            <RowDefinition
                Height="2*"
                MinHeight="170"/>

            <!-- Status -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <Border
            Grid.Row="0"
            BorderThickness="0,0,0,1"
            Padding="16,7">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- TITLE / COMPANY -->

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="GSTR-1 RETURN"
                        FontSize="20"
                        FontWeight="SemiBold"/>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,2,0,0">

                        <TextBlock
                            Text="{Binding CompanyName}"
                            FontSize="11"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="  •  GSTIN: "
                            FontSize="11"
                            Opacity="0.60"/>

                        <TextBlock
                            Text="{Binding SupplierGstin}"
                            FontSize="11"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                </StackPanel>


                <!-- RETURN MONTH -->

                <StackPanel
                    Grid.Column="1"
                    Width="175">

                    <TextBlock
                        Text="RETURN MONTH"
                        Style="{StaticResource FieldLabelStyle}"
                        Margin="0,0,0,3"/>

                    <dxe:DateEdit IsEnabled="{Binding CanChangeScope}"
                        EditValue="{Binding ReturnMonth,
                                            UpdateSourceTrigger=PropertyChanged}"
                        MaskType="DateTime"
                        Mask="MMMM yyyy"
                        MaskUseAsDisplayFormat="True"
                        Height="34"/>

                </StackPanel>


                <!-- LOAD RETURN -->

                <dx:SimpleButton
                    Grid.Column="3"
                    Content="Load Return"
                    Height="34"
                    MinWidth="120"
                    VerticalAlignment="Bottom"
                    Glyph="{dx:DXImage 'Images/Actions/Refresh_32x32.png'}"
                    Command="{Binding LoadReturnCommand}"/>

            </Grid>

        </Border>


        <!-- =====================================================
             COMPACT SUMMARY
             ===================================================== -->

        <Grid
            Grid.Row="1"
            Margin="12,4">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.1*"/>

            </Grid.ColumnDefinitions>


            <!-- DOCUMENTS -->

            <Border
                Grid.Column="0"
                Style="{StaticResource SummaryCardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="DOCUMENTS"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock
                        Text="{Binding Summary.ReportableDocumentCount}"
                        Style="{StaticResource SummaryValueStyle}"/>

                    <TextBlock
                        FontSize="9"
                        Opacity="0.55">

                        <Run Text="Staged: "/>

                        <Run
                            Text="{Binding Summary.DocumentCount}"/>

                    </TextBlock>

                </StackPanel>

            </Border>


            <!-- INVOICE VALUE -->

            <Border
                Grid.Column="1"
                Style="{StaticResource SummaryCardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="INVOICE VALUE"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock
                        Text="{Binding Summary.TotalInvoiceValue,
                                       StringFormat={}{0:N2}}"
                        Style="{StaticResource SummaryValueStyle}"
                        TextAlignment="Right"/>

                </StackPanel>

            </Border>


            <!-- TAXABLE VALUE -->

            <Border
                Grid.Column="2"
                Style="{StaticResource SummaryCardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="TAXABLE VALUE"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock
                        Text="{Binding Summary.TotalTaxableValue,
                                       StringFormat={}{0:N2}}"
                        Style="{StaticResource SummaryValueStyle}"
                        TextAlignment="Right"/>

                </StackPanel>

            </Border>


            <!-- CGST -->

            <Border
                Grid.Column="3"
                Style="{StaticResource SummaryCardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="CGST"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock
                        Text="{Binding Summary.TotalCgst,
                                       StringFormat={}{0:N2}}"
                        Style="{StaticResource SummaryValueStyle}"
                        TextAlignment="Right"/>

                </StackPanel>

            </Border>


            <!-- SGST -->

            <Border
                Grid.Column="4"
                Style="{StaticResource SummaryCardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="SGST"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock
                        Text="{Binding Summary.TotalSgst,
                                       StringFormat={}{0:N2}}"
                        Style="{StaticResource SummaryValueStyle}"
                        TextAlignment="Right"/>

                </StackPanel>

            </Border>


            <!-- IGST -->

            <Border
                Grid.Column="5"
                Style="{StaticResource SummaryCardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="IGST"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock
                        Text="{Binding Summary.TotalIgst,
                                       StringFormat={}{0:N2}}"
                        Style="{StaticResource SummaryValueStyle}"
                        TextAlignment="Right"/>

                </StackPanel>

            </Border>


            <!-- TOTAL TAX -->

            <Border
                Grid.Column="6"
                Style="{StaticResource SummaryCardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="TOTAL TAX"
                        Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock
                        Text="{Binding TotalTax,
                                       StringFormat={}{0:N2}}"
                        Foreground="{StaticResource GstAccentBrush}"
                        Style="{StaticResource SummaryValueStyle}"
                        TextAlignment="Right"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- =====================================================
             CATEGORY SUMMARY
             ===================================================== -->

        <Border
            Grid.Row="2"
            Margin="16,0,16,6"
            BorderThickness="1"
            CornerRadius="7">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- CATEGORY HEADER -->

                <TextBlock
                    Grid.Row="0"
                    Text="GSTR-1 CATEGORY SUMMARY"
                    Style="{StaticResource SectionTitleStyle}"
                    Margin="12,5"/>


                <!-- CATEGORY GRID -->

                <dxg:GridControl
                    Grid.Row="1"
                    ItemsSource="{Binding Categories}"
                    BorderThickness="0">

                    <dxg:GridControl.Columns>


                        <dxg:GridColumn
                            FieldName="Category"
                            Header="Category"
                            Width="110"
                            ReadOnly="True"/>


                        <dxg:GridColumn
                            FieldName="Gstr1Table"
                            Header="Table"
                            Width="70"
                            ReadOnly="True"/>


                        <dxg:GridColumn
                            FieldName="DocumentCount"
                            Header="Documents"
                            Width="90"
                            ReadOnly="True"/>


                        <dxg:GridColumn
                            FieldName="InvoiceValue"
                            Header="Invoice Value"
                            Width="130"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <dxg:GridColumn
                            FieldName="TaxableValue"
                            Header="Taxable"
                            Width="130"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <dxg:GridColumn
                            FieldName="CgstAmount"
                            Header="CGST"
                            Width="105"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <dxg:GridColumn
                            FieldName="SgstAmount"
                            Header="SGST"
                            Width="105"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <dxg:GridColumn
                            FieldName="IgstAmount"
                            Header="IGST"
                            Width="105"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>

                    </dxg:GridControl.Columns>


                    <dxg:GridControl.View>

                        <dxg:TableView
                            ShowGroupPanel="False"
                            ShowIndicator="False"
                            AllowEditing="False"
                            AllowGrouping="False"
                            AutoWidth="True"
                            VerticalScrollbarVisibility="Auto"/>

                    </dxg:GridControl.View>

                </dxg:GridControl>

            </Grid>

        </Border>


        <!-- =====================================================
             DOCUMENTS - PRIMARY GRID
             ===================================================== -->

        <Border
            Grid.Row="3"
            Margin="16,0,16,6"
            BorderThickness="1"
            CornerRadius="7">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- DOCUMENT HEADER -->

                <Grid
                    Grid.Row="0"
                    Margin="12,5">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock
                        Grid.Column="0"
                        Text="DOCUMENTS"
                        Style="{StaticResource SectionTitleStyle}"
                        VerticalAlignment="Center"/>


                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Records: "
                            FontSize="11"
                            Opacity="0.60"/>

                        <TextBlock
                            Text="{Binding Documents.Count}"
                            FontSize="11"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                </Grid>


                <!-- DOCUMENT GRID -->

                <dxg:GridControl
                    Grid.Row="1"
                    ItemsSource="{Binding Documents}"
                    SelectedItem="{Binding SelectedDocument,
                                           Mode=TwoWay}"
                    BorderThickness="0">

                    <dxg:GridControl.Columns>


                        <!-- DATE -->

                        <dxg:GridColumn
                            FieldName="DocumentDate"
                            Header="Date"
                            Width="105"
                            ReadOnly="True"/>


                        <!-- INVOICE -->

                        <dxg:GridColumn
                            FieldName="DocumentNbr"
                            Header="Invoice"
                            Width="130"
                            ReadOnly="True"/>


                        <!-- RECIPIENT GSTIN -->

                        <dxg:GridColumn
                            FieldName="RecipientGstin"
                            Header="Recipient GSTIN"
                            Width="160"
                            ReadOnly="True"/>


                        <!-- POS -->

                        <dxg:GridColumn
                            FieldName="PlaceOfSupplyCode"
                            Header="POS"
                            Width="60"
                            ReadOnly="True"/>


                        <!-- SUPPLY -->

                        <dxg:GridColumn
                            FieldName="SupplyType"
                            Header="Supply"
                            Width="115"
                            ReadOnly="True"/>


                        <!-- CATEGORY -->

                        <dxg:GridColumn
                            FieldName="ReturnCategory"
                            Header="Category"
                            Width="100"
                            ReadOnly="True"/>


                        <!-- TABLE -->

                        <dxg:GridColumn
                            FieldName="Gstr1Table"
                            Header="Table"
                            Width="65"
                            ReadOnly="True"/>


                        <!-- INVOICE VALUE -->

                        <dxg:GridColumn
                            FieldName="InvoiceValue"
                            Header="Invoice Value"
                            Width="135"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <!-- TAXABLE -->

                        <dxg:GridColumn
                            FieldName="TaxableValue"
                            Header="Taxable"
                            Width="135"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <!-- CGST -->

                        <dxg:GridColumn
                            FieldName="CgstAmount"
                            Header="CGST"
                            Width="105"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <!-- SGST -->

                        <dxg:GridColumn
                            FieldName="SgstAmount"
                            Header="SGST"
                            Width="105"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <!-- IGST -->

                        <dxg:GridColumn
                            FieldName="IgstAmount"
                            Header="IGST"
                            Width="105"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <!-- STATUS -->

                        <dxg:GridColumn
                            FieldName="Status"
                            Header="Status"
                            Width="105"
                            ReadOnly="True"/>

                    </dxg:GridControl.Columns>


                    <dxg:GridControl.View>

                        <dxg:TableView
                            ShowGroupPanel="False"
                            ShowIndicator="False"
                            AllowEditing="False"
                            AllowGrouping="True"
                            AutoWidth="False"
                            NavigationStyle="Row"
                            VerticalScrollbarVisibility="Auto"
                            HorizontalScrollbarVisibility="Auto"/>

                    </dxg:GridControl.View>

                </dxg:GridControl>

            </Grid>

        </Border>


        <!-- =====================================================
             SELECTED DOCUMENT / HSN DETAILS
             ===================================================== -->

        <Border
            Grid.Row="4"
            Margin="16,0,16,6"
            BorderThickness="1"
            CornerRadius="7">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- HSN HEADER -->

                <Grid
                    Grid.Row="0"
                    Margin="12,5">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal">

                        <TextBlock
                            Text="SELECTED DOCUMENT — HSN / ITEM DETAILS"
                            Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock
                            Text="   "/>

                        <TextBlock
                            Text="{Binding SelectedDocument.DocumentNbr}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                    </StackPanel>


                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Lines: "
                            FontSize="11"
                            Opacity="0.60"/>

                        <TextBlock
                            Text="{Binding DocumentLines.Count}"
                            FontSize="11"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                </Grid>


                <!-- HSN GRID -->

                <dxg:GridControl
                    Grid.Row="1"
                    ItemsSource="{Binding DocumentLines}"
                    BorderThickness="0">

                    <dxg:GridControl.Columns>


                        <!-- LINE -->

                        <dxg:GridColumn
                            FieldName="LineNbr"
                            Header="#"
                            Width="45"
                            ReadOnly="True"/>


                        <!-- HSN -->

                        <dxg:GridColumn
                            FieldName="HsnCode"
                            Header="HSN"
                            Width="100"
                            ReadOnly="True"/>


                        <!-- DESCRIPTION -->

                        <dxg:GridColumn
                            FieldName="Description"
                            Header="Description"
                            Width="280"
                            ReadOnly="True"/>


                        <!-- QUANTITY -->

                        <dxg:GridColumn
                            FieldName="Quantity"
                            Header="Qty"
                            Width="80"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource QuantityEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <!-- TAXABLE -->

                        <dxg:GridColumn
                            FieldName="TaxableValue"
                            Header="Taxable"
                            Width="125"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <!-- GST RATE -->

                        <dxg:GridColumn
                            FieldName="GstRate"
                            Header="GST %"
                            Width="75"
                            ReadOnly="True"/>


                        <!-- CGST RATE -->

                        <dxg:GridColumn
                            FieldName="CgstRate"
                            Header="CGST %"
                            Width="75"
                            ReadOnly="True"/>


                        <!-- CGST -->

                        <dxg:GridColumn
                            FieldName="CgstAmount"
                            Header="CGST"
                            Width="105"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <!-- SGST RATE -->

                        <dxg:GridColumn
                            FieldName="SgstRate"
                            Header="SGST %"
                            Width="75"
                            ReadOnly="True"/>


                        <!-- SGST -->

                        <dxg:GridColumn
                            FieldName="SgstAmount"
                            Header="SGST"
                            Width="105"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>


                        <!-- IGST RATE -->

                        <dxg:GridColumn
                            FieldName="IgstRate"
                            Header="IGST %"
                            Width="75"
                            ReadOnly="True"/>


                        <!-- IGST -->

                        <dxg:GridColumn
                            FieldName="IgstAmount"
                            Header="IGST"
                            Width="105"
                            ReadOnly="True">

                            <dxg:GridColumn.EditSettings>

                                <dxe:TextEditSettings
                                    Style="{StaticResource MoneyEditSettingsStyle}"/>

                            </dxg:GridColumn.EditSettings>

                        </dxg:GridColumn>

                    </dxg:GridControl.Columns>


                    <dxg:GridControl.View>

                        <dxg:TableView
                            ShowGroupPanel="False"
                            ShowIndicator="False"
                            AllowEditing="False"
                            AllowGrouping="False"
                            AutoWidth="False"
                            NavigationStyle="Row"
                            VerticalScrollbarVisibility="Auto"
                            HorizontalScrollbarVisibility="Auto"/>

                    </dxg:GridControl.View>

                </dxg:GridControl>

            </Grid>

        </Border>


        <!-- =====================================================
             STATUS
             ===================================================== -->

        <Border Grid.Row="5" Margin="16,0,16,6" Padding="10,5"
                BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <DockPanel>
                    <dx:SimpleButton DockPanel.Dock="Right"
                                     Content="Export GSTN JSON"
                                     AutomationProperties.AutomationId="ExportGstnJson"
                                     Command="{Binding ExportJsonCommand}"
                                     Height="34" MinWidth="160" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ValidationStatus}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Opacity="0.70"/>
                    </StackPanel>
                </DockPanel>
                <Expander Header="Validation issues" Margin="0,4,0,0">
                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Validation.Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2">
                                        <Run Text="{Binding Severity}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding Code}"/>
                                        <Run Text=": "/>
                                        <Run Text="{Binding Message}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding DocumentNbr}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
                <TextBlock Text="{Binding ExportStatusMessage}" TextWrapping="Wrap"
                           FontSize="11" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding ReturnPeriodDisplay}" FontSize="11"
                           HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

    </Grid>

</UserControl>