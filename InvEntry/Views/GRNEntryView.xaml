<UserControl x:Class="InvEntry.Views.GRNEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"

             xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
             xmlns:ext="clr-namespace:InvEntry.Extension"

             mc:Ignorable="d"

             d:DesignHeight="800"
             d:DesignWidth="1350"

             d:DataContext="{d:DesignInstance Type=viewmodels:GRNViewModel}"
             DataContext="{ext:DISource Type=viewmodels:GRNViewModel}"

             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">


    <!-- =========================================================
         MAIN PAGE
         ========================================================= -->

    <Grid Margin="{StaticResource AppPageMargin}">


        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="Auto"/>

            <!-- Supplier / Receipt information -->
            <RowDefinition Height="Auto"/>

            <!-- Main workspace -->
            <RowDefinition Height="*"/>

            <!-- Bottom information strip -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,14">


            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- =================================================
                 TITLE
                 ================================================= -->

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock
                    Text="Material Receipt"
                    Style="{StaticResource AppPageTitleStyle}"/>

                <TextBlock
                    Text="Receive supplier material and update inventory"
                    Style="{StaticResource AppPageSubtitleStyle}"/>

            </StackPanel>


            <!-- =================================================
                 ACTION BUTTONS
                 ================================================= -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">


                <!-- Reset -->

                <dx:SimpleButton
                    Content="Reset"
                    Width="105"
                    Margin="0,0,8,0"
                    Style="{StaticResource AppDxActionButtonStyle}"
                    Glyph="{dx:DXImage 'Images/Actions/Refresh_16x16.png'}"
                    ToolTip="Clear the current material receipt"
                    Command="{Binding ResetGRNCommand}"/>


                <!-- Save -->

                <dx:SimpleButton
                    Content="SAVE GRN"
                    Width="135"
                    Style="{StaticResource AppDxPrimaryActionButtonStyle}"
                    Glyph="{dx:DXImage 'Images/Save/Save_16x16.png'}"
                    ToolTip="Save material receipt"
                    Command="{Binding SubmitCommand}"/>


            </StackPanel>

        </Grid>


        <!-- =====================================================
             SUPPLIER + RECEIPT INFORMATION
             ===================================================== -->

        <Grid Grid.Row="1"
              Margin="0,0,0,14">


            <Grid.ColumnDefinitions>

                <!-- Supplier -->
                <ColumnDefinition Width="0.9*"/>

                <!-- Gap -->
                <ColumnDefinition Width="16"/>

                <!-- Receipt -->
                <ColumnDefinition Width="1.1*"/>

            </Grid.ColumnDefinitions>


            <!-- =================================================
                 SUPPLIER CARD
                 ================================================= -->

            <Border Grid.Column="0"
                    Style="{StaticResource AppCardStyle}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">


                <StackPanel>


                    <!-- Card title -->

                    <TextBlock
                        Text="SUPPLIER"
                        Style="{StaticResource AppSectionTitleStyle}"/>


                    <!-- Supplier fields -->

                    <Grid>


                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="115"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- =========================================
                             SUPPLIER
                             ========================================= -->

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Supplier"
                            Style="{StaticResource AppFieldLabelStyle}"/>


                        <dxg:LookUpEdit
                            Grid.Row="0"
                            Grid.Column="1"

                            Style="{StaticResource AppLookupEditStyle}"

                            AllowRejectUnknownValues="True"

                            ItemsSource="{Binding SupplierReferencesList}"

                            EditValue="{Binding Header.SupplierId,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- =========================================
                             SUPPLIER DOCUMENT NUMBER
                             ========================================= -->

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Supp Doc #"
                            Style="{StaticResource AppFieldLabelStyle}"/>


                        <dxe:TextEdit
                            Grid.Row="1"
                            Grid.Column="1"

                            EditValue="{Binding Header.DocumentRef,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- =========================================
                             SUPPLIER DOCUMENT DATE
                             ========================================= -->

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="Supp Doc Date"
                            Style="{StaticResource AppFieldLabelStyle}"/>


                        <dxe:DateEdit
                            Grid.Row="2"
                            Grid.Column="1"

                            EditValue="{Binding Header.DocumentDate,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}">


                            <dxe:DateEdit.StyleSettings>

                                <dxe:DateEditNavigatorStyleSettings/>

                            </dxe:DateEdit.StyleSettings>


                        </dxe:DateEdit>


                    </Grid>

                </StackPanel>

            </Border>


            <!-- =================================================
                 RECEIPT INFORMATION CARD
                 ================================================= -->

            <Border Grid.Column="2"
                    Style="{StaticResource AppCardStyle}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">


                <StackPanel>


                    <!-- =============================================
                         CARD TITLE + GRN NUMBER
                         ============================================= -->

                    <Grid Margin="0,0,0,12">


                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock
                            Grid.Column="0"
                            Text="RECEIPT INFORMATION"
                            Style="{StaticResource AppSectionTitleNoMarginStyle}"/>


                        <!-- GRN number display -->

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">


                            <TextBlock
                                Text="GRN # "
                                FontSize="13"
                                FontWeight="SemiBold"
                                Opacity="0.60"
                                VerticalAlignment="Center"/>


                            <TextBlock
                                Text="{Binding Header.GrnNbr}"
                                FontSize="15"
                                FontWeight="Bold"
                                VerticalAlignment="Center"/>


                        </StackPanel>


                    </Grid>


                    <!-- =============================================
                         RECEIPT FIELDS
                         ============================================= -->

                    <Grid>


                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="115"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="20"/>

                            <ColumnDefinition Width="110"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- =========================================
                             GRN NUMBER
                             ========================================= -->

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="GRN Number"
                            Style="{StaticResource AppFieldLabelStyle}"/>


                        <dxe:TextEdit
                            Grid.Row="0"
                            Grid.Column="1"

                            EditValue="{Binding Header.GrnNbr,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- =========================================
                             GRN DATE
                             ========================================= -->

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            Text="GRN Date"
                            Style="{StaticResource AppFieldLabelStyle}"/>


                        <dxe:DateEdit
                            Grid.Row="0"
                            Grid.Column="4"

                            EditValue="{Binding Header.GrnDate,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}">


                            <dxe:DateEdit.StyleSettings>

                                <dxe:DateEditNavigatorStyleSettings/>

                            </dxe:DateEdit.StyleSettings>


                        </dxe:DateEdit>


                        <!-- =========================================
                             RECEIVED DATE
                             ========================================= -->

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Received Date"
                            Style="{StaticResource AppFieldLabelStyle}"/>


                        <dxe:DateEdit
                            Grid.Row="1"
                            Grid.Column="1"

                            EditValue="{Binding Header.ItemReceivedDate,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}">


                            <dxe:DateEdit.StyleSettings>

                                <dxe:DateEditNavigatorStyleSettings/>

                            </dxe:DateEdit.StyleSettings>


                        </dxe:DateEdit>


                    </Grid>

                </StackPanel>

            </Border>


        </Grid>


        <!-- =====================================================
             MATERIAL / ITEM WORKSPACE
             ===================================================== -->

        <Border Grid.Row="2"
                Style="{StaticResource AppCardStyle}"
                Padding="0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">


            <Grid>


                <Grid.RowDefinitions>

                    <!-- Section heading -->
                    <RowDefinition Height="Auto"/>

                    <!-- Grid workspace -->
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- =================================================
                     SECTION HEADER
                     ================================================= -->

                <Grid Grid.Row="0"
                      Margin="16,12,16,10">


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">


                        <TextBlock
                            Text="MATERIAL DETAILS"
                            Style="{StaticResource AppSectionTitleNoMarginStyle}"/>


                        <TextBlock
                            Text="Products and quantities received from supplier"
                            FontSize="12"
                            Opacity="0.60"
                            Margin="0,3,0,0"/>


                    </StackPanel>


                    <!-- Current item count -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">


                        <TextBlock
                            Text="Items "
                            FontSize="13"
                            Opacity="0.60"
                            VerticalAlignment="Center"/>


                        <TextBlock
                            Text="{Binding Header.GrnLineSumry.Count}"
                            FontSize="15"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>


                    </StackPanel>


                </Grid>


                <!-- =================================================
                     BAR MANAGER + GRID
                     ================================================= -->

                <dxb:BarManager Grid.Row="1"
                                AllowCustomization="False">


                    <!-- =============================================
                         PRODUCT TOOLBAR
                         ============================================= -->

                    <dxb:BarManager.Bars>


                        <dxb:Bar
                            AllowCollapse="False"
                            AllowQuickCustomization="False"
                            AllowRemove="False"
                            AllowCustomizationMenu="False"
                            ShowDragWidget="False">


                            <!-- Product Category -->

                            <dxb:BarEditItem
                                Content="Product"
                                EditValue="{Binding CategoryUI,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                EditWidth="280"
                                EditHeight="32">


                                <dxb:BarEditItem.EditSettings>


                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding ProductCategoryList}"
                                        IsTextEditable="False"/>


                                </dxb:BarEditItem.EditSettings>


                            </dxb:BarEditItem>


                            <!-- Add item -->

                            <dxb:BarButtonItem
                                Content="Add Item"

                                Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_AddCircled.svg'}"

                                Command="{Binding FetchProductCommand}"

                                GlyphSize="Large"

                                GlyphAlignment="Left"

                                BarItemDisplayMode="ContentAndGlyph"/>


                        </dxb:Bar>


                    </dxb:BarManager.Bars>


                    <!-- =================================================
                         GRN ITEM GRID
                         ================================================= -->

                    <dxg:GridControl
                        x:Name="grnLinesGrid"

                        ItemsSource="{Binding Header.GrnLineSumry}"

                        SelectedItems="{Binding SelectedRows}"

                        DeleteKeyBehavior="DeleteFocusedRow"

                        HorizontalAlignment="Stretch"

                        VerticalAlignment="Stretch"

                        FontSize="14"

                        MinHeight="280">


                        <!-- =============================================
                             LOCAL GRID RESOURCES
                             ============================================= -->

                        <dxg:GridControl.Resources>


                            <!-- Global application grid header style -->

                            <Style TargetType="dxg:GridColumn"
                                   BasedOn="{StaticResource AppGridColumnStyle}"/>


                            <!-- Immediate editor posting -->

                            <Style TargetType="dxe:TextEdit">

                                <Setter Property="Width"
                                        Value="Auto"/>

                                <Setter Property="FontSize"
                                        Value="14"/>

                                <Setter Property="EditValuePostMode"
                                        Value="Immediate"/>

                            </Style>


                        </dxg:GridControl.Resources>


                        <!-- =================================================
                             COLUMNS
                             ================================================= -->

                        <dxg:GridControl.Columns>


                            <!-- =============================================
                                 CATEGORY
                                 ============================================= -->

                            <dxg:GridColumn
                                FieldName="ProductCategory"
                                Header="Category"
                                Width="150"
                                ReadOnly="True"/>


                            <!-- =============================================
                                 PURITY
                                 ============================================= -->

                            <dxg:GridColumn
                                FieldName="ProductPurity"
                                Header="Purity"
                                Width="75"
                                ReadOnly="True"/>


                            <!-- =============================================
                                 QUANTITY
                                 ============================================= -->

                            <dxg:GridColumn
                                FieldName="SuppliedQty"
                                Header="Qty"
                                Width="65"
                                AllowedTotalSummaries="Sum"/>


                            <!-- =============================================
                                 GROSS WEIGHT
                                 ============================================= -->

                            <dxg:GridColumn
                                FieldName="GrossWeight"
                                Header="Gross Wt."
                                Width="115"
                                AllowedTotalSummaries="Sum">


                                <dxg:GridColumn.EditSettings>

                                    <dxe:TextEditSettings
                                        Style="{StaticResource AppWeightEditSettingsStyle}"/>

                                </dxg:GridColumn.EditSettings>


                            </dxg:GridColumn>


                            <!-- =============================================
                                 STONE WEIGHT
                                 ============================================= -->

                            <dxg:GridColumn
                                FieldName="StoneWeight"
                                Header="Stone Wt."
                                Width="115"
                                AllowedTotalSummaries="Sum">


                                <dxg:GridColumn.EditSettings>

                                    <dxe:TextEditSettings
                                        Style="{StaticResource AppWeightEditSettingsStyle}"/>

                                </dxg:GridColumn.EditSettings>


                            </dxg:GridColumn>


                            <!-- =============================================
                                 NET WEIGHT
                                 ============================================= -->

                            <dxg:GridColumn
                                FieldName="NetWeight"
                                Header="Net Wt."
                                Width="115"
                                ReadOnly="True"
                                AllowedTotalSummaries="Sum">


                                <dxg:GridColumn.EditSettings>

                                    <dxe:TextEditSettings
                                        Style="{StaticResource AppWeightEditSettingsStyle}"/>

                                </dxg:GridColumn.EditSettings>


                            </dxg:GridColumn>


                            <!-- =============================================
                                 UOM
                                 ============================================= -->

                            <dxg:GridColumn
                                FieldName="Uom"
                                Header="UOM"
                                Width="70"
                                ReadOnly="True"/>


                            <!-- =============================================
                                 VA %
                                 ============================================= -->

                            <dxg:GridColumn
                                FieldName="SuppVaPercent"
                                Header="VA %"
                                Width="80">


                                <dxg:GridColumn.EditSettings>

                                    <dxe:TextEditSettings
                                        Style="{StaticResource AppNumberEditSettingsStyle}"/>

                                </dxg:GridColumn.EditSettings>


                            </dxg:GridColumn>


                        </dxg:GridControl.Columns>


                        <!-- =================================================
                             TOTAL SUMMARY
                             ================================================= -->

                        <dxg:GridControl.TotalSummary>


                            <dxg:GridSummaryItem
                                SummaryType="Sum"
                                FieldName="SuppliedQty"
                                DisplayFormat="{}{0:N0}"/>


                            <dxg:GridSummaryItem
                                SummaryType="Sum"
                                FieldName="GrossWeight"
                                DisplayFormat="{}{0:N3}"/>


                            <dxg:GridSummaryItem
                                SummaryType="Sum"
                                FieldName="StoneWeight"
                                DisplayFormat="{}{0:N3}"/>


                            <dxg:GridSummaryItem
                                SummaryType="Sum"
                                FieldName="NetWeight"
                                DisplayFormat="{}{0:N3}"/>


                        </dxg:GridControl.TotalSummary>


                        <!-- =================================================
                             TABLE VIEW
                             ================================================= -->

                        <dxg:GridControl.View>


                            <dxg:TableView
                                NewItemRowPosition="None"

                                AllowGrouping="False"

                                AllowBestFit="True"

                                ShowGroupPanel="False"

                                ShowIndicator="False"

                                TotalSummaryPosition="Bottom"

                                NavigationStyle="Cell"

                                AutoWidth="True">


                                <!-- =========================================
                                     CELL UPDATE
                                     ========================================= -->

                                <dxmvvm:Interaction.Behaviors>


                                    <dxmvvm:EventToCommand
                                        EventName="CellValueChanged"

                                        Command="{Binding CellUpdateCommand}"

                                        PassEventArgsToCommand="True"/>


                                </dxmvvm:Interaction.Behaviors>


                                <!-- =========================================
                                     ROW CONTEXT MENU
                                     ========================================= -->

                                <dxg:TableView.RowCellMenuCustomizations>


                                    <dxb:BarButtonItem

                                        Content="Delete Row"

                                        CommandParameter="{Binding Row.Row}"

                                        Command="{Binding DataContext.DeleteSingleRowCommand,
                                                  RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"

                                        Glyph="{dx:DXImage 'Images/Edit/Delete_32x32.png'}"/>


                                </dxg:TableView.RowCellMenuCustomizations>


                            </dxg:TableView>


                        </dxg:GridControl.View>


                    </dxg:GridControl>


                </dxb:BarManager>


            </Grid>


        </Border>


        <!-- =====================================================
             BOTTOM STATUS / SUMMARY STRIP
             ===================================================== -->

        <Border Grid.Row="3"
                Style="{StaticResource AppSummaryBarStyle}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">


            <Grid>


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- =================================================
                     ITEM COUNT
                     ================================================= -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">


                    <TextBlock
                        Text="Items"
                        Style="{StaticResource AppSummaryLabelStyle}"/>


                    <TextBlock
                        Text="{Binding Header.GrnLineSumry.Count}"
                        Style="{StaticResource AppSummaryValueStyle}"
                        Margin="7,0,0,0"/>


                </StackPanel>


                <!-- =================================================
                     SEPARATOR
                     ================================================= -->

                <Border
                    Grid.Column="1"
                    Style="{StaticResource AppSummarySeparatorStyle}"/>


                <!-- =================================================
                     DOCUMENT NUMBER
                     ================================================= -->

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">


                    <TextBlock
                        Text="GRN"
                        Style="{StaticResource AppSummaryLabelStyle}"/>


                    <TextBlock
                        Text="{Binding Header.GrnNbr}"
                        Style="{StaticResource AppSummaryValueStyle}"
                        Margin="7,0,0,0"/>


                </StackPanel>


                <!-- =================================================
                     HELPER TEXT
                     ================================================= -->

                <TextBlock
                    Grid.Column="4"
                    Text="Right-click an item to delete"
                    FontSize="12"
                    Opacity="0.55"
                    VerticalAlignment="Center"/>


            </Grid>


        </Border>


    </Grid>

</UserControl>