<Window x:Class="InvEntry.Views.VoucherTypeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Voucher Type"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="14">

    <StackPanel Margin="16">
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Document type" VerticalAlignment="Center" />
            <TextBox Text="{Binding DocumentType, Mode=OneWay}" IsReadOnly="True" />
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Abbreviation *" VerticalAlignment="Center" />
            <TextBox Text="{Binding Abbreviation, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Used for" VerticalAlignment="Center" />
            <TextBox Text="{Binding UsedFor, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Narration" VerticalAlignment="Center" />
            <TextBox Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Numbering method" VerticalAlignment="Center" />
            <TextBox Text="{Binding DocNbrMethod, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Number length" VerticalAlignment="Center" />
            <TextBox Width="120" HorizontalAlignment="Left"
                     Text="{Binding DocNbrLength, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Number prefill" VerticalAlignment="Center" />
            <TextBox Text="{Binding DocNbrPrefill, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Number prefix" VerticalAlignment="Center" />
            <TextBox Text="{Binding DocNbrPrefix, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Number suffix" VerticalAlignment="Center" />
            <TextBox Text="{Binding DocNbrSuffix, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Width="170" Text="Last used number" VerticalAlignment="Center" />
            <TextBox Text="{Binding LastUsedNumber, Mode=OneWay}" IsReadOnly="True" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox Content="Taxable" IsChecked="{Binding IsTaxable}" VerticalAlignment="Center" Margin="0,0,24,0" />
            <CheckBox Content="Active" IsChecked="{Binding IsActive}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Foreground="#C62828" TextWrapping="Wrap" Margin="0,12,0,0" Text="{Binding Error}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="110" Height="34" IsDefault="True" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Width="110" Height="34" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
