<dx:ThemedWindow
    x:Class="InvEntry.Views.Invoices.DraftInvoicePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"

    Title="Open Draft Invoice"
Width="900"
Height="600"
MinWidth="750"
MinHeight="500"

WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =====================================================
         HEADER
         ===================================================== -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                Text="Draft Invoices"
                FontSize="24"
                FontWeight="SemiBold"/>

                <TextBlock
                Margin="0,4,0,0"
                Text="Select a saved draft invoice to continue editing."
                Opacity="0.65"/>

            </StackPanel>


            <Border
            Grid.Column="1"
            Padding="12,6"
            VerticalAlignment="Center"
            CornerRadius="5"
            Background="#FFF3E0">

                <TextBlock
                Text="DRAFT"
                FontWeight="Bold"
                Foreground="#E65100"/>

            </Border>

        </Grid>


        <!-- =====================================================
         SEARCH
         ===================================================== -->

        <Border
        Grid.Row="2"
        Padding="12"
        CornerRadius="6"
        BorderThickness="1"
        BorderBrush="#D8D8D8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Text="Search"
                FontWeight="SemiBold"/>

                <dxe:TextEdit
                Grid.Column="1"
                Height="34"
                NullText="Draft number / mobile / customer"
                EditValue="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>

        </Border>


        <!-- =====================================================
         DRAFT GRID
         ===================================================== -->

        <Border
        Grid.Row="4"
        CornerRadius="6"
        BorderThickness="1"
        BorderBrush="#D8D8D8">

            <dxg:GridControl
            ItemsSource="{Binding Drafts}"
            SelectedItem="{Binding SelectedDraft,
                                   Mode=TwoWay}">

                <dxg:GridControl.View>

                    <dxg:TableView
                    ShowGroupPanel="False"
                    ShowSearchPanelMode="Never"
                    NavigationStyle="Row"
                    AutoWidth="True"
                    AllowEditing="False"
                    ShowIndicator="False"/>

                </dxg:GridControl.View>


                <!-- Draft Number -->

                <dxg:GridColumn
                Header="Draft"
                FieldName="GKey"
                Width="110">

                    <dxg:GridColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock
                            Text="{Binding RowData.Row.GKey,
                                           StringFormat=DRAFT-{0}}"
                            FontWeight="SemiBold"/>

                        </DataTemplate>

                    </dxg:GridColumn.CellTemplate>

                </dxg:GridColumn>


                <!-- Date -->

                <dxg:GridColumn
                Header="Date"
                FieldName="InvDate"
                Width="130">

                    <dxg:GridColumn.EditSettings>

                        <dxe:DateEditSettings
                        DisplayFormat="dd-MMM-yyyy"/>

                    </dxg:GridColumn.EditSettings>

                </dxg:GridColumn>


                <!-- Customer -->

                <dxg:GridColumn
                Header="Customer"
                FieldName="CustomerName"
                Width="220"/>


                <!-- Mobile -->

                <dxg:GridColumn
                Header="Mobile"
                FieldName="CustMobile"
                Width="140"/>


                <!-- Amount -->

                <dxg:GridColumn
                Header="Amount"
                FieldName="AmountPayable"
                Width="140">

                    <dxg:GridColumn.EditSettings>

                        <dxe:TextEditSettings
                        DisplayFormat="₹ #,##0.00"/>

                    </dxg:GridColumn.EditSettings>

                </dxg:GridColumn>


                <!-- Status -->

                <dxg:GridColumn
                Header="Status"
                FieldName="Status"
                Width="100"/>

            </dxg:GridControl>

        </Border>


        <!-- =====================================================
         FOOTER
         ===================================================== -->

        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- STATUS -->

            <TextBlock
            VerticalAlignment="Center"
            Text="{Binding StatusMessage}"
            Opacity="0.65"/>


            <!-- BUTTONS -->

            <StackPanel
            Grid.Column="1"
            Orientation="Horizontal">

                <dx:SimpleButton
                Width="100"
                Height="36"
                Margin="0,0,8,0"
                Content="Cancel"
                Command="{Binding CancelCommand}"/>

                <dx:SimpleButton
                Width="130"
                Height="36"
                Content="Open Draft"
                Command="{Binding OpenSelectedCommand}"/>

            </StackPanel>

        </Grid>

    </Grid>

</dx:ThemedWindow>