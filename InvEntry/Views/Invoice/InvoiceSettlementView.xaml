 <dx:ThemedWindow
    x:Class="InvEntry.Views.Invoice.InvoiceSettlementView"
     xmlns:local="clr-namespace:InvEntry.Views.Invoice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"

    Title="Finalise Invoice"
    Width="850"
    Height="700"    
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip">

    <dx:ThemedWindow.Resources>
        <BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter"/>
    </dx:ThemedWindow.Resources>
     
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER                                                 -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
            Padding="18"
            CornerRadius="8"
            Background="#F3F4F6">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="FINALISE INVOICE   - RECEIPTS"
                               Foreground="Black"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                            Margin="0,8,0,0">

                        <TextBlock Text="Draft: "
                               Foreground="Black"/>

                        <TextBlock Text="{Binding InvoiceNumber}"
                                   Foreground="Black"
                               FontWeight="SemiBold"/>

                        <TextBlock Text="   Customer: "
                               Margin="20,0,0,0"
                               Foreground="Black"/>

                        <TextBlock Text="{Binding CustomerName}"
                               FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding CustomerMobile,
                                             StringFormat='  ({0})'}"
                               Foreground="Black"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
            HorizontalAlignment="Right">

                    <TextBlock Text="AMOUNT AFTER DISCOUNT"
               HorizontalAlignment="Right"
               Foreground="Black"
               FontWeight="Bold"
               FontSize="11"/>

                    <TextBlock Text="{Binding AmountAfterDiscount,
                              StringFormat='₹ {0:N2}'}"
               HorizontalAlignment="Right"
               Foreground="Red"
               FontSize="24"
               FontWeight="Bold"/>

                </StackPanel>
                
            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- ADJUSTMENT SUMMARY                                    -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
        Padding="15"
        CornerRadius="8"
        BorderBrush="#DDDDDD"
        BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- INVOICE AMOUNT -->

                <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Invoice Amount"/>

                <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Text="{Binding InvoiceAmount,
                                  StringFormat='₹ {0:N2}'}"
                   HorizontalAlignment="Right"
                   FontWeight="SemiBold"/>


                <!-- OLD GOLD / SILVER -->

                <TextBlock Grid.Row="0"
                   Grid.Column="2"
                   Text="Old Gold / Silver"
                   Margin="30,0,0,0"/>

                <TextBlock Grid.Row="0"
                   Grid.Column="3"
                   Text="{Binding OldGoldAdjustment,
                                  StringFormat='₹ {0:N2}'}"
                   HorizontalAlignment="Right"/>


                <!-- ADVANCE -->

                <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Advance Adjustment"/>

                <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Text="{Binding AdvanceAdjustment,
                                  StringFormat='₹ {0:N2}'}"
                   HorizontalAlignment="Right"/>


                <!-- RD -->

                <TextBlock Grid.Row="2"
                   Grid.Column="2"
                   Text="RD Adjustment"
                   Margin="30,0,0,0"/>

                <TextBlock Grid.Row="2"
                   Grid.Column="3"
                   Text="{Binding RdAdjustment,
                                  StringFormat='₹ {0:N2}'}"
                   HorizontalAlignment="Right"/>


                <!-- DISCOUNT -->

                <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="Discount"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

                <dxe:TextEdit Grid.Row="4"
                      Grid.Column="1"
                      Height="28"
                      EditValue="{Binding DiscountAmount,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                      Mask="n2"
                      MaskType="Numeric"
                      HorizontalContentAlignment="Right"/>


                <!-- AMOUNT AFTER DISCOUNT -->

                <TextBlock Grid.Row="4"
                   Grid.Column="2"
                   Text="Amount After Discount"
                   Margin="30,0,0,0"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>

                <TextBlock Grid.Row="4"
                   Grid.Column="3"
                   Text="{Binding AmountAfterDiscount,
                                  StringFormat='₹ {0:N2}'}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="Red"/>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- SETTLEMENT AREA                                       -->
        <!-- ===================================================== -->

        <Grid Grid.Row="4">

            <!-- ================================================= -->
            <!-- RECEIVABLE                                       -->
            <!-- ================================================= -->

            <Grid Visibility="{Binding IsReceivable,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="CUSTOMER PAYMENT"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                        <TextBlock Text="Enter the amount received from the customer."
                               Foreground="Gray"
                               Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                           Text="{Binding ReceivableAmount,
                                          StringFormat='RECEIVABLE  ₹ {0:N2}'}"
                           FontSize="17"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                </Grid>

                <!-- RECEIPTS GRID -->

                <dxg:GridControl Grid.Row="2"
                             ItemsSource="{Binding Receipts}"
                             AutoGenerateColumns="None">

                    <dxg:GridControl.View>
                        <dxg:TableView
                        ShowGroupPanel="False"
                        AllowEditing="True"
                        NavigationStyle="Cell"
                        NewItemRowPosition="None"/>
                    </dxg:GridControl.View>

                    <dxg:GridColumn FieldName="PaymentMode"
                            Header="Payment Mode"
                            Width="160">

                        <dxg:GridColumn.EditSettings>

                            <dxe:ComboBoxEditSettings
                                ItemsSource="{Binding DataContext.PaymentModes,
                                    RelativeSource={RelativeSource
                                        AncestorType={x:Type dx:ThemedWindow}}}"
                                IsTextEditable="False"
                                ImmediatePopup="True"/>

                        </dxg:GridColumn.EditSettings>

                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="TransactionId"
                                Header="Transaction / UTR"
                                Width="220"/>

                    <dxg:GridColumn FieldName="Amount"
                                Header="Amount"
                                Width="160"/>

                    <dxg:GridColumn FieldName="OtherReference"
                                Header="Reference"
                                Width="*"/>

                </dxg:GridControl>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="+ Add Payment"
                            Command="{Binding AddReceiptCommand}"
                            Padding="14,7"
                            Margin="0,0,8,0"/>

                    </StackPanel>

                    <!-- CREDIT -->

                    <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="25,0,0,0"
                            VerticalAlignment="Center">

                        <CheckBox Content="Credit Balance"
                              IsChecked="{Binding UseCredit}"
                              VerticalAlignment="Center"/>

                        <dxe:TextEdit Width="120"
                                  Margin="10,0,0,0"
                                  EditValue="{Binding CreditAmount,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding UseCredit}"
                                  Mask="n2"
                                  MaskType="Numeric"/>

                    </StackPanel>

                    <!-- RECEIPT TOTALS -->

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Received"/>
                        <TextBlock Grid.Column="1"
                               Text="{Binding TotalReceived,
                                              StringFormat='₹ {0:N2}'}"
                               HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1"
                               Text="Credit"/>

                        <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding EffectiveCreditAmount,
                                              StringFormat='₹ {0:N2}'}"
                               HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2"
                               Text="Balance"
                               FontWeight="Bold"/>

                        <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{Binding ReceivableBalance,
                                              StringFormat='₹ {0:N2}'}"
                               HorizontalAlignment="Right"
                               FontWeight="Bold"/>
                    </Grid>
                </Grid>

            </Grid>

            <!-- ================================================= -->
            <!-- REFUND                                           -->
            <!-- ================================================= -->

            <Grid Visibility="{Binding IsRefund,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="REFUND TO CUSTOMER"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                        <TextBlock Text="The shop has an amount payable to the customer."
                               Foreground="Gray"
                               Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                           Text="{Binding RefundPayable,
                                          StringFormat='REFUND  ₹ {0:N2}'}"
                           FontSize="17"
                           FontWeight="Bold"/>
                </Grid>

                <dxg:GridControl Grid.Row="2"
                             ItemsSource="{Binding Refunds}"
                             AutoGenerateColumns="None">

                    <dxg:GridControl.View>
                        <dxg:TableView
                        ShowGroupPanel="False"
                        AllowEditing="True"
                        NavigationStyle="Cell"
                        NewItemRowPosition="None"/>
                    </dxg:GridControl.View>

                    <dxg:GridColumn FieldName="PaymentMode"
                Header="Refund Mode"
                Width="160">

                        <dxg:GridColumn.EditSettings>

                            <dxe:ComboBoxEditSettings
            ItemsSource="{Binding DataContext.PaymentModes,
                RelativeSource={RelativeSource
                    AncestorType={x:Type dx:ThemedWindow}}}"
            IsTextEditable="False"
            ImmediatePopup="True"/>

                        </dxg:GridColumn.EditSettings>

                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="TransactionId"
                                Header="Transaction / UTR"
                                Width="220"/>

                    <dxg:GridColumn FieldName="Amount"
                                Header="Amount"
                                Width="160"/>

                    <dxg:GridColumn FieldName="OtherReference"
                                Header="Reference"
                                Width="*"/>

                </dxg:GridControl>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="+ Add Refund"
                        Command="{Binding AddRefundCommand}"
                        Padding="14,7"
                        HorizontalAlignment="Left"/>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Refunded"/>

                        <TextBlock Grid.Column="1"
                               Text="{Binding TotalRefunded,
                                              StringFormat='₹ {0:N2}'}"
                               HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1"
                               Text="Balance"
                               FontWeight="Bold"/>

                        <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding RefundBalance,
                                              StringFormat='₹ {0:N2}'}"
                               HorizontalAlignment="Right"
                               FontWeight="Bold"/>
                    </Grid>
                </Grid>

            </Grid>

            <!-- ================================================= -->
            <!-- FULLY ADJUSTED                                   -->
            <!-- ================================================= -->

            <Border Visibility="{Binding IsFullyAdjusted,
                                     Converter={StaticResource BooleanToVisibilityConverter}}"
                Padding="30"
                CornerRadius="8"
                Background="#F3F4F6">

                <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <TextBlock Text="FULLY ADJUSTED"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="No receipt or refund is required."
                           Margin="0,8,0,0"
                           Foreground="Gray"
                           HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- VALIDATION                                            -->
        <!-- ===================================================== -->

        <Border Grid.Row="6"
            Padding="10"
            CornerRadius="5"
            Background="#FFF4E5">

            <TextBlock Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap"/>
        </Border>

        <!-- ===================================================== -->
        <!-- BUTTONS                                               -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="8"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

            <Button Content="Cancel"
                Width="110"
                Padding="10,7"
                Margin="0,0,10,0"
                IsCancel="True"/>

            <Button Content="Confirm Settlement"
                Width="160"
                Padding="10,7"
                IsDefault="True"
                IsEnabled="{Binding CanFinalise}"
                            Click="ConfirmSettlement_Click"/>

        </StackPanel>

    </Grid>

</dx:ThemedWindow>