<dx:ThemedWindow x:Class="InvEntry.Views.Invoice.InvoiceSettlementView"
                 xmlns:local="clr-namespace:InvEntry.Views.Invoice"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                 Title="Finalise Invoice - Settlement"
                 Width="900"
                 Height="720"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip"
                 Foreground="#111827"
                 Background="#F3F4F6"
                 Language="en-IN">

    <dx:ThemedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </dx:ThemedWindow.Resources>

    <Grid Margin="16"
          Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER                                                 -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Padding="10"
                CornerRadius="8"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="INVOICE SETTLEMENT &amp; RECEIPTS"
                               Foreground="Black"
                               FontSize="18"
                               FontWeight="Bold" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">

                        <TextBlock Text="Draft: "
                                   Foreground="Black" />

                        <TextBlock Text="{Binding InvoiceNumber}"
                                   Foreground="Black"
                                   FontWeight="SemiBold" />

                        <TextBlock Text=" | Customer: "
                                   Margin="20,0,0,0"
                                   Foreground="Black" />

                        <TextBlock Text="{Binding CustomerName}"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />

                        <TextBlock Text="{Binding CustomerMobile,
                                             StringFormat='  ({0})'}"
                                   Foreground="Black" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">

                    <TextBlock Text="AMOUNT AFTER DISCOUNT"
                               HorizontalAlignment="Right"
                               Foreground="Black"
                               FontWeight="Bold"
                               FontSize="11" />

                    <TextBlock Text="{Binding AmountAfterDiscount,
                              StringFormat='₹ {0:N2}'}"
                               HorizontalAlignment="Right"
                               Foreground="Red"
                               FontSize="24"
                               FontWeight="Bold" />

                </StackPanel>

            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- ADJUSTMENT SUMMARY                                    -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Padding="15"
                CornerRadius="8"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <!-- INVOICE AMOUNT -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Invoice Amount"
                           FontSize="14"
                           Foreground="#374151" />

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding InvoiceAmount,
                                  StringFormat='₹ {0:N2}'}"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"
                           FontSize="15 "
                           Foreground="#374151" />

                <!-- ADVANCE -->

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Advance Adjustment"
                           Margin="30,0,0,0"
                           FontSize="14"
                           Foreground="#374151" />

                <TextBlock Grid.Row="0"
                           Grid.Column="3"
                           Text="{Binding SettlementAdvanceAdjustment,
                                  StringFormat='₹ {0:N2}'}"
                           Foreground="#C62828"
                           FontWeight="Bold"
                           FontSize="14"
                           Padding="2"
                           HorizontalAlignment="Right" />

                <!-- OLD GOLD / SILVER -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Old Purchase Adjustment"
                           FontSize="14"
                           Foreground="#374151" />

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding OldPurchaseAdjustment,
                                  StringFormat='₹ {0:N2}'}"
                           HorizontalAlignment="Right"
                           FontSize="14"
                           Padding="2"
                           Foreground="#374151" />

                <!-- RD -->

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="RD Adjustment"
                           FontSize="14"
                           Margin="30,0,0,0"
                           Foreground="#374151" />

                <TextBlock Grid.Row="2"
                           Grid.Column="3"
                           Text="{Binding SettlementRdAdjustment,
                                  StringFormat='₹ {0:N2}'}"
                           Foreground="#C62828"
                           FontSize="14"
                           Padding="2"
                           FontWeight="Bold"
                           HorizontalAlignment="Right" />


                <!-- AMOUNT AFTER DISCOUNT -->


                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Amount to be Collected"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="#374151" />

                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding NetSettlementAmount,
                                  StringFormat='₹ {0:N2}'}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Padding="2"
                           FontWeight="Bold"
                           Foreground="Red" />


                <!-- DISCOUNT -->

                <TextBlock Grid.Row="4"
                           Grid.Column="2"
                           Text="Discount"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0"
                           FontSize="14"
                           Foreground="#374151" />

                <dxe:TextEdit Grid.Row="4"
                              Grid.Column="3"
                              Height="28"
                              EditValue="{Binding DiscountAmount,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                              Mask="n2"
                              MaskType="Numeric"
                              MaskUseAsDisplayFormat="True"
                              HorizontalContentAlignment="Right"
                              FontSize="14"
                              Foreground="#111827"
                              Background="#FFFFFF" />


                <!--    <TextBlock Grid.Row="6"
                           Grid.Column="2"
                           Text="Applied to Invoice"
                           Margin="30,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="#374151" />

                <TextBlock Grid.Row="6"
                           Grid.Column="3"
                           Text="{Binding OldPurchaseAppliedToInvoice,
                                  StringFormat='₹ {0:N2}'}"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"
                           Foreground="#374151" /> -->

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- SETTLEMENT AREA                                       -->
        <!-- ===================================================== -->

        <Grid Grid.Row="4">

            <!-- ================================================= -->
            <!-- RECEIVABLE                                       -->
            <!-- ================================================= -->

            <Grid Visibility="{Binding IsReceivable,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <TextBlock Text="CUSTOMER PAYMENT"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />

                        <TextBlock Text="Enter customer receipt below."
                                   Foreground="Gray"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <!--    <TextBlock Grid.Column="1"
                               Text="{Binding ReceivableAmount,
                                          StringFormat='RECEIVABLE  ₹ {0:N2}'}"
                               FontSize="17"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="#374151" />  -->

                    <!-- Quick-mode shortcuts from redesign. Disabled until mode-specific
                     commands are implemented; existing AddPayment_Click remains operational. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="Quick Payment Mode:"
                                   Foreground="#374151"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Button Content="Cash"
                                Margin="0,0,5,0"
                                Padding="8,3"
                                FontSize="13"
                                FontWeight="Bold"
                                Command="{Binding AddQuickPaymentCommand}"
                                CommandParameter="CASH" />
                        <Button Content="UPI QR"
                                Margin="0,0,5,0"
                                Padding="8,3"
                                FontSize="13"
                                FontWeight="Bold"
                                Command="{Binding AddQuickPaymentCommand}"
                                CommandParameter="UPI" />
                        <Button Content="Card"
                                Margin="0,0,5,0"
                                Padding="8,3"
                                FontSize="13"
                                FontWeight="Bold"
                                Command="{Binding AddQuickPaymentCommand}"
                                CommandParameter="CARD" />
                        <Button Content="Bank Transfer"
                                Padding="8,3"
                                FontSize="13"
                                FontWeight="Bold"
                                Command="{Binding AddQuickPaymentCommand}"
                                CommandParameter="BANK" />
                    </StackPanel>
                </Grid>

                <!-- RECEIPTS GRID -->

                <dxg:GridControl x:Name="ReceiptGrid"
                                 Grid.Row="2"
                                 ItemsSource="{Binding Receipts}"
                                 SelectedItem="{Binding SelectedReceipt, Mode=TwoWay}"
                                 AutoGenerateColumns="None">

                    <dxg:GridControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete selected row"
                                      Command="{Binding PlacementTarget.DataContext.RemoveReceiptCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        </ContextMenu>
                    </dxg:GridControl.ContextMenu>


                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="ReceiptTableView"
                                       ShowGroupPanel="False"
                                       AllowEditing="True"
                                       NavigationStyle="Cell"
                                       NewItemRowPosition="None" />
                    </dxg:GridControl.View>

                    <dxg:GridColumn FieldName="PaymentMode"
                                    Header="Payment Mode"
                                    Width="160">

                        <dxg:GridColumn.EditSettings>

                            <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.PaymentModes,
                                    RelativeSource={RelativeSource
                                        AncestorType={x:Type dx:ThemedWindow}}}"
                                                      IsTextEditable="False"
                                                      ImmediatePopup="True" />

                        </dxg:GridColumn.EditSettings>

                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="Amount"
                                    Header="Amount"
                                    Width="160">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric"
                                                  Mask="n2"
                                                  MaskUseAsDisplayFormat="True" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="TransactionId"
                                    Header="Transaction / UTR"
                                    Width="220" />

                    <dxg:GridColumn FieldName="OtherReference"
                                    Header="Reference"
                                    Width="*" />

                </dxg:GridControl>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="+ Add Line"
                                Click="AddPayment_Click"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="Red"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Padding="12,8"
                                Margin="0,0,8,0" />

                    </StackPanel>

                    <!-- CREDIT -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="25,0,0,0"
                                VerticalAlignment="Center">

                        <CheckBox Content="Credit Balance"
                                  IsChecked="{Binding UseCredit}"
                                  FontSize="14"
                                  VerticalAlignment="Center" />

                        <dxe:TextEdit Width="120"
                                      Margin="10,0,0,0"
                                      EditValue="{Binding CreditAmount,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding UseCredit}"
                                      Mask="n2"
                                      MaskType="Numeric"
                                      MaskUseAsDisplayFormat="True"
                                      FontSize="14"
                                      Foreground="#111827"
                                      Background="#FFFFFF" />

                    </StackPanel>

                    <!-- RECEIPT TOTALS -->

                    <Grid Grid.Column="2"
                          Width="300">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>


                        <!-- ACTUAL MONEY RECEIVED -->

                        <TextBlock Grid.Row="0"
                                   Text="Received"
                                   Margin="0,5,0,5"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="#374151" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding TotalReceived,
                                            StringFormat='₹ {0:N2}'}"
                                   Margin="0,5,10,5"
                                   FontSize="14"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />


                        <!-- ADJUSTMENTS -->

                        <TextBlock Grid.Row="1"
                                   Text="Advance / RD Adj"
                                   Margin="0,5,0,5"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#374151" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding TotalAdjustments,
                                                    StringFormat='₹ {0:N2}'}"
                                   Margin="0,5,10,5"
                                   FontSize="14"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />


                        <!-- CREDIT -->

                        <TextBlock Grid.Row="2"
                                   Text="Credit"
                                   Margin="0,5,0,5"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="#374151" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding EffectiveCreditAmount,
                              StringFormat='₹ {0:N2}'}"
                                   Margin="0,5,10,5"
                                   FontSize="14"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />


                        <!-- LARGE BALANCE -->

                        <Border Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Margin="0,5,0,5"
                                Padding="12,8"
                                CornerRadius="6"
                                Background="#FEF2F2"
                                BorderBrush="#FCA5A5"
                                BorderThickness="1">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="BALANCE DUE"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#B71C1C" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ReceivableBalance,
                                      StringFormat='₹ {0:N2}'}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#D32F2F" />

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

            </Grid>

            <!-- ================================================= -->
            <!-- REFUND                                           -->
            <!-- ================================================= -->

            <Grid Visibility="{Binding IsRefund,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="REFUND TO CUSTOMER"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />

                        <TextBlock Text="The shop has an amount payable to the customer."
                                   Foreground="Gray"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding RefundPayable,
                                          StringFormat='REFUND  ₹ {0:N2}'}"
                               FontSize="17"
                               Margin="0,4,10,8"
                               FontWeight="Bold"
                               Foreground="#374151" />
                </Grid>

                <dxg:GridControl x:Name="RefundGrid"
                                 Grid.Row="2"
                                 ItemsSource="{Binding Refunds}"
                                 SelectedItem="{Binding SelectedRefund, Mode=TwoWay}"
                                 AutoGenerateColumns="None">
                    <dxg:GridControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete selected row"
                                      Command="{Binding PlacementTarget.DataContext.RemoveRefundCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        </ContextMenu>
                    </dxg:GridControl.ContextMenu>


                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="RefundTableView"
                                       ShowGroupPanel="False"
                                       AllowEditing="True"
                                       NavigationStyle="Cell"
                                       NewItemRowPosition="None" 
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                    </dxg:GridControl.View>

                    <dxg:GridColumn FieldName="PaymentMode"
                                    Header="Refund Mode"
                                    Width="160">

                        <dxg:GridColumn.EditSettings>

                            <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.PaymentModes,
                                                                            RelativeSource={RelativeSource
                                                                            AncestorType={x:Type dx:ThemedWindow}}}"
                                                      IsTextEditable="False"
                                                      ImmediatePopup="True" />

                        </dxg:GridColumn.EditSettings>

                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="Amount"
                                    Header="Amount"
                                    Width="160">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric"
                                                  Mask="n2"
                                                  MaskUseAsDisplayFormat="True" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>

                    <dxg:GridColumn FieldName="TransactionId"
                                    Header="Transaction / UTR"
                                    Width="220" />

                    <dxg:GridColumn FieldName="OtherReference"
                                    Header="Reference"
                                    Width="*" />

                </dxg:GridControl>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Button Content="+ Add Refund"
                            Click="AddRefund_Click"
                            Padding="14,7"
                            FontWeight="Bold"
                            HorizontalAlignment="Left" />

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Refunded"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,4,0,8"
                                   VerticalAlignment="Center"
                                   Foreground="#374151" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding TotalRefunded,
                                              StringFormat='₹ {0:N2}'}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,4,10,8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#C62828" />

                        <!-- BALANCE -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Balance"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,8,0,8"
                                   VerticalAlignment="Center"
                                   Foreground="#374151" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding RefundBalance,
                              StringFormat='₹ {0:N2}'}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,8,10,8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#C62828" />
                        
                    </Grid>
                    
                </Grid>

            </Grid>

            <!-- ================================================= -->
            <!-- FULLY ADJUSTED                                   -->
            <!-- ================================================= -->

            <Border Visibility="{Binding IsFullyAdjusted,
                                     Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="30"
                    CornerRadius="8"
                    Background="#F3F4F6">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="FULLY ADJUSTED"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#374151" />

                    <TextBlock Text="No receipt or refund is required."
                               Margin="0,8,0,0"
                               Foreground="Gray"
                               HorizontalAlignment="Center" />

                </StackPanel>

            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- VALIDATION                                            -->
        <!-- ===================================================== -->

        <Border Grid.Row="6"
                Padding="10"
                CornerRadius="5"
                Background="#FFFBEB"
                BorderBrush="#FDE68A"
                BorderThickness="1">

            <TextBlock Text="{Binding ValidationMessage}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Foreground="#374151" />
        </Border>

        <!-- ===================================================== -->
        <!-- BUTTONS                                               -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="110"
                    Padding="10,7"
                    Margin="0,0,10,0"
                    IsCancel="True" />

            <Button Content="Confirm Settlement"
                    Width="160"
                    Padding="10,7"
                    Foreground="#C62828"
                    FontWeight="Bold"
                    FontSize="15"
                    IsDefault="True"
                    Click="ConfirmSettlement_Click" />

        </StackPanel>

    </Grid>

</dx:ThemedWindow>
