<UserControl x:Class="InvEntry.Views.ProductStockEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
             xmlns:ext="clr-namespace:InvEntry.Extension"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProductStockEntryViewModel}"
             DataContext="{ext:DISource Type=viewmodels:ProductStockEntryViewModel}"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="900">

    <UserControl.Resources>

        <!-- Theme -->
        <SolidColorBrush x:Key="PageBg" Color="#111827"/>
        <SolidColorBrush x:Key="CardBg" Color="#1F2937"/>
        <SolidColorBrush x:Key="InsetBg" Color="#172234"/>
        <SolidColorBrush x:Key="Stroke" Color="#374151"/>
        <SolidColorBrush x:Key="Primary" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="Muted" Color="#AAB7C9"/>
        <SolidColorBrush x:Key="Good" Color="#6EE7B7"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="NumberFormatStyle"
               TargetType="dxe:TextEditSettings">
            <Setter Property="MaskType" Value="Numeric"/>
            <Setter Property="Mask" Value="######.000"/>
            <Setter Property="MaskShowPlaceHolders" Value="False"/>
            <Setter Property="MaskUseAsDisplayFormat" Value="True"/>
            <Setter Property="dxe:NumericMaskOptions.AlwaysShowDecimalSeparator"
                    Value="False"/>
        </Style>

        <dxmvvm:BooleanNegationConverter
            x:Key="NegationConverter"/>

    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==========================================
             HEADER
             ========================================== -->

        <Border Grid.Row="0"
                Background="#0B1220"
                Padding="18,12"
                BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="STOCK CLOSING"
                               Foreground="{StaticResource Primary}"
                               FontSize="22"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Select receipt  •  Select product  •  Weigh  •  Print tag"
                               Foreground="{StaticResource Muted}"
                               FontSize="12"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="ITEM WEIGHING"
                           Foreground="{StaticResource Good}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ==========================================
             FILTER BAR
             ========================================== -->

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="14,10,14,0"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SUPPLIER"
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,4"/>

                    <dxe:ComboBoxEdit
                        EditValue="{Binding SupplierID,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding SupplierReferencesList}"
                        IsTextEditable="False"
                        NullText="All suppliers"
                        Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="FROM"
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,4"/>

                    <dxe:DateEdit
                        EditValue="{Binding SearchOption.From,
                                            Mode=TwoWay}"
                        DisplayFormatString="dd-MMM-yyyy"
                        MaskUseAsDisplayFormat="True"
                        Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="TO"
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,4"/>

                    <dxe:DateEdit
                        EditValue="{Binding SearchOption.To,
                                            Mode=TwoWay}"
                        MaxValue="{Binding Today}"
                        DisplayFormatString="dd-MMM-yyyy"
                        MaskUseAsDisplayFormat="True"
                        Height="32"/>
                </StackPanel>

                <dx:SimpleButton
                    Grid.Column="6"
                    Content="Refresh GRN"
                    Command="{Binding RefreshGRNCommand}"
                    Height="32"
                    Padding="12,4"
                    VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- ==========================================
             ERROR PANEL
             ========================================== -->

        <Border Grid.Row="2"
                Margin="14,8,14,0"
                Padding="10"
                Background="#3A171C"
                BorderBrush="#EF4444"
                BorderThickness="1"
                CornerRadius="6">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>

                <Button DockPanel.Dock="Right"
                        Content="×"
                        Command="{Binding ClearErrorsCommand}"
                        Background="Transparent"
                        Foreground="#FCA5A5"
                        BorderThickness="0"
                        Width="26"/>

                <StackPanel>
                    <TextBlock Text="{Binding ErrorPanelTitle}"
                               Foreground="#FECACA"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ErrorPanelMessage}"
                               Foreground="#FCA5A5"
                               TextWrapping="Wrap"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ==========================================
             MAIN WORKSPACE
             ========================================== -->

        <Grid Grid.Row="3"
              Margin="14,10,14,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================
                 LEFT: GRN NAVIGATOR
                 ====================================== -->

            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="0.9*"/>
                </Grid.RowDefinitions>

                <!-- OPEN MATERIAL RECEIPTS -->

                <Border Grid.Row="0"
                        Style="{StaticResource Card}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="12,10">

                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding GrnHdrList.Count,
                                                      StringFormat={}{0} open}"
                                       Foreground="{StaticResource Good}"/>

                            <TextBlock Text="OPEN MATERIAL RECEIPTS"
                                       Foreground="{StaticResource Primary}"
                                       FontWeight="SemiBold"/>
                        </DockPanel>

                        <dxg:GridControl
                            Grid.Row="1"
                            ItemsSource="{Binding GrnHdrList}"
                            SelectedItem="{Binding SelectedGrn, Mode=TwoWay}"
                            AutoGenerateColumns="None">

                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand
                                    EventName="SelectedItemChanged"
                                    Command="{Binding SelectionGRNChangedCommand}"/>
                            </dxmvvm:Interaction.Behaviors>

                            <dxg:GridControl.View>
                                <dxg:TableView
                                    AllowEditing="False"
                                    AllowGrouping="False"
                                    ShowGroupPanel="False"
                                    ShowIndicator="False"
                                    AutoWidth="True"
                                    NavigationStyle="Row"
                                    RowMinHeight="34"/>
                            </dxg:GridControl.View>

                            <dxg:GridControl.Columns>

                                <dxg:GridColumn
                                    FieldName="GrnNbr"
                                    Header="GRN #"
                                    Width="95"/>

                                <dxg:GridColumn
                                    FieldName="GrnDate"
                                    Header="Date"
                                    Width="95">

                                    <dxg:GridColumn.EditSettings>
                                        <dxe:DateEditSettings
                                            DisplayFormat="dd-MMM-yy"/>
                                    </dxg:GridColumn.EditSettings>

                                </dxg:GridColumn>

                                <dxg:GridColumn
                                    FieldName="DocumentRef"
                                    Header="Ref"
                                    Width="*"/>

                            </dxg:GridControl.Columns>

                        </dxg:GridControl>

                    </Grid>
                </Border>

                <!-- PRODUCTS TO PROCESS -->

                <Border Grid.Row="2"
                        Style="{StaticResource Card}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="12,10">

                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding GrnLineSumryList.Count,
                                                      StringFormat={}{0} products}"
                                       Foreground="{StaticResource Good}"/>

                            <TextBlock Text="PRODUCTS TO PROCESS"
                                       Foreground="{StaticResource Primary}"
                                       FontWeight="SemiBold"/>
                        </DockPanel>

                        <dxg:GridControl
                            Grid.Row="1"
                            ItemsSource="{Binding GrnLineSumryList}"
                            SelectedItem="{Binding SelectedGrnLineSumry,
                                                   Mode=TwoWay}"
                            AutoGenerateColumns="None">

                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand
                                    EventName="SelectedItemChanged"
                                    Command="{Binding SelectionGrnSumryListChangedCommand}"/>
                            </dxmvvm:Interaction.Behaviors>

                            <dxg:GridControl.View>
                                <dxg:TableView
                                    AllowEditing="False"
                                    AllowGrouping="False"
                                    ShowGroupPanel="False"
                                    ShowIndicator="False"
                                    AutoWidth="True"
                                    NavigationStyle="Row"
                                    RowMinHeight="36"/>
                            </dxg:GridControl.View>

                            <dxg:GridControl.Columns>

                                <dxg:GridColumn
                                    FieldName="ProductCategory"
                                    Header="Product"
                                    Width="*"/>

                                <dxg:GridColumn
                                    FieldName="ProductPurity"
                                    Header="Purity"
                                    Width="65"/>

                                <dxg:GridColumn
                                    FieldName="SuppliedQty"
                                    Header="Qty"
                                    Width="45"/>

                            </dxg:GridControl.Columns>

                        </dxg:GridControl>

                    </Grid>
                </Border>

            </Grid>

            <!-- ======================================
                 RIGHT: WEIGHING WORKSTATION
                 ====================================== -->

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CURRENT PRODUCT -->

                <Border Grid.Row="0"
                        Style="{StaticResource Card}"
                        Padding="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="145"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="CURRENT PRODUCT"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLineSumry.ProductCategory,
                                               TargetNullValue='Select a product'}"
                                Foreground="{StaticResource Primary}"
                                FontSize="21"
                                FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="Purity: "
                                           Foreground="{StaticResource Muted}"/>

                                <TextBlock
                                    Text="{Binding SelectedGrnLineSumry.ProductPurity}"
                                    Foreground="{StaticResource Primary}"/>

                                <TextBlock Text="   UOM: "
                                           Foreground="{StaticResource Muted}"/>

                                <TextBlock
                                    Text="{Binding SelectedGrnLineSumry.Uom}"
                                    Foreground="{StaticResource Primary}"/>

                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="RECEIVED"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLineSumry.SuppliedQty,
                                               StringFormat={}{0} pcs,
                                               TargetNullValue='-'}"
                                Style="{StaticResource Metric}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="GRN GROSS"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLineSumry.GrossWeight,
                                               StringFormat={}{0:N3} g,
                                               TargetNullValue='-'}"
                                Style="{StaticResource Metric}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="3">

                            <TextBlock Text="GRN NET"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLineSumry.NetWeight,
                                               StringFormat={}{0:N3} g,
                                               TargetNullValue='-'}"
                                Style="{StaticResource Metric}"
                                Foreground="{StaticResource Good}"/>

                        </StackPanel>

                    </Grid>
                </Border>

                <!-- SELECTED ITEM FOCUS PANEL -->

                <Border Grid.Row="2"
                        Style="{StaticResource Card}"
                        Padding="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="SELECTED ITEM"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLine.ProductSku,
                                               TargetNullValue='Select a row below'}"
                                Foreground="{StaticResource Primary}"
                                FontSize="20"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Click its Gross cell below to capture scale weight; or type in manual mode."
                                Foreground="{StaticResource Muted}"
                                FontSize="11"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="GROSS (g)"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLine.GrossWeight,
                                               StringFormat={}{0:N3},
                                               TargetNullValue='—'}"
                                Style="{StaticResource Metric}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="STONE (g)"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLine.StoneWeight,
                                               StringFormat={}{0:N3},
                                               TargetNullValue='—'}"
                                Style="{StaticResource Metric}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="3">

                            <TextBlock Text="NET (g)"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLine.NetWeight,
                                               StringFormat={}{0:N3},
                                               TargetNullValue='—'}"
                                Style="{StaticResource Metric}"
                                Foreground="{StaticResource Good}"/>

                        </StackPanel>

                    </Grid>
                </Border>

                <!-- INDIVIDUAL ITEM GRID -->

                <Border Grid.Row="4"
                        Style="{StaticResource Card}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="14,10">

                            <TextBlock DockPanel.Dock="Right"
                                       Text="Select row → weigh → Print"
                                       Foreground="{StaticResource Good}"
                                       FontSize="11"/>

                            <TextBlock Text="INDIVIDUAL ITEMS"
                                       Foreground="{StaticResource Primary}"
                                       FontWeight="SemiBold"/>

                        </DockPanel>

                        <dxg:GridControl
                            Grid.Row="1"
                            ItemsSource="{Binding GrnLineList}"
                            SelectedItem="{Binding SelectedGrnLine,
                                                   Mode=TwoWay}"
                            AutoGenerateColumns="None">

                            <dxg:GridControl.View>

                                <dxg:TableView
                                    x:Name="tableView3"
                                    AllowGrouping="False"
                                    ShowGroupPanel="False"
                                    ShowAutoFilterRow="False"
                                    AutoWidth="True"
                                    TotalSummaryPosition="Bottom"
                                    VerticalScrollbarVisibility="Auto"
                                    AllowEditing="True"
                                    EditorShowMode="MouseDown"
                                    NavigationStyle="Cell"
                                    ShowIndicator="False"
                                    RowMinHeight="40">

                                    <!-- Preserve existing weighing logic -->

                                    <dxmvvm:Interaction.Behaviors>

                                        <dxmvvm:EventToCommand
                                            EventName="CellValueChanged"
                                            Command="{Binding CellUpdateCommand}"
                                            PassEventArgsToCommand="True"/>

                                        <dxmvvm:EventToCommand
                                            EventName="ShowingEditor"
                                            Command="{Binding EditorActivatedCommand}"
                                            PassEventArgsToCommand="True"/>

                                        <dxmvvm:EventToCommand
                                            EventName="ValidateCell"
                                            Command="{Binding ValidateCellCommand}"
                                            PassEventArgsToCommand="True"/>

                                    </dxmvvm:Interaction.Behaviors>

                                </dxg:TableView>

                            </dxg:GridControl.View>

                            <dxg:GridControl.Columns>

                                <dxg:GridColumn
                                    FieldName="LineNbr"
                                    Header="#"
                                    Width="45"
                                    ReadOnly="True"/>

                                <dxg:GridColumn
                                    FieldName="ProductSku"
                                    Header="SKU / BARCODE"
                                    Width="*"
                                    ReadOnly="True"/>

                                <dxg:GridColumn
                                    FieldName="GrossWeight"
                                    Header="GROSS (g)"
                                    Width="110"
                                    AllowedTotalSummaries="Sum">

                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings
                                            Style="{StaticResource NumberFormatStyle}"
                                            HorizontalContentAlignment="Right"/>
                                    </dxg:GridColumn.EditSettings>

                                </dxg:GridColumn>

                                <dxg:GridColumn
                                    FieldName="StoneWeight"
                                    Header="STONE (g)"
                                    Width="105">

                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings
                                            Style="{StaticResource NumberFormatStyle}"
                                            HorizontalContentAlignment="Right"/>
                                    </dxg:GridColumn.EditSettings>

                                </dxg:GridColumn>

                                <dxg:GridColumn
                                    FieldName="NetWeight"
                                    Header="NET (g)"
                                    Width="105"
                                    ReadOnly="True">

                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings
                                            Style="{StaticResource NumberFormatStyle}"
                                            HorizontalContentAlignment="Right"/>
                                    </dxg:GridColumn.EditSettings>

                                </dxg:GridColumn>

                                <!-- Existing print command -->

                                <dxg:GridColumn
                                    Header="TAG"
                                    Width="92"
                                    AllowEditing="False">

                                    <dxg:GridColumn.CellTemplate>

                                        <DataTemplate>

                                            <dx:SimpleButton
                                                Content="Print"
                                                Padding="8,3"
                                                Command="{Binding DataContext.PrintTagCommand,
                                                                  RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                                                CommandParameter="{Binding RowData.Row}"
                                                HorizontalAlignment="Center"/>

                                        </DataTemplate>

                                    </dxg:GridColumn.CellTemplate>

                                </dxg:GridColumn>

                            </dxg:GridControl.Columns>

                            <dxg:GridControl.TotalSummary>

                                <dxg:GridSummaryItem
                                    FieldName="GrossWeight"
                                    SummaryType="Sum"
                                    DisplayFormat="{}{0:N3}"/>

                                <dxg:GridSummaryItem
                                    FieldName="StoneWeight"
                                    SummaryType="Sum"
                                    DisplayFormat="{}{0:N3}"/>

                                <dxg:GridSummaryItem
                                    FieldName="NetWeight"
                                    SummaryType="Sum"
                                    DisplayFormat="{}{0:N3}"/>

                            </dxg:GridControl.TotalSummary>

                        </dxg:GridControl>

                    </Grid>
                </Border>

                <!-- GRN TOTALS -->

                <Border Grid.Row="6"
                        Style="{StaticResource Card}"
                        Padding="12">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="GRN QTY"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLineSumry.SuppliedQty,
                                               StringFormat={}{0} pcs,
                                               TargetNullValue='-'}"
                                Style="{StaticResource Metric}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="GRN GROSS"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLineSumry.GrossWeight,
                                               StringFormat={}{0:N3} g,
                                               TargetNullValue='-'}"
                                Style="{StaticResource Metric}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="GRN STONE"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLineSumry.StoneWeight,
                                               StringFormat={}{0:N3} g,
                                               TargetNullValue='-'}"
                                Style="{StaticResource Metric}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="3">

                            <TextBlock Text="GRN NET"
                                       Style="{StaticResource Caption}"/>

                            <TextBlock
                                Text="{Binding SelectedGrnLineSumry.NetWeight,
                                               StringFormat={}{0:N3} g,
                                               TargetNullValue='-'}"
                                Style="{StaticResource Metric}"
                                Foreground="{StaticResource Good}"/>

                        </StackPanel>

                    </Grid>
                </Border>

            </Grid>

        </Grid>

        <!-- ==========================================
             BOTTOM ACTION BAR
             ========================================== -->

        <Border Grid.Row="4"
                Background="#0B1220"
                BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,1,0,0"
                Padding="14,9">

            <DockPanel>

                <dx:SimpleButton
                    DockPanel.Dock="Right"
                    Content="CLOSE / SUBMIT GRN"
                    Command="{Binding SubmitCommand}"
                    Padding="18,8"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="AUTO: click Gross cell to read scale     •     MANUAL: type Gross / Stone     •     Print each tag before closing"
                    Foreground="{StaticResource Muted}"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"/>

            </DockPanel>

        </Border>

    </Grid>

</UserControl>