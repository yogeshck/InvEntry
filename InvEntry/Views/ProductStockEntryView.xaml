<UserControl x:Class="InvEntry.Views.ProductStockEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InvEntry.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:behavior="clr-namespace:InvEntry.Behavior"
             xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
             xmlns:ext="clr-namespace:InvEntry.Extension"

             d:DataContext="{d:DesignInstance Type=viewmodels:ProductStockEntryViewModel}"
             DataContext="{ext:DISource Type=viewmodels:ProductStockEntryViewModel}"

             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="900">

    <!-- ==========================================================
         PRODUCT STOCK ENTRY / STOCK CLOSING

         Stage 1 redesign:
         - Existing ViewModel bindings retained
         - Existing weighing behaviour retained
         - Existing print logic retained
         - Existing validation retained
         ========================================================== -->

    <UserControl.Resources>

        <!-- ======================================================
             LOCAL COLOURS

             These can later be moved to AppStyles.xaml.
             ====================================================== -->

        <SolidColorBrush x:Key="StockPageBackground"
                         Color="#111827"/>

        <SolidColorBrush x:Key="StockTopBarBackground"
                         Color="#0B1220"/>

        <SolidColorBrush x:Key="StockCardBackground"
                         Color="#1F2937"/>

        <SolidColorBrush x:Key="StockCardBackground2"
                         Color="#253044"/>

        <SolidColorBrush x:Key="StockBorderBrush"
                         Color="#374151"/>

        <SolidColorBrush x:Key="StockTextPrimary"
                         Color="#F9FAFB"/>

        <SolidColorBrush x:Key="StockTextSecondary"
                         Color="#9CA3AF"/>

        <SolidColorBrush x:Key="StockAccentBrush"
                         Color="#3B82F6"/>

        <SolidColorBrush x:Key="StockSuccessBrush"
                         Color="#10B981"/>

        <SolidColorBrush x:Key="StockWarningBrush"
                         Color="#F59E0B"/>

        <SolidColorBrush x:Key="StockErrorBrush"
                         Color="#EF4444"/>


        <!-- ======================================================
             EXISTING NUMBER FORMAT
             ====================================================== -->

        <Style x:Key="NumberFormatStyle"
               TargetType="dxe:TextEditSettings">

            <Setter Property="MaskType"
                    Value="Numeric"/>

            <Setter Property="Mask"
                    Value="######.000"/>

            <Setter Property="MaskShowPlaceHolders"
                    Value="False"/>

            <Setter Property="MaskUseAsDisplayFormat"
                    Value="True"/>

            <Setter Property="dxe:NumericMaskOptions.AlwaysShowDecimalSeparator"
                    Value="False"/>

        </Style>


        <dxmvvm:BooleanNegationConverter
            x:Key="NegationConverter"/>

        <BooleanToVisibilityConverter
            x:Key="BoolToVisibilityConverter"/>


        <!-- ======================================================
             CARD
             ====================================================== -->

        <Style x:Key="StockCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource StockCardBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource StockBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

        </Style>


        <!-- ======================================================
             LABEL
             ====================================================== -->

        <Style x:Key="StockLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource StockTextSecondary}"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <!-- ======================================================
             VALUE
             ====================================================== -->

        <Style x:Key="StockValueStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource StockTextPrimary}"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <!-- ======================================================
             SECTION TITLE
             ====================================================== -->

        <Style x:Key="StockSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource StockTextPrimary}"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

    </UserControl.Resources>


    <!-- ==========================================================
         ROOT
         ========================================================== -->

    <Grid Background="{StaticResource StockPageBackground}">

        <Grid.RowDefinitions>

            <!-- Page title -->
            <RowDefinition Height="Auto"/>

            <!-- Search / GRN filters -->
            <RowDefinition Height="Auto"/>

            <!-- Error panel -->
            <RowDefinition Height="Auto"/>

            <!-- Main work area -->
            <RowDefinition Height="*"/>

            <!-- Bottom command bar -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ======================================================
             TOP TITLE BAR
             ====================================================== -->

        <Border Grid.Row="0"
                Background="{StaticResource StockTopBarBackground}"
                BorderBrush="{StaticResource StockBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,13">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="STOCK CLOSING"
                                   Foreground="{StaticResource StockTextPrimary}"
                                   FontSize="23"
                                   FontWeight="SemiBold"/>

                        <Border Margin="14,2,0,0"
                                Padding="9,3"
                                Background="#172554"
                                CornerRadius="10">

                            <TextBlock Text="ITEM WEIGHING"
                                       Foreground="#93C5FD"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>

                        </Border>

                    </StackPanel>


                    <TextBlock Margin="0,3,0,0"
                               Text="Create individual stock items from Material Receipt / GRN"
                               Foreground="{StaticResource StockTextSecondary}"
                               FontSize="12"/>

                </StackPanel>


                <!-- MODE DISPLAY -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">


                    <TextBlock Text="WEIGHING MODE"
                               Foreground="{StaticResource StockTextSecondary}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>


                    <!--
                         Visual only in Stage 1.
                         We will bind this to IsManualMode / WeighingMode
                         in the ViewModel refactor.
                    -->

                    <Border Background="#123A31"
                            BorderBrush="{StaticResource StockSuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource StockSuccessBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0"/>

                            <TextBlock Text="AUTO / MANUAL"
                                       Foreground="#D1FAE5"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ======================================================
             SEARCH / FILTER BAR

             Existing bindings retained:
             SupplierID
             SupplierReferencesList
             SearchOption.From
             SearchOption.To
             Today
             RefreshGRNCommand
             ====================================================== -->

        <Border Grid.Row="1"
                Margin="16,12,16,0"
                Padding="14"
                Background="{StaticResource StockCardBackground}"
                BorderBrush="{StaticResource StockBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- SUPPLIER -->

                <StackPanel Grid.Column="0">

                    <TextBlock Text="SUPPLIER"
                               Style="{StaticResource StockLabelStyle}"
                               Margin="0,0,0,5"/>

                    <dxe:ComboBoxEdit EditValue="{Binding SupplierID,
                                                         Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding SupplierReferencesList}"
                                      Height="34"
                                      IsTextEditable="False"
                                      NullText="All suppliers"/>

                </StackPanel>


                <!-- FROM DATE -->

                <StackPanel Grid.Column="2">

                    <TextBlock Text="FROM DATE"
                               Style="{StaticResource StockLabelStyle}"
                               Margin="0,0,0,5"/>

                    <dxe:DateEdit EditValue="{Binding SearchOption.From,
                                                    Mode=TwoWay}"
                                  Height="34"
                                  DisplayFormatString="dd-MMM-yyyy"
                                  MaskUseAsDisplayFormat="True"/>

                </StackPanel>


                <!-- TO DATE -->

                <StackPanel Grid.Column="4">

                    <TextBlock Text="TO DATE"
                               Style="{StaticResource StockLabelStyle}"
                               Margin="0,0,0,5"/>

                    <dxe:DateEdit EditValue="{Binding SearchOption.To,
                                                    Mode=TwoWay}"
                                  MaxValue="{Binding Today}"
                                  Height="34"
                                  DisplayFormatString="dd-MMM-yyyy"
                                  MaskUseAsDisplayFormat="True"/>

                </StackPanel>


                <!-- REFRESH -->

                <dx:SimpleButton Grid.Column="6"
                                 Content="Refresh GRN"
                                 Command="{Binding RefreshGRNCommand}"
                                 Glyph="{dx:DXImage 'Images/Actions/Refresh_16x16.png'}"
                                 Padding="14,6"
                                 Height="34"
                                 VerticalAlignment="Bottom"/>


                <!-- SCALE STATUS - visual for now -->

                <Border Grid.Column="8"
                        Padding="12,6"
                        Background="#123A31"
                        BorderBrush="#166534"
                        BorderThickness="1"
                        CornerRadius="6"
                        VerticalAlignment="Bottom">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource StockSuccessBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"/>

                        <TextBlock Text="WEIGHING STATION"
                                   Foreground="#A7F3D0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ======================================================
             ERROR / PRINT STATUS PANEL

             Existing bindings retained.
             ====================================================== -->

        <Border Grid.Row="2"
                Margin="16,10,16,0"
                Padding="12"
                Background="#3A171C"
                BorderBrush="{StaticResource StockErrorBrush}"
                BorderThickness="1"
                CornerRadius="6">

            <Border.Style>

                <Style TargetType="Border">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding HasError}"
                                     Value="True">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Border.Style>


            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="⚠"
                           Foreground="#FCA5A5"
                           FontSize="20"
                           Margin="0,0,10,0"
                           VerticalAlignment="Top"/>


                <StackPanel Grid.Column="1">

                    <TextBlock Text="{Binding ErrorPanelTitle}"
                               Foreground="#FECACA"
                               FontSize="13"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ErrorPanelMessage}"
                               Foreground="#FCA5A5"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <Button Grid.Column="2"
                        Content="×"
                        Command="{Binding ClearErrorsCommand}"
                        Width="26"
                        Height="26"
                        Padding="0"
                        FontSize="16"
                        Foreground="#FCA5A5"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Top"/>

            </Grid>

        </Border>


        <!-- ======================================================
             MAIN WORK AREA
             ====================================================== -->

        <Grid Grid.Row="3"
              Margin="16,12,16,12">

            <Grid.ColumnDefinitions>

                <!-- LEFT: GRN selection -->
                <ColumnDefinition Width="390"/>

                <ColumnDefinition Width="12"/>

                <!-- RIGHT: active processing -->
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ==================================================
                 LEFT SIDE
                 ================================================== -->

            <Grid Grid.Column="0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="1.1*"/>

                    <RowDefinition Height="12"/>

                    <RowDefinition Height="0.9*"/>

                </Grid.RowDefinitions>


                <!-- ==============================================
                     OPEN GRN LIST
                     ============================================== -->

                <Border Grid.Row="0"
                        Style="{StaticResource StockCardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- HEADER -->

                        <Border Padding="14,12"
                                BorderBrush="{StaticResource StockBorderBrush}"
                                BorderThickness="0,0,0,1">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock Text="OPEN MATERIAL RECEIPTS"
                                               Style="{StaticResource StockSectionTitleStyle}"/>

                                    <TextBlock Text="Select the GRN to process"
                                               Foreground="{StaticResource StockTextSecondary}"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>

                                </StackPanel>


                                <Border Grid.Column="1"
                                        Background="#172554"
                                        Padding="8,3"
                                        CornerRadius="9"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="{Binding GrnHdrList.Count,
                                                              StringFormat={}{0} open}"
                                               Foreground="#93C5FD"
                                               FontSize="10"/>

                                </Border>

                            </Grid>

                        </Border>


                        <!-- GRN GRID -->

                        <dxg:GridControl Grid.Row="1"
                                         ItemsSource="{Binding GrnHdrList}"
                                         SelectedItem="{Binding SelectedGrn,
                                                                Mode=TwoWay}"
                                         AutoGenerateColumns="None">

                            <dxmvvm:Interaction.Behaviors>

                                <dxmvvm:EventToCommand
                                    EventName="SelectedItemChanged"
                                    Command="{Binding SelectionGRNChangedCommand}"/>

                            </dxmvvm:Interaction.Behaviors>


                            <dxg:GridControl.View>

                                <dxg:TableView AllowBestFit="False"
                                               NavigationStyle="Row"
                                               AllowEditing="False"
                                               AllowGrouping="False"
                                               ShowGroupPanel="False"
                                               ShowAutoFilterRow="False"
                                               AutoWidth="True"
                                               ShowIndicator="False"
                                               ShowHorizontalLines="True"
                                               ShowVerticalLines="False"
                                               RowMinHeight="32"/>

                            </dxg:GridControl.View>


                            <dxg:GridControl.Columns>

                                <dxg:GridColumn FieldName="GrnNbr"
                                                Header="GRN #"
                                                Width="90"
                                                ReadOnly="True"/>

                                <dxg:GridColumn FieldName="GrnDate"
                                                Header="Date"
                                                Width="90"
                                                ReadOnly="True">

                                    <dxg:GridColumn.EditSettings>

                                        <dxe:DateEditSettings
                                            DisplayFormat="dd-MMM-yy"/>

                                    </dxg:GridColumn.EditSettings>

                                </dxg:GridColumn>


                                <dxg:GridColumn FieldName="SupplierId"
                                                Header="Supplier"
                                                Width="*"
                                                ReadOnly="True"/>

                                <dxg:GridColumn FieldName="DocumentRef"
                                                Header="Ref"
                                                Width="85"
                                                ReadOnly="True"/>

                            </dxg:GridControl.Columns>

                        </dxg:GridControl>

                    </Grid>

                </Border>


                <!-- ==============================================
                     PRODUCTS IN SELECTED GRN
                     ============================================== -->

                <Border Grid.Row="2"
                        Style="{StaticResource StockCardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <Border Padding="14,12"
                                BorderBrush="{StaticResource StockBorderBrush}"
                                BorderThickness="0,0,0,1">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock Text="PRODUCTS TO PROCESS"
                                               Style="{StaticResource StockSectionTitleStyle}"/>

                                    <TextBlock Text="Select a product / category"
                                               Foreground="{StaticResource StockTextSecondary}"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>

                                </StackPanel>


                                <Border Grid.Column="1"
                                        Background="#3B2F14"
                                        Padding="8,3"
                                        CornerRadius="9"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="{Binding GrnLineSumryList.Count,
                                                              StringFormat={}{0} products}"
                                               Foreground="#FCD34D"
                                               FontSize="10"/>

                                </Border>

                            </Grid>

                        </Border>


                        <dxg:GridControl Grid.Row="1"
                                         ItemsSource="{Binding GrnLineSumryList}"
                                         SelectedItem="{Binding SelectedGrnLineSumry,
                                                                Mode=TwoWay}"
                                         AutoGenerateColumns="None">

                            <dxmvvm:Interaction.Behaviors>

                                <dxmvvm:EventToCommand
                                    EventName="SelectedItemChanged"
                                    Command="{Binding SelectionGrnSumryListChangedCommand}"/>

                            </dxmvvm:Interaction.Behaviors>


                            <dxg:GridControl.View>

                                <dxg:TableView AllowBestFit="False"
                                               NavigationStyle="Row"
                                               AllowEditing="False"
                                               AllowGrouping="False"
                                               ShowGroupPanel="False"
                                               ShowAutoFilterRow="False"
                                               AutoWidth="True"
                                               ShowIndicator="False"
                                               ShowHorizontalLines="True"
                                               ShowVerticalLines="False"
                                               RowMinHeight="34"/>

                            </dxg:GridControl.View>


                            <dxg:GridControl.Columns>

                                <dxg:GridColumn FieldName="LineNbr"
                                                Header="#"
                                                Width="35"
                                                ReadOnly="True"/>

                                <dxg:GridColumn FieldName="ProductCategory"
                                                Header="Product"
                                                Width="*"
                                                ReadOnly="True"/>

                                <dxg:GridColumn FieldName="ProductPurity"
                                                Header="Purity"
                                                Width="60"
                                                ReadOnly="True"/>

                                <dxg:GridColumn FieldName="SuppliedQty"
                                                Header="Qty"
                                                Width="45"
                                                ReadOnly="True"/>

                                <dxg:GridColumn FieldName="GrossWeight"
                                                Header="Gross"
                                                Width="70"
                                                ReadOnly="True">

                                    <dxg:GridColumn.EditSettings>

                                        <dxe:TextEditSettings
                                            Style="{StaticResource NumberFormatStyle}"/>

                                    </dxg:GridColumn.EditSettings>

                                </dxg:GridColumn>

                            </dxg:GridControl.Columns>

                        </dxg:GridControl>

                    </Grid>

                </Border>

            </Grid>


            <!-- ==================================================
                 RIGHT PROCESSING AREA
                 ================================================== -->

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>

                    <!-- Current product -->
                    <RowDefinition Height="Auto"/>

                    <!-- spacing -->
                    <RowDefinition Height="12"/>

                    <!-- Item entry -->
                    <RowDefinition Height="*"/>

                    <!-- spacing -->
                    <RowDefinition Height="12"/>

                    <!-- totals -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ==============================================
                     CURRENT PRODUCT SUMMARY
                     ============================================== -->

                <Border Grid.Row="0"
                        Style="{StaticResource StockCardStyle}"
                        Padding="16">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="145"/>
                        </Grid.ColumnDefinitions>


                        <!-- PRODUCT -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="CURRENT PRODUCT"
                                       Style="{StaticResource StockLabelStyle}"/>

                            <TextBlock Text="{Binding SelectedGrnLineSumry.ProductCategory,
                                                    TargetNullValue='Select a product from the left'}"
                                       Foreground="{StaticResource StockTextPrimary}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0">

                                <TextBlock Text="Purity: "
                                           Foreground="{StaticResource StockTextSecondary}"
                                           FontSize="11"/>

                                <TextBlock Text="{Binding SelectedGrnLineSumry.ProductPurity,
                                                        TargetNullValue='-'}"
                                           Foreground="{StaticResource StockTextPrimary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="     UOM: "
                                           Foreground="{StaticResource StockTextSecondary}"
                                           FontSize="11"/>

                                <TextBlock Text="{Binding SelectedGrnLineSumry.Uom,
                                                        TargetNullValue='-'}"
                                           Foreground="{StaticResource StockTextPrimary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>

                            </StackPanel>

                        </StackPanel>


                        <!-- QTY -->

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="RECEIVED QTY"
                                       Style="{StaticResource StockLabelStyle}"/>

                            <TextBlock Text="{Binding SelectedGrnLineSumry.SuppliedQty,
                                                    StringFormat={}{0} pcs,
                                                    TargetNullValue='-'}"
                                       Foreground="{StaticResource StockTextPrimary}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- GROSS -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="GRN GROSS WT"
                                       Style="{StaticResource StockLabelStyle}"/>

                            <TextBlock Text="{Binding SelectedGrnLineSumry.GrossWeight,
                                                    StringFormat={}{0:N3} g,
                                                    TargetNullValue='-'}"
                                       Foreground="{StaticResource StockTextPrimary}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- NET -->

                        <StackPanel Grid.Column="3">

                            <TextBlock Text="GRN NET WT"
                                       Style="{StaticResource StockLabelStyle}"/>

                            <TextBlock Text="{Binding SelectedGrnLineSumry.NetWeight,
                                                    StringFormat={}{0:N3} g,
                                                    TargetNullValue='-'}"
                                       Foreground="#6EE7B7"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ==============================================
                     INDIVIDUAL ITEM WEIGHING GRID

                     IMPORTANT:
                     Existing behaviours retained:
                     CellUpdateCommand
                     EditorActivatedCommand
                     ValidateCellCommand

                     Therefore AUTO weighing continues to work.
                     ============================================== -->

                <Border Grid.Row="2"
                        Style="{StaticResource StockCardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- GRID HEADER -->

                        <Border Padding="16,12"
                                BorderBrush="{StaticResource StockBorderBrush}"
                                BorderThickness="0,0,0,1">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock Text="INDIVIDUAL ITEM WEIGHING"
                                               Style="{StaticResource StockSectionTitleStyle}"/>

                                    <TextBlock Text="Each row represents one physical stock item / barcode"
                                               Foreground="{StaticResource StockTextSecondary}"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>

                                </StackPanel>


                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{StaticResource StockSuccessBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,7,0"/>

                                    <TextBlock Text="Click Gross Wt to capture"
                                               Foreground="#A7F3D0"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- EXISTING LINE GRID -->

                        <dxg:GridControl Grid.Row="1"
                                         ItemsSource="{Binding GrnLineList}"
                                         SelectedItem="{Binding SelectedGrnLine,
                                                                Mode=TwoWay}"
                                         AutoGenerateColumns="None">

                            <dxg:GridControl.View>

                                <dxg:TableView x:Name="tableView3"
                                               AllowGrouping="False"
                                               ShowGroupPanel="False"
                                               ShowAutoFilterRow="False"
                                               AutoWidth="True"
                                               TotalSummaryPosition="Bottom"
                                               VerticalScrollbarVisibility="Auto"
                                               AllowEditing="True"
                                               EditorShowMode="MouseDown"
                                               NavigationStyle="Cell"
                                               ShowIndicator="False"
                                               ShowHorizontalLines="True"
                                               ShowVerticalLines="False"
                                               RowMinHeight="36">

                                    <!--
                                        THESE ARE IMPORTANT.
                                        Existing weighing logic retained.
                                    -->

                                    <dxmvvm:Interaction.Behaviors>

                                        <dxmvvm:EventToCommand
                                            EventName="CellValueChanged"
                                            Command="{Binding CellUpdateCommand}"
                                            PassEventArgsToCommand="True"/>

                                        <dxmvvm:EventToCommand
                                            EventName="ShowingEditor"
                                            Command="{Binding EditorActivatedCommand}"
                                            PassEventArgsToCommand="True"/>

                                        <dxmvvm:EventToCommand
                                            EventName="ValidateCell"
                                            Command="{Binding ValidateCellCommand}"
                                            PassEventArgsToCommand="True"/>

                                    </dxmvvm:Interaction.Behaviors>

                                </dxg:TableView>

                            </dxg:GridControl.View>


                            <dxg:GridControl.Columns>

                                <!-- REF -->

                                <dxg:GridColumn FieldName="Ref"
                                                Header="Ref"
                                                ReadOnly="True"
                                                Width="45"/>


                                <!-- LINE -->

                                <dxg:GridColumn FieldName="LineNbr"
                                                Header="#"
                                                ReadOnly="True"
                                                Width="40"/>


                                <!-- SKU -->

                                <dxg:GridColumn FieldName="ProductSku"
                                                Header="SKU / BARCODE"
                                                ReadOnly="True"
                                                Width="150"/>


                                <!-- GROSS -->

                                <dxg:GridColumn FieldName="GrossWeight"
                                                Header="GROSS WT"
                                                Width="105"
                                                AllowedTotalSummaries="Sum">

                                    <dxg:GridColumn.EditSettings>

                                        <dxe:TextEditSettings
                                            Style="{StaticResource NumberFormatStyle}"
                                            HorizontalContentAlignment="Right"/>

                                    </dxg:GridColumn.EditSettings>

                                </dxg:GridColumn>


                                <!-- STONE -->

                                <dxg:GridColumn FieldName="StoneWeight"
                                                Header="STONE WT"
                                                Width="100">

                                    <dxg:GridColumn.EditSettings>

                                        <dxe:TextEditSettings
                                            Style="{StaticResource NumberFormatStyle}"
                                            HorizontalContentAlignment="Right"/>

                                    </dxg:GridColumn.EditSettings>

                                </dxg:GridColumn>


                                <!-- NET -->

                                <dxg:GridColumn FieldName="NetWeight"
                                                Header="NET WT"
                                                Width="100"
                                                ReadOnly="True">

                                    <dxg:GridColumn.EditSettings>

                                        <dxe:TextEditSettings
                                            Style="{StaticResource NumberFormatStyle}"
                                            HorizontalContentAlignment="Right"/>

                                    </dxg:GridColumn.EditSettings>

                                </dxg:GridColumn>


                                <!-- SUPPLIED QTY -->

                                <dxg:GridColumn FieldName="SuppliedQty"
                                                Header="SUPP"
                                                Width="55"
                                                ReadOnly="True"/>


                                <!-- ORDERED QTY -->

                                <dxg:GridColumn FieldName="OrderedQty"
                                                Header="ORD"
                                                Width="55"
                                                ReadOnly="True"/>


                                <!-- RECEIVED -->

                                <dxg:GridColumn FieldName="ReceivedQty"
                                                Header="RECD"
                                                Width="55"/>


                                <!-- ACCEPTED -->

                                <dxg:GridColumn FieldName="AcceptedQty"
                                                Header="ACC"
                                                Width="55"/>


                                <!-- REJECTED -->

                                <dxg:GridColumn FieldName="RejectedQty"
                                                Header="REJ"
                                                Width="55"
                                                ReadOnly="True"/>


                                <!-- PRINT -->

                                <dxg:GridColumn Header="TAG"
                                                Width="90"
                                                AllowEditing="False">

                                    <dxg:GridColumn.CellTemplate>

                                        <DataTemplate>

                                            <dx:SimpleButton
                                                Content="Print"
                                                Padding="8,3"
                                                Command="{Binding DataContext.PrintTagCommand,
                                                    RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                                                CommandParameter="{Binding RowData.Row}"
                                                IsEnabled="{Binding RowData.Row.IsPrinted,
                                                    Converter={StaticResource NegationConverter}}"
                                                Glyph="{dx:DXImage 'Images/Print/Print_16x16.png'}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </dxg:GridColumn.CellTemplate>

                                </dxg:GridColumn>

                            </dxg:GridControl.Columns>


                            <!-- TOTALS -->

                            <dxg:GridControl.TotalSummary>

                                <dxg:GridSummaryItem
                                    FieldName="GrossWeight"
                                    SummaryType="Sum"
                                    DisplayFormat="{}{0:N3}"/>

                                <dxg:GridSummaryItem
                                    FieldName="StoneWeight"
                                    SummaryType="Sum"
                                    DisplayFormat="{}{0:N3}"/>

                                <dxg:GridSummaryItem
                                    FieldName="NetWeight"
                                    SummaryType="Sum"
                                    DisplayFormat="{}{0:N3}"/>

                            </dxg:GridControl.TotalSummary>

                        </dxg:GridControl>

                    </Grid>

                </Border>


                <!-- ==============================================
                     PRODUCT RECONCILIATION / SUMMARY
                     ============================================== -->

                <Border Grid.Row="4"
                        Style="{StaticResource StockCardStyle}"
                        Padding="14">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- GRN QTY -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="GRN QTY"
                                       Style="{StaticResource StockLabelStyle}"/>

                            <TextBlock Text="{Binding SelectedGrnLineSumry.SuppliedQty,
                                                    StringFormat={}{0} pcs,
                                                    TargetNullValue='-'}"
                                       Style="{StaticResource StockValueStyle}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <!-- GRN GROSS -->

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="GRN GROSS"
                                       Style="{StaticResource StockLabelStyle}"/>

                            <TextBlock Text="{Binding SelectedGrnLineSumry.GrossWeight,
                                                    StringFormat={}{0:N3} g,
                                                    TargetNullValue='-'}"
                                       Style="{StaticResource StockValueStyle}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <!-- GRN STONE -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="GRN STONE"
                                       Style="{StaticResource StockLabelStyle}"/>

                            <TextBlock Text="{Binding SelectedGrnLineSumry.StoneWeight,
                                                    StringFormat={}{0:N3} g,
                                                    TargetNullValue='-'}"
                                       Style="{StaticResource StockValueStyle}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <!-- GRN NET -->

                        <StackPanel Grid.Column="3">

                            <TextBlock Text="GRN NET"
                                       Style="{StaticResource StockLabelStyle}"/>

                            <TextBlock Text="{Binding SelectedGrnLineSumry.NetWeight,
                                                    StringFormat={}{0:N3} g,
                                                    TargetNullValue='-'}"
                                       Foreground="#6EE7B7"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <!-- MESSAGE -->

                        <Border Grid.Column="4"
                                HorizontalAlignment="Right"
                                Background="#172554"
                                CornerRadius="6"
                                Padding="12,7">

                            <TextBlock Text="Enter individual weights and print each stock tag"
                                       Foreground="#BFDBFE"
                                       FontSize="11"/>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </Grid>


        <!-- ======================================================
             BOTTOM COMMAND BAR
             ====================================================== -->

        <Border Grid.Row="4"
                Background="{StaticResource StockTopBarBackground}"
                BorderBrush="{StaticResource StockBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- HELP / STATUS -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">


                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource StockSuccessBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"/>

                    <TextBlock Text="Ready"
                               Foreground="#A7F3D0"
                               FontWeight="SemiBold"
                               Margin="0,0,24,0"/>


                    <TextBlock Text="AUTO:"
                               Foreground="{StaticResource StockTextPrimary}"
                               FontWeight="SemiBold"/>

                    <TextBlock Text=" click Gross Wt to read weighing machine"
                               Foreground="{StaticResource StockTextSecondary}"
                               Margin="4,0,22,0"/>


                    <TextBlock Text="MANUAL:"
                               Foreground="{StaticResource StockTextPrimary}"
                               FontWeight="SemiBold"/>

                    <TextBlock Text=" type Gross / Stone weight"
                               Foreground="{StaticResource StockTextSecondary}"
                               Margin="4,0,0,0"/>

                </StackPanel>


                <!-- SUBMIT -->

                <dx:SimpleButton Grid.Column="1"
                                 Content="CLOSE / SUBMIT GRN"
                                 Command="{Binding SubmitCommand}"
                                 Glyph="{dx:DXImage 'Images/Actions/Apply_16x16.png'}"
                                 Padding="20,8"
                                 FontSize="13"
                                 FontWeight="SemiBold"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>