<UserControl x:Class="InvEntry.Views.ProductStockEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
    xmlns:ext="clr-namespace:InvEntry.Extension"
    xmlns:controls="clr-namespace:InvEntry.Controls"
    d:DataContext="{d:DesignInstance Type=viewmodels:ProductStockEntryViewModel}"
    DataContext="{ext:DISource Type=viewmodels:ProductStockEntryViewModel}"
    mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="900">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBg" Color="#111827"/>
        <SolidColorBrush x:Key="CardBg" Color="#1F2937"/>
        <SolidColorBrush x:Key="InsetBg" Color="#172234"/>
        <SolidColorBrush x:Key="Stroke" Color="#374151"/>
        <SolidColorBrush x:Key="Primary" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="Muted" Color="#AAB7C9"/>
        <SolidColorBrush x:Key="Good" Color="#6EE7B7"/>
        <dxmvvm:BooleanNegationConverter x:Key="NegationConverter"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1220" Padding="18,12"
                BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="GRN STOCK CLOSING" Foreground="{StaticResource Primary}"
                               FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Select receipt and product, then weigh and tag one item at a time"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="SIMULATION MODE — NO PHYSICAL LABEL PRINTED"
                           Foreground="#FBBF24" FontWeight="Bold"
                           Visibility="{Binding IsLabelPrintSimulation, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14,8,14,0" Padding="10" Background="#3A171C"
                BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Command="{Binding ClearErrorsCommand}"
                        Background="Transparent" Foreground="#FCA5A5" BorderThickness="0" Width="26"/>
                <StackPanel>
                    <TextBlock Text="{Binding ErrorPanelTitle}" Foreground="#FECACA" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ErrorPanelMessage}" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="14,10" SelectedIndex="{Binding SelectedWorkflowTabIndex, Mode=TwoWay}"
                    Background="{StaticResource PageBg}" BorderBrush="{StaticResource Stroke}">
            <TabItem Header="1  GRN SELECTION">
                <Grid Background="{StaticResource PageBg}" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SUPPLIER" Style="{StaticResource Caption}"/>
                                <dxe:ComboBoxEdit EditValue="{Binding SupplierID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding SupplierReferencesList}" IsTextEditable="False"
                                                  NullText="Select supplier" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FROM" Style="{StaticResource Caption}"/>
                                <dxe:DateEdit EditValue="{Binding SearchOption.From, Mode=TwoWay}"
                                              DisplayFormatString="dd-MMM-yyyy" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="TO" Style="{StaticResource Caption}"/>
                                <dxe:DateEdit EditValue="{Binding SearchOption.To, Mode=TwoWay}" MaxValue="{Binding Today}"
                                              DisplayFormatString="dd-MMM-yyyy" Height="32"/>
                            </StackPanel>
                            <dx:SimpleButton Grid.Column="6" Content="Refresh GRN" Command="{Binding RefreshGRNCommand}"
                                             Height="32" Padding="14,4" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="OPEN MATERIAL RECEIPTS" Margin="12,10" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
                                <dxg:GridControl Grid.Row="1" ItemsSource="{Binding GrnHdrList}" SelectedItem="{Binding SelectedGrn, Mode=TwoWay}" AutoGenerateColumns="None">
                                    <dxmvvm:Interaction.Behaviors><dxmvvm:EventToCommand EventName="SelectedItemChanged" Command="{Binding SelectionGRNChangedCommand}"/></dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.View><dxg:TableView AllowEditing="False" ShowGroupPanel="False" ShowIndicator="False" AutoWidth="True" NavigationStyle="Row"/></dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="GrnNbr" Header="GRN #"/><dxg:GridColumn FieldName="GrnDate" Header="Date"/><dxg:GridColumn FieldName="DocumentRef" Header="Reference"/>
                                </dxg:GridControl>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="PRODUCT / GRN LINE SUMMARY" Margin="12,10" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
                                <dxg:GridControl Grid.Row="1" ItemsSource="{Binding GrnLineSumryList}" SelectedItem="{Binding SelectedGrnLineSumry, Mode=TwoWay}" AutoGenerateColumns="None">
                                    <dxmvvm:Interaction.Behaviors><dxmvvm:EventToCommand EventName="SelectedItemChanged" Command="{Binding SelectionGrnSumryListChangedCommand}"/></dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl.View><dxg:TableView AllowEditing="False" ShowGroupPanel="False" ShowIndicator="False" AutoWidth="True" NavigationStyle="Row"/></dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="ProductCategory" Header="Product"/><dxg:GridColumn FieldName="ProductPurity" Header="Purity"/><dxg:GridColumn FieldName="SuppliedQty" Header="Qty"/>
                                </dxg:GridControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="SELECTED RECEIPT / PRODUCT" Style="{StaticResource Caption}"/><TextBlock Foreground="{StaticResource Primary}" FontSize="17"><Run Text="{Binding SelectedGrn.GrnNbr}"/><Run Text="  •  "/><Run Text="{Binding SelectedGrnLineSumry.ProductCategory}"/><Run Text="  •  "/><Run Text="{Binding SelectedGrnLineSumry.ProductPurity}"/></TextBlock></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="TOTAL" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalQuantity}" Style="{StaticResource Metric}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="COMPLETED" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CompletedQuantity}" Style="{StaticResource Metric}" Foreground="{StaticResource Good}"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="PENDING" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PendingQuantity}" Style="{StaticResource Metric}"/></StackPanel>
                            <dx:SimpleButton Grid.Column="4" Margin="8,0" Content="Continue to Weighing" Command="{Binding ContinueToWeighingCommand}" IsEnabled="{Binding CanContinueToWeighing}" Padding="18,8"/>
                            <dx:SimpleButton Grid.Column="5" Content="Close GRN" Command="{Binding SubmitCommand}" Padding="14,8"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="2  WEIGHING &amp; TAGGING" IsEnabled="{Binding IsWeighingTabEnabled}">
                <Grid Background="{StaticResource PageBg}" Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="SUPPLIER" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedGrn.SupplierId}" Style="{StaticResource Metric}"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="GRN NUMBER" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedGrn.GrnNbr}" Style="{StaticResource Metric}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="PRODUCT / PURITY" Style="{StaticResource Caption}"/><TextBlock Foreground="{StaticResource Primary}" FontSize="19"><Run Text="{Binding SelectedGrnLineSumry.ProductCategory}"/><Run Text=" / "/><Run Text="{Binding SelectedGrnLineSumry.ProductPurity}"/></TextBlock></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="PROGRESS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ProgressText}" Style="{StaticResource Metric}" Foreground="{StaticResource Good}"/></StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CURRENT ITEM SKU" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedGrnLine.ProductSku, TargetNullValue='Permanent SKU reserved on Preview or Print'}" Style="{StaticResource Metric}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="GROSS WEIGHT (g)" Style="{StaticResource Caption}"/><dxe:TextEdit EditValue="{Binding SelectedGrnLine.GrossWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Mask="n3" MaskType="Numeric" Height="36"><dxmvvm:Interaction.Behaviors><dxmvvm:EventToCommand EventName="EditValueChanged" Command="{Binding CalculateCurrentWeightsCommand}"/></dxmvvm:Interaction.Behaviors></dxe:TextEdit></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="STONE WEIGHT (g)" Style="{StaticResource Caption}"/><dxe:TextEdit EditValue="{Binding SelectedGrnLine.StoneWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Mask="n3" MaskType="Numeric" Height="36"><dxmvvm:Interaction.Behaviors><dxmvvm:EventToCommand EventName="EditValueChanged" Command="{Binding CalculateCurrentWeightsCommand}"/></dxmvvm:Interaction.Behaviors></dxe:TextEdit></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="NET WEIGHT (g)" Style="{StaticResource Caption}"/><dxe:TextEdit EditValue="{Binding SelectedGrnLine.NetWeight}" IsReadOnly="True" Mask="n3" MaskType="Numeric" Height="36"/></StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="VA / MAKING CHARGE" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedGrnLine.SuppVaPercent, StringFormat={}{0:0.##}%}" Style="{StaticResource Metric}"/></StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="12" Text="{Binding SimulationLabelPreview}" Foreground="#FBBF24" TextWrapping="Wrap" Visibility="{Binding IsLabelPrintSimulation, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <dx:SimpleButton Content="Capture Scale Weight" Command="{Binding CaptureScaleWeightCommand}" Margin="0,0,8,0" Padding="14,8"/>
                                    <dx:SimpleButton Content="Preview Tag" Command="{Binding PreviewTagCommand}" Margin="0,0,8,0" Padding="16,8"/>
                                    <dx:SimpleButton Content="PRINT TAG" Command="{Binding PrintTagCommand}" CommandParameter="{Binding SelectedGrnLine}" IsEnabled="{Binding IsPrintingTag, Converter={StaticResource NegationConverter}}" Padding="22,8" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="2,0,2,8">
                                    <TextBlock Text="LABEL PREVIEW" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
                                    <TextBlock DockPanel.Dock="Right" Text="700 × 250 printer dots  •  Code 128" Foreground="{StaticResource Muted}" FontSize="10"/>
                                </DockPanel>
                                <TabControl Grid.Row="1" Background="{StaticResource InsetBg}" BorderBrush="{StaticResource Stroke}">
                                    <TabItem Header="Visual Preview">
                                        <TabControl Background="{StaticResource InsetBg}" BorderThickness="0">
                                            <TabItem Header="Fit to Panel">
                                                <Grid Background="#172033" MinHeight="330" ClipToBounds="True">
                                                    <Grid Margin="12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="82"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock Text="PHYSICAL TAG PREVIEW" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="100 × 13 mm" Foreground="#94A3B8" FontSize="10"/>
                                                        </DockPanel>
                                                        <controls:JewelleryTagShape Grid.Row="1" Margin="4"/>
                                                        <TextBlock Grid.Row="2" Text="27.5 mm printable  |  27.5 mm printable  |  45 mm blank tail" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                                        <Border Grid.Row="3" Background="White" BorderBrush="#64748B" BorderThickness="1" Padding="4" MinHeight="125">
                                                            <controls:PixelPerfectImage Source="{Binding LabelPreviewImage}" Mode="Fit"/>
                                                        </Border>
                                                        <TextBlock Grid.Row="4" Text="Existing ZPL preview: native 700 × 250-dot canvas, uniformly scaled. Physical alignment is not calibrated." Foreground="#FBBF24" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    </Grid>
                                                    <TextBlock Text="Enter valid weights and click Preview Tag" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasLabelPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </TabItem>
                                            <TabItem Header="Actual Pixels">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#172033">
                                                    <StackPanel Width="1000" Margin="12">
                                                        <TextBlock Text="PHYSICAL TAG PREVIEW — 100:13 PROPORTION" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                        <controls:JewelleryTagShape Height="130"/>
                                                        <TextBlock Text="EXISTING ZPL PREVIEW — 700 × 250 NATIVE PIXELS" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                                        <Border Width="700" Height="250" HorizontalAlignment="Left" Background="White" BorderBrush="#64748B" BorderThickness="1">
                                                            <controls:PixelPerfectImage Source="{Binding LabelPreviewImage}" Mode="ActualPixels"/>
                                                        </Border>
                                                        <TextBlock Text="Not overlaid: printer DPI, media orientation and dot-to-millimetre mapping require calibration." Foreground="#FBBF24" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                        </TabControl>
                                    </TabItem>
                                    <TabItem Header="ZPL Text">
                                        <dxe:MemoEdit EditValue="{Binding LabelPreviewZpl}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" ShowBorder="False" NullText="Preview Tag to generate ZPL"/>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="COMPLETED ITEMS" Margin="12,10" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
                            <dxg:GridControl Grid.Row="1" ItemsSource="{Binding CompletedItems}" AutoGenerateColumns="None">
                                <dxg:GridControl.View><dxg:TableView AllowEditing="False" ShowGroupPanel="False" ShowIndicator="False" AutoWidth="True" VerticalScrollbarVisibility="Auto"/></dxg:GridControl.View>
                                <dxg:GridColumn FieldName="LineNbr" Header="#"/><dxg:GridColumn FieldName="ProductSku" Header="SKU"/><dxg:GridColumn FieldName="GrossWeight" Header="Gross"/><dxg:GridColumn FieldName="StoneWeight" Header="Stone"/><dxg:GridColumn FieldName="NetWeight" Header="Net"/><dxg:GridColumn FieldName="Status" Header="Status"/>
                            </dxg:GridControl>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                        <DockPanel><dx:SimpleButton DockPanel.Dock="Left" Content="← Change GRN / Back to Selection" Command="{Binding BackToSelectionCommand}" Padding="14,7"/><TextBlock Text="All pending items completed. Return to selection to close the GRN." Foreground="{StaticResource Good}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsWorkflowComplete, Converter={dxmvvm:BooleanToVisibilityConverter}}"/></DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>