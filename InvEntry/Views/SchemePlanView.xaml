<UserControl x:Class="InvEntry.Views.SchemePlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
             xmlns:ext="clr-namespace:InvEntry.Extension"
             d:DataContext="{d:DesignInstance Type=viewmodels:SchemePlanViewModel}"
             DataContext="{ext:DISource Type=viewmodels:SchemePlanViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:KeyToCommand KeyGesture="CTRL+S"
                             Command="{Binding SaveCommand}" />
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <dxb:BarContainerControl>
            <dxb:MainMenuControl>
                <dxb:BarButtonItem Content="New Plan"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   GlyphAlignment="Top"
                                   GlyphSize="Large"
                                   Glyph="{dx:DXImage 'Images/Actions/New_32x32.png'}"
                                   Command="{Binding NewPlanCommand}" />
                <dxb:BarButtonItem Content="Save Plan"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   GlyphAlignment="Top"
                                   GlyphSize="Large"
                                   Glyph="{dx:DXImage 'Images/Save/Save_32x32.png'}"
                                   Command="{Binding SaveCommand}" />
                <dxb:BarButtonItem Content="Refresh"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   GlyphAlignment="Top"
                                   GlyphSize="Large"
                                   Glyph="{dx:DXImage 'Images/Actions/Refresh_32x32.png'}"
                                   Command="{Binding LoadCommand}" />
            </dxb:MainMenuControl>
        </dxb:BarContainerControl>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- PLANS -->
            <dxg:GridControl ItemsSource="{Binding Plans}"
                             SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                             AutoGenerateColumns="None"
                             Margin="0,0,8,0">
                <dxg:GridControl.View>
                    <dxg:TableView AllowEditing="False"
                                   ShowGroupPanel="False"
                                   NavigationStyle="Row" />
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="PlanCode" Header="Code" Width="90" />
                <dxg:GridColumn FieldName="PlanName" Header="Name" Width="*" />
                <dxg:GridColumn FieldName="SchemeType" Header="Type" Width="70" />
                <dxg:GridColumn FieldName="TenureMonths" Header="Months" Width="60" />
                <dxg:GridColumn FieldName="Status" Header="Status" Width="70" />
                <dxg:GridColumn FieldName="EnrollmentCount" Header="Enrolled" Width="65" />
            </dxg:GridControl>

            <!-- EDITOR -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="5,0,0,8" />

                    <dxlc:LayoutControl Orientation="Horizontal" Padding="0">
                        <dxlc:LayoutGroup Orientation="Vertical" View="GroupBox" Header="Plan">
                            <dxlc:LayoutItem Label="Code">
                                <dxe:TextEdit EditValue="{Binding Editor.PlanCode, Mode=TwoWay}"
                                              CharacterCasing="Upper"
                                              MaxLength="30" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Name">
                                <dxe:TextEdit EditValue="{Binding Editor.PlanName, Mode=TwoWay}"
                                              MaxLength="100" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Scheme type">
                                <dxe:ComboBoxEdit ItemsSource="{Binding SchemeTypes}"
                                                  EditValue="{Binding Editor.SchemeType, Mode=TwoWay}"
                                                  IsTextEditable="False">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="EditValueChanged"
                                                               Command="{Binding SchemeTypeChangedCommand}" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Metal / purity"
                                             Visibility="{Binding IsWeightScheme, Converter={StaticResource BoolToVisibility}}">
                                <dxe:ComboBoxEdit ItemsSource="{Binding MetalOptions}"
                                                  EditValue="{Binding SelectedMetal, Mode=TwoWay}"
                                                  IsTextEditable="False"
                                                  NullText="Rate used to convert payments to grams">
                                    <dxe:ComboBoxEdit.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Metal}" />
                                                <Run Text="{Binding Purity}" />
                                                <Run Text="{Binding LatestPrice, StringFormat='(today ₹{0:N2}/g)'}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </dxe:ComboBoxEdit.ItemTemplate>
                                </dxe:ComboBoxEdit>
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Tenure (months)">
                                <dxe:SpinEdit EditValue="{Binding Editor.TenureMonths, Mode=TwoWay}"
                                              MinValue="1" MaxValue="12" IsFloatValue="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Fixed monthly amount">
                                <dxe:CheckEdit EditValue="{Binding Editor.AmountFixed, Mode=TwoWay}"
                                               Content="Same amount every month (uncheck: any amount between min and max)" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Minimum installment">
                                <dxe:TextEdit EditValue="{Binding Editor.MinInstallmentAmount, Mode=TwoWay}"
                                              MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Maximum installment">
                                <dxe:TextEdit EditValue="{Binding Editor.MaxInstallmentAmount, Mode=TwoWay}"
                                              MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"
                                              NullText="No limit" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Valid from">
                                <dxe:DateEdit EditValue="{Binding ValidFrom, Mode=TwoWay}" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Valid to">
                                <dxe:DateEdit EditValue="{Binding ValidTo, Mode=TwoWay}" NullText="Open" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Status">
                                <dxe:ComboBoxEdit ItemsSource="{Binding Statuses}"
                                                  EditValue="{Binding Editor.Status, Mode=TwoWay}"
                                                  IsTextEditable="False" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>

                        <dxlc:LayoutGroup Orientation="Vertical" View="GroupBox" Header="Missed installments and closure">
                            <dxlc:LayoutItem Label="Grace days">
                                <dxe:SpinEdit EditValue="{Binding Editor.GraceDays, Mode=TwoWay}" MinValue="0" IsFloatValue="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Max missed (keep bonus)">
                                <dxe:SpinEdit EditValue="{Binding Editor.MaxMissedForBonus, Mode=TwoWay}" MinValue="0" IsFloatValue="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Max missed before lapse">
                                <dxe:SpinEdit EditValue="{Binding Editor.MaxMissedBeforeLapse, Mode=TwoWay}" MinValue="0" IsFloatValue="False"
                                              NullText="Never lapses" AllowNullInput="True" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Min months for refund">
                                <dxe:SpinEdit EditValue="{Binding Editor.MinMonthsForRefund, Mode=TwoWay}" MinValue="0" IsFloatValue="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Refund deduction %">
                                <dxe:TextEdit EditValue="{Binding Editor.RefundDeductionPct, Mode=TwoWay}"
                                              MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Refund basis">
                                <dxe:ComboBoxEdit ItemsSource="{Binding RefundBases}"
                                                  EditValue="{Binding Editor.RefundBasis, Mode=TwoWay}"
                                                  IsTextEditable="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Pre-closure bonus">
                                <dxe:ComboBoxEdit ItemsSource="{Binding PreclosureBonuses}"
                                                  EditValue="{Binding Editor.PreclosureBonus, Mode=TwoWay}"
                                                  IsTextEditable="False" />
                            </dxlc:LayoutItem>
                            <dxlc:LayoutItem Label="Terms printed for the customer">
                                <dxe:TextEdit EditValue="{Binding Editor.TermsText, Mode=TwoWay}"
                                              Height="90"
                                              TextWrapping="Wrap"
                                              AcceptsReturn="True"
                                              VerticalContentAlignment="Top" />
                            </dxlc:LayoutItem>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutControl>

                    <!-- BENEFITS -->
                    <DockPanel Margin="5,10,5,4">
                        <TextBlock Text="Benefits"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Add benefit" Command="{Binding AddRuleCommand}" Padding="10,3" Margin="0,0,6,0" />
                            <Button Content="Remove benefit" Command="{Binding RemoveRuleCommand}" Padding="10,3" />
                        </StackPanel>
                    </DockPanel>

                    <dxg:GridControl ItemsSource="{Binding BenefitRules}"
                                     SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                     AutoGenerateColumns="None"
                                     Height="180"
                                     Margin="5,0">
                        <dxg:GridControl.View>
                            <dxg:TableView AllowEditing="True"
                                           ShowGroupPanel="False"
                                           NavigationStyle="Cell"
                                           NewItemRowPosition="None" />
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="BenefitType" Header="Benefit" Width="190">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.BenefitTypes, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                          IsTextEditable="False" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="BenefitValue" Header="Value (installments / % / grams)" Width="190">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="Numeric" Mask="n3" MaskUseAsDisplayFormat="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AppliesOn" Header="Applies on" Width="110">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.AppliesOnValues, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                          IsTextEditable="False" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="MinInstallmentsPaid" Header="Min installments paid" Width="140" />
                        <dxg:GridColumn FieldName="EligibleCategories" Header="Product categories (blank = all)" Width="*" />
                        <dxg:GridColumn FieldName="IsActive" Header="Active" Width="60" />
                    </dxg:GridControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
