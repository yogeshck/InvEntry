<UserControl x:Class="InvEntry.Views.CustomerOrders.CustomerOrderSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="620"
             Height="500"
             d:DesignWidth="620"
             d:DesignHeight="500">

    <UserControl.Resources>

        <Style x:Key="SummarySectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style x:Key="SummaryLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValue"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16">

            <TextBlock Text="Order Summary"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,0">

                <TextBlock Text="Order # "
                           Opacity="0.55"/>

                <TextBlock Text="{Binding Order.OrderNbr}"
                           FontWeight="SemiBold"/>

            </StackPanel>

        </StackPanel>


        <!-- =====================================================
             ORDER VALUES
             ===================================================== -->

        <Border Grid.Row="1"
                BorderBrush="#DCDCDC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Text="ORDER"
                           Style="{StaticResource SummarySectionTitle}"
                           Margin="0,0,0,8"/>

                <!-- Items -->

                <TextBlock Grid.Row="1"
                           Text="Items"
                           Style="{StaticResource SummaryLabel}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Order.OrderedItems}"
                           Style="{StaticResource SummaryValue}"/>

                <!-- Gross -->

                <TextBlock Grid.Row="2"
                           Text="Gross Weight"
                           Style="{StaticResource SummaryLabel}"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding Order.TotalGrossWeight,
                                          StringFormat={}{0:N3} g}"
                           Style="{StaticResource SummaryValue}"/>

                <!-- Net -->

                <TextBlock Grid.Row="3"
                           Text="Net Weight"
                           Style="{StaticResource SummaryLabel}"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding Order.TotalNetWeight,
                                          StringFormat={}{0:N3} g}"
                           Style="{StaticResource SummaryValue}"/>

                <!-- Making -->

                <TextBlock Grid.Row="4"
                           Text="Making Charges"
                           Style="{StaticResource SummaryLabel}"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding Order.TotalMakingCharges,
                                          StringFormat=₹ {0:N2}}"
                           Style="{StaticResource SummaryValue}"/>

                <!-- Tax -->

                <TextBlock Grid.Row="5"
                           Text="Tax"
                           Style="{StaticResource SummaryLabel}"/>

                <TextBlock Grid.Row="5"
                           Grid.Column="1"
                           Text="{Binding Order.TotalTaxAmount,
                                          StringFormat=₹ {0:N2}}"
                           Style="{StaticResource SummaryValue}"/>

                <!-- Total -->

                <Border Grid.Row="6"
                        Grid.ColumnSpan="2"
                        BorderBrush="#E4E4E4"
                        BorderThickness="0,1,0,0"
                        Padding="0,8,0,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Estimated Order Value"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Order.TotalOrderAmount,
                                                  StringFormat=₹ {0:N2}}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

            </Grid>

        </Border>


        <!-- =====================================================
             CUSTOMER CONTRIBUTION
             ===================================================== -->

        <Border Grid.Row="2"
                BorderBrush="#DCDCDC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Text="CUSTOMER CONTRIBUTION"
                           Style="{StaticResource SummarySectionTitle}"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1"
                           Text="Old Metal Net Weight"
                           Style="{StaticResource SummaryLabel}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Order.OldMetalNetWeight,
                                          StringFormat={}{0:N3} g}"
                           Style="{StaticResource SummaryValue}"/>

                <TextBlock Grid.Row="2"
                           Text="Advance Received"
                           Style="{StaticResource SummaryLabel}"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding Order.AdvancePaidAmount,
                                          StringFormat=₹ {0:N2}}"
                           Style="{StaticResource SummaryValue}"/>

            </Grid>

        </Border>


        <!-- =====================================================
             BALANCE
             ===================================================== -->

        <Border Grid.Row="3"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="ESTIMATED BALANCE"
                               FontSize="12"
                               FontWeight="Bold"
                               Opacity="0.65"/>

                    <TextBlock Text="Remaining value against this order"
                               FontSize="11"
                               Opacity="0.50"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Order.BalanceAmount,
                                          StringFormat=₹ {0:N2}}"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="25,0,0,0"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>