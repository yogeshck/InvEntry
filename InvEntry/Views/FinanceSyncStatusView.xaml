<UserControl x:Class="InvEntry.Views.FinanceSyncStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
             xmlns:ext="clr-namespace:InvEntry.Extension"
             d:DataContext="{d:DesignInstance Type=viewmodels:FinanceSyncStatusViewModel}"
             DataContext="{ext:DISource Type=viewmodels:FinanceSyncStatusViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1300">
    <!-- Singleton view model: refresh whenever the page is opened. -->
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded" Command="{Binding LoadCommand}" />
    </dxmvvm:Interaction.Behaviors>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- The banner sets its own light background and dark text, so it stays
             readable whatever the application theme's background is. -->
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="Background" Value="#FFF7F7F7" />
            <Setter Property="BorderBrush" Value="#FFDDDDDD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="8,8,8,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OverallState}" Value="OK">
                    <Setter Property="Background" Value="#FFE8F5E9" />
                    <Setter Property="BorderBrush" Value="#FFA5D6A7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallState}" Value="ATTENTION">
                    <Setter Property="Background" Value="#FFFFF8E1" />
                    <Setter Property="BorderBrush" Value="#FFFFCC80" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallState}" Value="PROBLEM">
                    <Setter Property="Background" Value="#FFFDECEC" />
                    <Setter Property="BorderBrush" Value="#FFF2B8B8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BannerText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF212121" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <dxb:BarContainerControl>
            <dxb:MainMenuControl>
                <dxb:BarButtonItem Content="Refresh"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   GlyphAlignment="Top"
                                   GlyphSize="Large"
                                   Glyph="{dx:DXImage 'Images/Actions/Refresh_32x32.png'}"
                                   IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}"
                                   Command="{Binding LoadCommand}" />
                <dxb:BarButtonItem Content="{Binding SendAllText}"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   GlyphAlignment="Top"
                                   GlyphSize="Large"
                                   Glyph="{dx:DXImage 'Images/Mail/Send_32x32.png'}"
                                   IsEnabled="{Binding CanSendAll}"
                                   Command="{Binding SendAllCommand}" />
            </dxb:MainMenuControl>
        </dxb:BarContainerControl>

        <!-- OVERALL STATE -->
        <Border Grid.Row="1" Style="{StaticResource Banner}">
            <StackPanel>
                <TextBlock Style="{StaticResource BannerText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding Headline}" />
                <TextBlock Style="{StaticResource BannerText}" Margin="0,2,0,0">
                    <Run Text="{Binding AutomaticSyncText, Mode=OneWay}" />
                    <Run Text="{Binding CheckedOnText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- PROBLEMS ONLY THE ADMINISTRATOR CAN FIX -->
        <ItemsControl Grid.Row="2"
                      Margin="8,0,8,4"
                      ItemsSource="{Binding Issues}"
                      Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFFDECEC" BorderBrush="#FFF2B8B8" BorderThickness="1"
                            CornerRadius="4" Padding="12,6" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Foreground="#FFB71C1C" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding Message}" />
                            <TextBlock Foreground="#FF212121" TextWrapping="Wrap"
                                       Text="{Binding NextStep, StringFormat='What to do: {0}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ENTRIES NOT (FULLY) IN FINANCETRACKER -->
        <dxg:GridControl Grid.Row="3"
                         Margin="8,0,8,8"
                         ItemsSource="{Binding Items}"
                         AutoGenerateColumns="None"
                         SelectionMode="Row">
            <dxg:GridControl.View>
                <dxg:TableView AllowEditing="False"
                               ShowGroupPanel="False"
                               AutoWidth="True"
                               ShowTotalSummary="True"
                               NavigationStyle="Row"
                               RowMinHeight="44" />
            </dxg:GridControl.View>
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="StateLabel" Header="Status" Width="140" />
                <dxg:GridColumn FieldName="Kind" Header="Type" Width="80" />
                <dxg:GridColumn FieldName="DocumentNo" Header="Invoice" Width="95" />
                <dxg:GridColumn FieldName="DocumentDate" Header="Date" Width="90">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="dd-MM-yyyy" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Amount" Header="Amount" Width="100">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="N2" HorizontalContentAlignment="Right" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Why" Width="300" AllowSorting="False">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RowData.Row.Reason}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="4,2" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Header="What to do" Width="300" AllowSorting="False">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RowData.Row.NextStep}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="4,2" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Header="" Width="80" AllowSorting="False">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dx:SimpleButton Content="Send" Padding="10,4"
                                Visibility="{Binding RowData.Row.CanSend, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.SendCommand, RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                                CommandParameter="{Binding RowData.Row}" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="TechnicalDetail" Header="Technical detail" Width="200" Visible="False"
                                ShowInColumnChooser="True" />
            </dxg:GridControl.Columns>
            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem FieldName="DocumentNo" SummaryType="Count" DisplayFormat="{}{0} entries" />
            </dxg:GridControl.TotalSummary>
        </dxg:GridControl>
    </Grid>
</UserControl>
