<UserControl x:Class="InvEntry.Views.CustomerOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:local="clr-namespace:InvEntry.Views"
             xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
             xmlns:ext="clr-namespace:InvEntry.Extension"
             xmlns:behavior="clr-namespace:InvEntry.Behavior"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1450"
             d:DataContext="{d:DesignInstance Type=viewmodels:CustomerOrderViewModel}"
             DataContext="{ext:DISource Type=viewmodels:CustomerOrderViewModel}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <Style TargetType="dxe:TextEdit">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style x:Key="CardBorderStyle"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="#DCDCDC"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Setter Property="Padding"
                    Value="16"/>
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Opacity"
                    Value="0.65"/>
            <Setter Property="Margin"
                    Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,6,10,6"/>
        </Style>

        <Style x:Key="NumberFormatWtStyle"
               TargetType="dxe:TextEditSettings">
            <Setter Property="MaskType"
                    Value="Numeric"/>
            <Setter Property="Mask"
                    Value="######.000"/>
            <Setter Property="MaskShowPlaceHolders"
                    Value="False"/>
            <Setter Property="MaskUseAsDisplayFormat"
                    Value="True"/>
            <Setter Property="dxe:NumericMaskOptions.AlwaysShowDecimalSeparator"
                    Value="False"/>
        </Style>

        <Style x:Key="NumberFormatStyle"
               TargetType="dxe:TextEdit">
            <Setter Property="MaskType"
                    Value="Numeric"/>
            <Setter Property="Mask"
                    Value="#,##,##,##,###.00"/>
            <Setter Property="MaskShowPlaceHolders"
                    Value="False"/>
            <Setter Property="MaskUseAsDisplayFormat"
                    Value="True"/>
            <Setter Property="Height"
                    Value="35"/>
        </Style>

        <Style x:Key="NumberFormatEditSettingsStyle"
               TargetType="dxe:TextEditSettings">
            <Setter Property="MaskType"
                    Value="Numeric"/>
            <Setter Property="Mask"
                    Value="#,##,##,##,###.00"/>
            <Setter Property="MaskShowPlaceHolders"
                    Value="False"/>
            <Setter Property="MaskUseAsDisplayFormat"
                    Value="True"/>
            <Setter Property="AllowNullInput"
                    Value="False"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="Auto"/>

            <!-- Customer + Order -->
            <RowDefinition Height="Auto"/>

            <!-- Search -->
            <RowDefinition Height="Auto"/>

            <!-- Tabs -->
            <RowDefinition Height="*"/>

            <!-- Order Summary -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Customer Order"
                           FontSize="24"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Create and manage custom ornament orders"
                           FontSize="13"
                           Opacity="0.60"
                           Margin="0,3,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="Reset"
                        Command="{Binding ResetCustomerOrderCommand}"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"/>

                <Button Content="Save Order"
                        Command="{Binding CreateCustomerOrderCommand}"
                        Width="125"
                        Height="36"/>

            </StackPanel>

        </Grid>


        <!-- =====================================================
             CUSTOMER + ORDER INFORMATION
             ===================================================== -->

        <Grid Grid.Row="1"
              Margin="0,0,0,14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>


            <!-- =================================================
                 CUSTOMER CARD
                 ================================================= -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">

                <StackPanel>

                    <TextBlock Text="CUSTOMER"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- Mobile -->

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Mobile"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:TextEdit Grid.Row="0"
                                      Grid.Column="1"
                                      Name="CustomerMobileNbr"
                                      EditValue="{Binding CustomerPhoneNumber}"
                                      FontSize="14">

                            <dxmvvm:Interaction.Behaviors>

                                <dxmvvm:EventToCommand
                                    EventName="EditValueChanged"
                                    Command="{Binding FetchCustomerCommand}"
                                    PassEventArgsToCommand="True"/>

                                <dxmvvm:EventToCommand
                                    EventName="Loaded"
                                    Command="{Binding FocusCommand}"
                                    CommandParameter="{Binding ElementName=CustomerMobileNbr}"/>

                            </dxmvvm:Interaction.Behaviors>

                        </dxe:TextEdit>


                        <!-- Name -->

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Name"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:TextEdit Grid.Row="1"
                                      Grid.Column="1"
                                      Name="CustomerNameUI"
                                      EditValue="{Binding Buyer.CustomerName}"
                                      IsReadOnly="{Binding CustomerReadOnly}"
                                      CharacterCasing="Upper"
                                      FontSize="15">

                            <dxmvvm:Interaction.Behaviors>
                                <behavior:FocusTextEditBehavior/>
                            </dxmvvm:Interaction.Behaviors>

                        </dxe:TextEdit>


                        <!-- City -->

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="City"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:TextEdit Grid.Row="2"
                                      Grid.Column="1"
                                      EditValue="{Binding Buyer.Address.City}"
                                      IsReadOnly="{Binding CustomerReadOnly}"
                                      CharacterCasing="Upper"
                                      FontSize="14"/>


                        <!-- State -->

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="State"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:ComboBoxEdit Grid.Row="3"
                                          Grid.Column="1"
                                          ItemsSource="{Binding StateReferencesList}"
                                          EditValue="{Binding CustomerState,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                          IsTextEditable="False"
                                          ImmediatePopup="True"
                                          Height="35"
                                          FontSize="14"/>

                    </Grid>

                </StackPanel>

            </Border>


            <!-- =================================================
                 ORDER INFORMATION CARD
                 ================================================= -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">

                <StackPanel>

                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="ORDER INFORMATION"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Order # "
                                       FontWeight="SemiBold"
                                       Opacity="0.60"/>

                            <TextBlock Text="{Binding Header.OrderNbr}"
                                       FontWeight="Bold"
                                       FontSize="15"/>

                        </StackPanel>

                    </Grid>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- Row 0 -->

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Reference"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:TextEdit Grid.Row="0"
                                      Grid.Column="1"
                                      EditValue="{Binding Header.OrderRefNbr}"
                                      Height="35"/>


                        <TextBlock Grid.Row="0"
                                   Grid.Column="3"
                                   Text="Order Date"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:DateEdit Grid.Row="0"
                                      Grid.Column="4"
                                      EditValue="{Binding Header.OrderDate}"
                                      Height="35"
                                      FontSize="14"/>


                        <!-- Row 1 -->

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Order Type"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:TextEdit Grid.Row="1"
                                      Grid.Column="1"
                                      EditValue="{Binding Header.OrderType}"
                                      Height="35"/>


                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Text="Expected Delivery"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:DateEdit Grid.Row="1"
                                      Grid.Column="4"
                                      EditValue="{Binding Header.OrderDueDate}"
                                      Height="35"
                                      FontSize="14"/>


                        <!-- Row 2 -->

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Status"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:ComboBoxEdit Grid.Row="2"
                                          Grid.Column="1"
                                          ItemsSource="{Binding CustOrdStatusList}"
                                          EditValue="{Binding OrderStatusUI,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                          IsTextEditable="False"
                                          Height="35"
                                          FontSize="14"/>


                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Text="Delivered On"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <dxe:DateEdit Grid.Row="2"
                                      Grid.Column="4"
                                      EditValue="{Binding Header.DeliveryDate}"
                                      Height="35"
                                      FontSize="14"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>


        <!-- =====================================================
             EXISTING ORDER SEARCH
             ===================================================== -->

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="12"
                Margin="0,0,0,14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Find Existing Order"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <dxe:TextEdit Grid.Column="1"
                              Name="SearchText"
                              NullText="Search by order number..."
                              EditValue="{Binding SearchText}"
                              Height="34"
                              FontSize="14">

                    <dxmvvm:Interaction.Behaviors>

                        <dxmvvm:EventToCommand
                            EventName="EditValueChanged"
                            Command="{Binding FetchCustomerOrderCommand}"
                            PassEventArgsToCommand="True"/>

                    </dxmvvm:Interaction.Behaviors>

                </dxe:TextEdit>

            </Grid>

        </Border>


        <!-- =====================================================
             EXISTING TAB SECTION STARTS HERE
             ===================================================== -->

        <dxlc:LayoutControl Grid.Row="3"
                            AllowItemSizing="True"
                            StretchContentVertically="True"
                            StretchContentHorizontally="True">

            <dxlc:LayoutGroup Orientation="Vertical">

                <!--
                    KEEP YOUR EXISTING:

                    <dxlc:LayoutGroup View="Tabs">
                        ...
                    </dxlc:LayoutGroup>

                    FROM THE OLD FILE HERE.
                -->





                <dxlc:LayoutGroup View="Tabs"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                    <!-- =====================================================
         ORDER SPECIFICATION
         ===================================================== -->

                    <dxlc:LayoutGroup Header="Order Specification"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="8,4"/>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>

                        <dxlc:LayoutItem HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">

                            <dxb:BarManager AllowCustomization="False">

                                <dxb:BarManager.Bars>

                                    <dxb:Bar AllowCollapse="False"
                             AllowQuickCustomization="False"
                             AllowRemove="False"
                             AllowCustomizationMenu="False"
                             ShowDragWidget="False">

                                        <dxb:BarEditItem EditValue="{Binding ProductIdUI}"
                                         Content="Product / Design"
                                         EditWidth="300"
                                         EditHeight="32">

                                            <dxb:BarEditItem.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                    ItemsSource="{Binding ProductCategoryList}"/>
                                            </dxb:BarEditItem.EditSettings>

                                        </dxb:BarEditItem>

                                        <dxb:BarButtonItem
                            Content="Add"
                            Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_AddCircled.svg'}"
                            Command="{Binding FetchProductCommand}"
                            GlyphSize="Large"
                            GlyphAlignment="Left"
                            BarItemDisplayMode="ContentAndGlyph"/>

                                    </dxb:Bar>

                                </dxb:BarManager.Bars>


                                <dxg:GridControl
                    x:Name="orderLinesUIGrid"
                    ItemsSource="{Binding Header.Lines}"
                    DeleteKeyBehavior="DeleteFocusedRow"
                    SelectedItems="{Binding SelectedRows}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FontSize="13">

                                    <dxg:GridControl.Resources>

                                        <Style x:Key="boldHeader"
                               TargetType="dxg:BaseGridHeader">
                                            <Setter Property="FontWeight"
                                    Value="Bold"/>
                                            <Setter Property="FontSize"
                                    Value="13"/>
                                        </Style>

                                        <Style TargetType="dxg:GridColumn">
                                            <Setter Property="HeaderStyle"
                                    Value="{StaticResource boldHeader}"/>
                                        </Style>

                                        <Style TargetType="dxe:TextEdit">
                                            <Setter Property="Width"
                                    Value="Auto"/>
                                            <Setter Property="EditValuePostMode"
                                    Value="Immediate"/>
                                        </Style>

                                    </dxg:GridControl.Resources>

                                    <dxg:GridControl.Columns>

                                        <dxg:GridColumn FieldName="ProductId"
                                        Header="Product"
                                        Width="130"
                                        ReadOnly="True"/>

                                        <dxg:GridColumn FieldName="ProductName"
                                        Header="Description"
                                        Width="220"
                                        ReadOnly="True"/>

                                        <dxg:GridColumn FieldName="ProductPurity"
                                        Header="Purity"
                                        Width="70"
                                        ReadOnly="True"/>

                                        <dxg:GridColumn FieldName="MetalRate"
                                        Header="Rate"
                                        Width="90"/>

                                        <dxg:GridColumn FieldName="ProdQty"
                                        Header="Qty"
                                        Width="55"/>

                                        <dxg:GridColumn FieldName="ProdGrossWeight"
                                        Header="Gross Wt."
                                        Width="85">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings
                                    Style="{StaticResource NumberFormatWtStyle}"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="ProdStoneWeight"
                                        Header="Stone Wt."
                                        Width="85">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings
                                    Style="{StaticResource NumberFormatWtStyle}"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="ProdNetWeight"
                                        Header="Net Wt."
                                        Width="85"
                                        ReadOnly="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings
                                    Style="{StaticResource NumberFormatWtStyle}"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="InvlStoneAmount"
                                        Header="Stone Amt."
                                        Width="95">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings
                                    Style="{StaticResource NumberFormatEditSettingsStyle}"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="VaPercent"
                                        Header="VA %"
                                        Width="65">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings
                                    Style="{StaticResource NumberFormatEditSettingsStyle}"/>
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="InvlTaxableAmount"
                                        Header="Taxable"
                                        Width="110"
                                        ReadOnly="True"/>

                                        <dxg:GridColumn FieldName="InvlTotal"
                                        Header="Amount"
                                        Width="115"
                                        ReadOnly="True"/>

                                    </dxg:GridControl.Columns>

                                    <dxg:GridControl.TotalSummary>

                                        <dxg:GridSummaryItem
                            SummaryType="Sum"
                            FieldName="InvlTaxableAmount"
                            DisplayFormat="Taxable: {0:n2}"/>

                                        <dxg:GridSummaryItem
                            SummaryType="Sum"
                            FieldName="InvlTotal"
                            DisplayFormat="Total: {0:n2}"/>

                                    </dxg:GridControl.TotalSummary>

                                    <dxg:GridControl.View>

                                        <dxg:TableView
                            AutoWidth="True"
                            NewItemRowPosition="None"
                            AllowGrouping="False"
                            AllowBestFit="True"
                            ShowGroupPanel="False"
                            TotalSummaryPosition="Bottom"
                            NavigationStyle="Cell"
                            ShowIndicator="False">

                                            <dxmvvm:Interaction.Behaviors>

                                                <dxmvvm:EventToCommand
                                    EventName="CellValueChanged"
                                    Command="{Binding CellUpdateCommand}"
                                    PassEventArgsToCommand="True"/>

                                            </dxmvvm:Interaction.Behaviors>

                                            <dxg:TableView.RowCellMenuCustomizations>

                                                <dxb:BarButtonItem
                                    Content="Delete Row"
                                    CommandParameter="{Binding Row.Row}"
                                    Command="{Binding DataContext.DeleteSingleRowCommand,
                                                      RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                                    Glyph="{dx:DXImage 'Images/Edit/Delete_32x32.png'}"/>

                                            </dxg:TableView.RowCellMenuCustomizations>

                                        </dxg:TableView>

                                    </dxg:GridControl.View>

                                </dxg:GridControl>

                            </dxb:BarManager>

                        </dxlc:LayoutItem>

                    </dxlc:LayoutGroup>


                    <!-- =====================================================
         OLD METAL
         ===================================================== -->

                    <dxlc:LayoutGroup Header="Old Metal"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="8,4"/>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>

                        <dxlc:LayoutItem HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">

                            <dxb:BarManager AllowCustomization="False">

                                <dxb:BarManager.Bars>

                                    <dxb:Bar AllowCollapse="False"
                             AllowQuickCustomization="False"
                             AllowRemove="False"
                             AllowCustomizationMenu="False"
                             ShowDragWidget="False">

                                        <dxb:BarButtonItem
                            Content="Add Old Metal"
                            Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_AddCircled.svg'}"
                            Command="{Binding EvaluateOldMetalTransactionCommand}"
                            GlyphSize="Large"
                            GlyphAlignment="Left"
                            BarItemDisplayMode="ContentAndGlyph"/>
                                    </dxb:Bar>

                                </dxb:BarManager.Bars>


                                <dxg:GridControl
                    ItemsSource="{Binding Header.OldMetalTransactions}"
                    DeleteKeyBehavior="DeleteFocusedRow"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FontSize="13">

                                    <dxg:GridControl.Resources>

                                        <Style x:Key="oldMetalHeader"
                               TargetType="dxg:BaseGridHeader">
                                            <Setter Property="FontWeight"
                                    Value="Bold"/>
                                        </Style>

                                        <Style TargetType="dxg:GridColumn">
                                            <Setter Property="HeaderStyle"
                                    Value="{StaticResource oldMetalHeader}"/>
                                        </Style>

                                    </dxg:GridControl.Resources>


                                    <dxg:GridControl.Columns>

                                        <dxg:GridColumn FieldName="ProductId"
                                        Header="Metal"
                                        Width="110">

                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                    ItemsSource="{Binding MetalList}"/>
                                            </dxg:GridColumn.EditSettings>

                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="Purity"
                                        Header="Purity"
                                        Width="70"
                                        ReadOnly="True"/>

                                        <dxg:GridColumn FieldName="TransactedRate"
                                        Header="Rate"
                                        Width="90"/>

                                        <dxg:GridColumn FieldName="GrossWeight"
                                        Header="Gross Wt."
                                        Width="90">

                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings
                                    Style="{StaticResource NumberFormatWtStyle}"/>
                                            </dxg:GridColumn.EditSettings>

                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="StoneWeight"
                                        Header="Stone Wt."
                                        Width="90">

                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings
                                    Style="{StaticResource NumberFormatWtStyle}"/>
                                            </dxg:GridColumn.EditSettings>

                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="WastageWeight"
                                        Header="Wastage Wt."
                                        Width="100">

                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings
                                    Style="{StaticResource NumberFormatWtStyle}"/>
                                            </dxg:GridColumn.EditSettings>

                                        </dxg:GridColumn>

                                        <dxg:GridColumn FieldName="NetWeight"
                                        Header="Net Wt."
                                        Width="90"
                                        ReadOnly="True"/>

                                        <dxg:GridColumn FieldName="Uom"
                                        Header="UOM"
                                        Width="70"
                                        ReadOnly="True"/>

                                        <dxg:GridColumn FieldName="TotalProposedPrice"
                                        Header="Proposed Value"
                                        Width="130"
                                        ReadOnly="True"/>

                                        <dxg:GridColumn FieldName="FinalPurchasePrice"
                                        Header="Final Value"
                                        Width="120"/>

                                    </dxg:GridControl.Columns>


                                    <dxg:GridControl.View>

                                        <dxg:TableView
                            AutoWidth="True"
                            AllowGrouping="False"
                            AllowBestFit="True"
                            ShowGroupPanel="False"
                            TotalSummaryPosition="Bottom"
                            NavigationStyle="Cell"
                            ShowIndicator="False">

                                            <dxmvvm:Interaction.Behaviors>

                                                <dxmvvm:EventToCommand
                                    EventName="CellValueChanged"
                                    Command="{Binding CellUpdateCommand}"
                                    PassEventArgsToCommand="True"/>

                                            </dxmvvm:Interaction.Behaviors>

                                            <dxg:TableView.RowCellMenuCustomizations>

                                                <dxb:BarButtonItem
                                    Content="Delete Row"
                                    CommandParameter="{Binding Row.Row}"
                                    Command="{Binding DataContext.DeleteSingleRowCommand,
                                                      RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                                    Glyph="{dx:DXImage 'Images/Edit/Delete_32x32.png'}"/>

                                            </dxg:TableView.RowCellMenuCustomizations>

                                        </dxg:TableView>

                                    </dxg:GridControl.View>

                                </dxg:GridControl>

                            </dxb:BarManager>

                        </dxlc:LayoutItem>

                    </dxlc:LayoutGroup>


                    <!-- =====================================================
         ADVANCE / RECEIPTS
         ===================================================== -->

                    <dxlc:LayoutGroup Header="Advance / Receipts"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

                        <dxlc:LayoutGroup.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="8,4"/>
                            </DataTemplate>
                        </dxlc:LayoutGroup.HeaderTemplate>

                        <dxlc:LayoutItem HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">

                            <dxb:BarManager AllowCustomization="False">

                                <dxb:BarManager.Bars>

                                    <dxb:Bar AllowCollapse="False"
                             AllowQuickCustomization="False"
                             AllowRemove="False"
                             AllowCustomizationMenu="False"
                             ShowDragWidget="False">

                                        <dxb:BarButtonItem
                            Content="Add Receipt"
                            Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_AddCircled.svg'}"
                            Command="{Binding ProcessAdvReceiptsCommand}"
                            GlyphSize="Large"
                            GlyphAlignment="Left"
                            BarItemDisplayMode="ContentAndGlyph"/>

                                    </dxb:Bar>

                                </dxb:BarManager.Bars>

                                <dxg:GridControl
                    ItemsSource="{Binding Header.AdvanceReceiptLines}"
                    DeleteKeyBehavior="DeleteFocusedRow"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FontSize="13">

                                    <dxg:GridControl.Resources>

                                        <Style x:Key="receiptHeader"
                               TargetType="dxg:BaseGridHeader">
                                            <Setter Property="FontWeight"
                                    Value="Bold"/>
                                        </Style>

                                        <Style TargetType="dxg:GridColumn">
                                            <Setter Property="HeaderStyle"
                                    Value="{StaticResource receiptHeader}"/>
                                        </Style>

                                    </dxg:GridControl.Resources>


                                    <dxg:GridControl.Columns>

                                        <dxg:GridColumn
                            FieldName="TransType"
                            Header="Payment Mode"
                            Width="180">

                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                    ItemsSource="{Binding PaymentModeList}"/>
                                            </dxg:GridColumn.EditSettings>

                                        </dxg:GridColumn>

                                        <dxg:GridColumn
                            FieldName="TransactionAmount"
                            Header="Amount"
                            Width="180"/>

                                    </dxg:GridControl.Columns>


                                    <dxg:GridControl.TotalSummary>

                                        <dxg:GridSummaryItem
                            SummaryType="Sum"
                            FieldName="TransactionAmount"
                            DisplayFormat="Advance Received: {0:n2}"/>

                                    </dxg:GridControl.TotalSummary>


                                    <dxg:GridControl.View>

                                        <dxg:TableView
                            AutoWidth="True"
                            AllowGrouping="False"
                            AllowBestFit="True"
                            ShowGroupPanel="False"
                            TotalSummaryPosition="Bottom"
                            NavigationStyle="Cell"
                            ShowIndicator="False">

                                            <dxmvvm:Interaction.Behaviors>

                                                <dxmvvm:EventToCommand
                                    EventName="CellValueChanged"
                                    Command="{Binding CellUpdateCommand}"
                                    PassEventArgsToCommand="True"/>

                                            </dxmvvm:Interaction.Behaviors>

                                            <dxg:TableView.RowCellMenuCustomizations>

                                                <dxb:BarButtonItem
                                    Content="Delete Row"
                                    CommandParameter="{Binding Row.Row}"
                                    Command="{Binding DataContext.DeleteSingleRowCommand,
                                                      RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                                    Glyph="{dx:DXImage 'Images/Edit/Delete_32x32.png'}"/>

                                            </dxg:TableView.RowCellMenuCustomizations>

                                        </dxg:TableView>

                                    </dxg:GridControl.View>

                                </dxg:GridControl>

                            </dxb:BarManager>

                        </dxlc:LayoutItem>

                    </dxlc:LayoutGroup>

                </dxlc:LayoutGroup>


            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

        <!-- =========================================================
     CUSTOMER ORDER SUMMARY
     ========================================================= -->

        <!-- =========================================================
     COMPACT ORDER STATUS / SUMMARY STRIP
     ========================================================= -->

        <Border Grid.Row="4"
        Margin="0,8,0,0"
        Padding="12,8"
        BorderBrush="#DCDCDC"
        BorderThickness="1"
        CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="35"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- ==========================
             ITEM COUNT
             ========================== -->

                <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock Text="Items"
                       FontSize="12"
                       Opacity="0.60"
                       VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding Header.OrderedItems}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center"/>

                </StackPanel>


                <!-- separator -->

                <Border Grid.Column="1"
                Width="1"
                Height="20"
                Background="#DCDCDC"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>


                <!-- ==========================
             GROSS WEIGHT
             ========================== -->

                <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock Text="Gross"
                       FontSize="12"
                       Opacity="0.60"
                       VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding Header.TotalGrossWeight,
                                     StringFormat={}{0:N3}}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center"/>

                    <TextBlock Text=" g"
                       FontSize="11"
                       Opacity="0.60"
                       VerticalAlignment="Center"/>

                </StackPanel>


                <!-- ==========================
             ESTIMATED ORDER VALUE
             ========================== -->

                <StackPanel Grid.Column="5"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock Text="Estimated Value"
                       FontSize="12"
                       Opacity="0.60"
                       VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding Header.TotalOrderAmount,
                                     StringFormat=₹ {0:N2}}"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"/>

                </StackPanel>


                <!-- separator -->

                <Border Grid.Column="6"
                Width="1"
                Height="20"
                Background="#DCDCDC"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>


                <!-- ==========================
             SUMMARY BUTTON
             ========================== -->

                <Button Grid.Column="7"
                Content="View Summary"
                Height="30"
                Padding="14,3"
                FontWeight="Bold"
                Command="{Binding ViewOrderSummaryCommand}"/>

            </Grid>

        </Border>


    </Grid>

</UserControl>
    