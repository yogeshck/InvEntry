<UserControl x:Class="InvEntry.Views.RdDuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
             xmlns:ext="clr-namespace:InvEntry.Extension"
             d:DataContext="{d:DesignInstance Type=viewmodels:RdDuesViewModel}"
             DataContext="{ext:DISource Type=viewmodels:RdDuesViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1300">
    <!-- Singleton view model: refresh whenever the page is opened. -->
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded" Command="{Binding LoadCommand}" />
    </dxmvvm:Interaction.Behaviors>

    <UserControl.Resources>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="Gainsboro" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="170" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <dxb:BarContainerControl>
            <dxb:MainMenuControl>
                <dxb:BarButtonItem Content="Load"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   GlyphAlignment="Top"
                                   GlyphSize="Large"
                                   Glyph="{dx:DXImage 'Images/Actions/Refresh_32x32.png'}"
                                   Command="{Binding LoadCommand}" />
                <dxb:BarButtonItem Content="Print"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   GlyphAlignment="Top"
                                   GlyphSize="Large"
                                   Glyph="{dx:DXImage 'Images/Print/PrintViaPDF_32x32.png'}"
                                   Command="{Binding PrintCommand}" />
                <dxb:BarButtonItem x:Name="btnExportExcel"
                                   Content="Export Excel"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   GlyphAlignment="Top"
                                   GlyphSize="Large"
                                   Glyph="{dx:DXImage 'Images/Export/ExportToXLSX_32x32.png'}"
                                   IsEnabled="{Binding HasRows}"
                                   ItemClick="btnExportExcel_ItemClick" />
            </dxb:MainMenuControl>
        </dxb:BarContainerControl>

        <!-- FILTERS -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,8,8,4">
            <TextBlock Text="Month" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="◀" Width="30" Command="{Binding PreviousMonthCommand}" ToolTip="Previous month" />
            <dxe:DateEdit EditValue="{Binding SelectedMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Mask="MMMM yyyy"
                          MaskType="DateTime"
                          MaskUseAsDisplayFormat="True"
                          Width="150"
                          Margin="2,0"
                          FontSize="14"
                          AllowNullInput="False" />
            <Button Content="▶" Width="30" Command="{Binding NextMonthCommand}" ToolTip="Next month" />
            <Button Content="This month" Margin="6,0,0,0" Padding="8,0" Command="{Binding ThisMonthCommand}" />

            <TextBlock Text="Show" VerticalAlignment="Center" Margin="24,0,6,0" />
            <dxe:ComboBoxEdit ItemsSource="{Binding Filters}"
                              EditValue="{Binding Filter, Mode=TwoWay}"
                              IsTextEditable="False"
                              Width="120"
                              FontSize="14" />

            <dxe:CheckEdit Content="Include earlier unpaid (arrears)"
                           IsChecked="{Binding IncludeArrears, Mode=TwoWay}"
                           Margin="24,0,0,0"
                           VerticalAlignment="Center" />
        </StackPanel>

        <!-- SUMMARY -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,4,8,8">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Still due" />
                    <TextBlock Style="{StaticResource CardValue}" Foreground="Firebrick"
                               Text="{Binding DueAmount, StringFormat='₹ {0:N2}'}" />
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding DueCount, StringFormat='{}{0} installment(s)'}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="of which arrears" />
                    <TextBlock Style="{StaticResource CardValue}"
                               Text="{Binding ArrearAmount, StringFormat='₹ {0:N2}'}" />
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding ArrearCount, StringFormat='{}{0} installment(s)'}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding MonthTitle, StringFormat='Collected in {0}'}" />
                    <TextBlock Style="{StaticResource CardValue}" Foreground="ForestGreen"
                               Text="{Binding CollectedAmount, StringFormat='₹ {0:N2}'}" />
                    <TextBlock Style="{StaticResource CardLabel}"
                               Text="{Binding CollectedCount, StringFormat='{}{0} installment(s)'}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- LIST -->
        <dxg:GridControl x:Name="gridControl"
                         Grid.Row="3"
                         Margin="8,0"
                         ItemsSource="{Binding Rows}"
                         AutoGenerateColumns="None"
                         SelectionMode="Row">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="AccountNbr" Header="RD No" Width="110" />
                <dxg:GridColumn FieldName="CustomerName" Header="Customer" Width="*" MinWidth="150" />
                <dxg:GridColumn FieldName="CustomerMobile" Header="Mobile" Width="105" />
                <dxg:GridColumn FieldName="PlanName" Header="Plan" Width="140" />
                <dxg:GridColumn FieldName="InstallmentText" Header="Inst." Width="60" HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings HorizontalContentAlignment="Center" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="DueDate" Header="Due date" Width="95">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="dd-MM-yyyy" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="AmountDue" Header="Installment" Width="95">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="N2" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="AmountPaid" Header="Paid" Width="90">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="#,##0.00;-#,##0.00;''" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Balance" Header="Balance due" Width="95">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="#,##0.00;-#,##0.00;''" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="CollectedInMonth" Header="Collected (month)" Width="110">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="#,##0.00;-#,##0.00;''" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="LastPaidOn" Header="Last paid" Width="95">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="dd-MM-yyyy" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="StatusText" Header="Status" Width="130" />
                <dxg:GridColumn FieldName="DaysOverdue" Header="Days late" Width="70">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="0;-0;''" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>

            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem FieldName="CustomerName" SummaryType="Count" DisplayFormat="{}{0} installment(s)" />
                <dxg:GridSummaryItem FieldName="AmountDue" SummaryType="Sum" DisplayFormat="N2" />
                <dxg:GridSummaryItem FieldName="AmountPaid" SummaryType="Sum" DisplayFormat="N2" />
                <dxg:GridSummaryItem FieldName="Balance" SummaryType="Sum" DisplayFormat="N2" />
                <dxg:GridSummaryItem FieldName="CollectedInMonth" SummaryType="Sum" DisplayFormat="N2" />
            </dxg:GridControl.TotalSummary>

            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView"
                               AllowEditing="False"
                               ShowTotalSummary="True"
                               ShowGroupPanel="True"
                               ShowAutoFilterRow="True"
                               AutoWidth="True"
                               NavigationStyle="Row"
                               ShowIndicator="False">
                    <dxg:TableView.FormatConditions>
                        <dxg:FormatCondition FieldName="StatusText" Expression="StartsWith([StatusText], 'Overdue')">
                            <dxg:FormatCondition.Format>
                                <dx:Format Foreground="Firebrick" FontWeight="SemiBold" />
                            </dxg:FormatCondition.Format>
                        </dxg:FormatCondition>
                        <dxg:FormatCondition FieldName="StatusText" Expression="[StatusText] = 'Paid'">
                            <dxg:FormatCondition.Format>
                                <dx:Format Foreground="ForestGreen" />
                            </dxg:FormatCondition.Format>
                        </dxg:FormatCondition>
                    </dxg:TableView.FormatConditions>
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>

        <TextBlock Grid.Row="4" Margin="8,6" Foreground="Gray" Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
