<UserControl x:Class="InvEntry.Views.Common.DocumentListView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
 xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
 xmlns:behavior="clr-namespace:InvEntry.Behavior">
 <dxmvvm:Interaction.Behaviors><dxmvvm:EventToCommand EventName="Loaded" Command="{Binding RefreshCommand}"/></dxmvvm:Interaction.Behaviors>
 <UserControl.Resources>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Opacity" Value="0.68"/></Style>
  <Style x:Key="Action" TargetType="{x:Type dx:SimpleButton}"><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="94"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
 </UserControl.Resources>
 <Grid>
  <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Opacity="0.35"/>
  <Grid Margin="20,16,20,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.Row="0" CornerRadius="12" Padding="18,14" Margin="0,0,0,12" BorderThickness="1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="7" CornerRadius="4" Margin="0,1,14,1" Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
     <StackPanel Grid.Column="1"><TextBlock Text="{Binding ContextLabel, ElementName=Root}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock Text="{Binding Description}" FontSize="13" Opacity="0.66" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
     <dx:SimpleButton Grid.Column="2" Style="{StaticResource Action}" Content="Refresh" Glyph="{dx:DXImage 'Images/Actions/Refresh_16x16.png'}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Border Grid.Row="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" BorderThickness="1">
    <WrapPanel VerticalAlignment="Bottom">
     <StackPanel Width="160" Margin="0,0,12,4"><TextBlock Text="FROM DATE" Style="{StaticResource Caption}" Margin="2,0,0,5"/><dxe:DateEdit EditValue="{Binding SearchOption.From, UpdateSourceTrigger=PropertyChanged}" DisplayFormatString="dd-MMM-yyyy"/></StackPanel>
     <StackPanel Width="160" Margin="0,0,12,4"><TextBlock Text="TO DATE" Style="{StaticResource Caption}" Margin="2,0,0,5"/><dxe:DateEdit EditValue="{Binding SearchOption.To, UpdateSourceTrigger=PropertyChanged}" MaxValue="{Binding Today}" DisplayFormatString="dd-MMM-yyyy"/></StackPanel>
     <StackPanel Width="240" Margin="0,0,12,4"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTextFilter}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding FilterDefinition.Label}" Style="{StaticResource Caption}" Margin="2,0,0,5"/><dxe:TextEdit EditValue="{Binding SearchOption.FilterValue, UpdateSourceTrigger=PropertyChanged}" NullText="{Binding FilterDefinition.Placeholder}"><dxmvvm:Interaction.Behaviors><dxmvvm:KeyToCommand KeyGesture="Enter" Command="{Binding RefreshCommand}"/></dxmvvm:Interaction.Behaviors></dxe:TextEdit></StackPanel>
     <StackPanel Width="220" Margin="0,0,12,4"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelectionFilter}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding FilterDefinition.Label}" Style="{StaticResource Caption}" Margin="2,0,0,5"/><dxe:ComboBoxEdit ItemsSource="{Binding FilterDefinition.Options}" EditValue="{Binding SearchOption.FilterValue, UpdateSourceTrigger=PropertyChanged}" IsTextEditable="False"/></StackPanel>
     <dx:SimpleButton Style="{StaticResource Action}" Content="Search" Glyph="{dx:DXImage 'Images/Find/Find_16x16.png'}" Command="{Binding RefreshCommand}" Margin="0,17,0,4"/>
     <dx:SimpleButton Style="{StaticResource Action}" Content="Clear" Glyph="{dx:DXImage 'Images/Actions/Clear_16x16.png'}" Command="{Binding ResetCommand}" Margin="8,17,0,4"/>
    </WrapPanel>
   </Border>
   <Grid Grid.Row="2" Margin="3,0,3,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="RESULTS" Style="{StaticResource Caption}"/><Border Margin="10,0,0,0" Padding="9,3" CornerRadius="10" BorderThickness="1"><TextBlock Text="{Binding Items.Count, StringFormat={}{0:N0} records}" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel><dx:SimpleButton Grid.Column="1" Style="{StaticResource Action}" Content="Print Selected" Glyph="{dx:DXImage 'Images/Print/Print_16x16.png'}" Command="{Binding PrintSelectedCommand}"/></Grid>
   <Border Grid.Row="3" CornerRadius="10" BorderThickness="1" ClipToBounds="True"><Grid>
    <dxg:GridControl ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" AutoGenerateColumns="None"><dxmvvm:Interaction.Behaviors><behavior:DynamicGridColumnsBehavior Columns="{Binding Columns}"/><behavior:DynamicGridFormattingBehavior RowFormats="{Binding RowFormats}"/></dxmvvm:Interaction.Behaviors><dxg:GridControl.View><dxg:TableView AllowEditing="False" AllowGrouping="False" ShowGroupPanel="False" ShowAutoFilterRow="True" ShowTotalSummary="True" NavigationStyle="Row" AutoWidth="False" AllowBestFit="True" ShowIndicator="False" VerticalScrollbarVisibility="Auto" HorizontalScrollbarVisibility="Auto" AllowPerPixelScrolling="True" RowMinHeight="30"/></dxg:GridControl.View></dxg:GridControl>
    <Border Padding="28" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsBusy}" Value="False"/><Condition Binding="{Binding HasItems}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"><TextBlock Text="No records to display" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Adjust the date range or filter, then choose Search." TextAlignment="Center" TextWrapping="Wrap" Opacity="0.65" Margin="0,7,0,0"/><TextBlock Text="{Binding StatusMessage}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasLoadError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
    <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Opacity="0.92" Visibility="{Binding IsBusy, Converter={dxmvvm:BooleanToVisibilityConverter}}"><dx:WaitIndicator DeferedVisibility="True" Content="Loading records..." HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </Grid></Border>
   <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" FontSize="12" Opacity="0.68" Margin="4,8,4,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</UserControl>