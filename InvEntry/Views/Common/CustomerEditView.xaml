<UserControl x:Class="InvEntry.Views.Common.CustomerEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="850"
             Width="850"
             Height="600">

    <!-- =====================================================
         CUSTOMER EDIT VIEW

         - Fixed practical dialog size
         - Two-column desktop layout
         - Scrollable form
         - Save/Cancel always visible
         ===================================================== -->

    <UserControl.Resources>

        <!-- Local TextEdit style -->
        <Style TargetType="{x:Type dxe:TextEdit}"
               BasedOn="{StaticResource {x:Type dxe:TextEdit}}">
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Margin"
                    Value="4,5"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- Local ComboBox style -->
        <Style TargetType="{x:Type dxe:ComboBoxEdit}"
               BasedOn="{StaticResource {x:Type dxe:ComboBoxEdit}}">
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Margin"
                    Value="4,5"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- Labels -->
        <Style x:Key="CustomerFieldLabel"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="4,5,8,5"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <!-- Form -->
            <RowDefinition Height="*"/>

            <!-- Error -->
            <RowDefinition Height="Auto"/>

            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =================================================
             SCROLLABLE FORM
             ================================================= -->

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- =========================================
                     CUSTOMER DETAILS
                     ========================================= -->

                <Border BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="Customer Details"
                                   Style="{StaticResource SectionHeader}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>

                                <!-- separator -->
                                <ColumnDefinition Width="25"/>

                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <!-- =========================
                                 ROW 0
                                 ========================= -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Mobile Number"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="0"
                                          Grid.Column="1"
                                          EditValue="{Binding CurrentCustomer.MobileNbr,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                          IsReadOnly="True"/>


                            <TextBlock Grid.Row="0"
                                       Grid.Column="3"
                                       Text="Customer Name"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="0"
                                          Grid.Column="4"
                                          EditValue="{Binding CurrentCustomer.CustomerName,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <!-- =========================
                                 ROW 1
                                 ========================= -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="GSTIN"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="1"
                                          Grid.Column="1"
                                          EditValue="{Binding CurrentCustomer.GstinNbr,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <TextBlock Grid.Row="1"
                                       Grid.Column="3"
                                       Text="PAN"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="1"
                                          Grid.Column="4"
                                          EditValue="{Binding CurrentCustomer.PanNbr,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <!-- =========================
                                 ROW 2
                                 ========================= -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Salutation"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="2"
                                          Grid.Column="1"
                                          EditValue="{Binding CurrentCustomer.Salutations,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <TextBlock Grid.Row="2"
                                       Grid.Column="3"
                                       Text="Customer Type"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="2"
                                          Grid.Column="4"
                                          EditValue="{Binding CurrentCustomer.CustomerType,
                                                              UpdateSourceTrigger=PropertyChanged}"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- =========================================
                     ADDRESS
                     ========================================= -->

                <Border BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="Address"
                                   Style="{StaticResource SectionHeader}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>

                                <!-- separator -->
                                <ColumnDefinition Width="25"/>

                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <!-- =========================
                                 ROW 0
                                 ========================= -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Address Line 1"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="0"
                                          Grid.Column="1"
                                          EditValue="{Binding CurrentCustomer.Address.AddressLine1,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <TextBlock Grid.Row="0"
                                       Grid.Column="3"
                                       Text="Address Line 2"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="0"
                                          Grid.Column="4"
                                          EditValue="{Binding CurrentCustomer.Address.AddressLine2,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <!-- =========================
                                 ROW 1
                                 ========================= -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Address Line 3"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="1"
                                          Grid.Column="1"
                                          EditValue="{Binding CurrentCustomer.Address.AddressLine3,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <TextBlock Grid.Row="1"
                                       Grid.Column="3"
                                       Text="Area"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="1"
                                          Grid.Column="4"
                                          EditValue="{Binding CurrentCustomer.Address.Area,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <!-- =========================
                                 ROW 2
                                 ========================= -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="City"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="2"
                                          Grid.Column="1"
                                          EditValue="{Binding CurrentCustomer.Address.City,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <TextBlock Grid.Row="2"
                                       Grid.Column="3"
                                       Text="District"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="2"
                                          Grid.Column="4"
                                          EditValue="{Binding CurrentCustomer.Address.District,
                                                              UpdateSourceTrigger=PropertyChanged}"/>


                            <!-- =========================
                                 ROW 3
                                 ========================= -->

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="State"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:ComboBoxEdit Grid.Row="3"
                                              Grid.Column="1"
                                              ItemsSource="{Binding StateReferencesList}"
                                              EditValue="{Binding CustomerState,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                              IsTextEditable="False"
                                              ImmediatePopup="True"/>


                            <TextBlock Grid.Row="3"
                                       Grid.Column="3"
                                       Text="Pincode"
                                       Style="{StaticResource CustomerFieldLabel}"/>

                            <dxe:TextEdit Grid.Row="3"
                                          Grid.Column="4"
                                          EditValue="{Binding CurrentCustomer.Address.Pincode,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                          MaxLength="6"/>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- =================================================
             ERROR MESSAGE
             ================================================= -->

        <Border Grid.Row="1"
                Background="#FFF4F4"
                BorderBrush="#E0A0A0"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8"
                Margin="0,8,0,4">

            <Border.Style>
                <Style TargetType="Border">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding ErrorMessage}"
                                     Value="{x:Null}">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                        </DataTrigger>

                        <DataTrigger Binding="{Binding ErrorMessage}"
                                     Value="">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </Border.Style>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="DarkRed"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

        </Border>


        <!-- =================================================
             BOTTOM COMMAND BAR
             Always visible
             ================================================= -->

        <Border Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,8,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Busy status -->

                <TextBlock Grid.Column="0"
                           Text="Saving customer..."
                           VerticalAlignment="Center"
                           FontStyle="Italic">

                    <TextBlock.Style>

                        <Style TargetType="TextBlock">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsBusy}"
                                             Value="True">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </TextBlock.Style>

                </TextBlock>


                <!-- Commands -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Width="105"
                            Height="36"
                            Margin="5,0"/>

                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Width="105"
                            Height="36"
                            Margin="5,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>