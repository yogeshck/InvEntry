<Window x:Class="InvEntry.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Product"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="14">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Product Id" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" Margin="0,4,8,4" />

        <TextBlock Grid.Row="0" Grid.Column="2" Text="Name *" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" VerticalAlignment="Center" Margin="0,4,8,4" />
        <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" ItemsSource="{Binding Categories}"
                  Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4" />

        <TextBlock Grid.Row="1" Grid.Column="2" Text="Metal" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Metal, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Purity" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Purity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4" />

        <TextBlock Grid.Row="2" Grid.Column="2" Text="Purity %" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding PurityPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Brand" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4" />

        <TextBlock Grid.Row="3" Grid.Column="2" Text="Model" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="HSN code" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding HsnCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4" />

        <TextBlock Grid.Row="4" Grid.Column="2" Text="Tax rule" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding TaxRule, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="UOM" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Uom, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4" />

        <TextBlock Grid.Row="5" Grid.Column="2" Text="Base unit" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding BaseUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Stock group" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding StockGroup, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Description" VerticalAlignment="Top" Margin="0,4,8,4" />
        <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

        <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox Content="Taxable" IsChecked="{Binding IsTaxable}" VerticalAlignment="Center" Margin="0,0,24,0" />
            <CheckBox Content="Active" IsChecked="{Binding IsActive}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4" Foreground="#C62828" TextWrapping="Wrap"
                   Margin="0,12,0,0" Text="{Binding Error}" />

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="110" Height="34" IsDefault="True" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Width="110" Height="34" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
