<dxwui:NavigationPage x:Class="InvEntry.Views.BarCodeTagListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
    xmlns:behavior="clr-namespace:InvEntry.Behavior"
    xmlns:controls="clr-namespace:InvEntry.Controls"
    xmlns:converters="clr-namespace:InvEntry.Converters"
    xmlns:ext="clr-namespace:InvEntry.Extension"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:BarCodeTagListViewModel}"
    DataContext="{ext:DISource Type=viewmodels:BarCodeTagListViewModel}"
    d:DesignHeight="900" d:DesignWidth="1400">

    <dxwui:NavigationPage.Resources>
        <converters:BarcodeMaintenanceEligibilityConverter x:Key="EligibilityConverter"/>
    </dxwui:NavigationPage.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="210"/>
        </Grid.RowDefinitions>

        <dxb:BarContainerControl>
            <dxb:MainMenuControl FontSize="14" Height="58">
                <dxb:BarEditItem Content="Category" EditWidth="170" EditHeight="34" EditValue="{Binding SelectedCategory, Mode=TwoWay}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings ItemsSource="{Binding ProductCategoryList}" IsTextEditable="False" NullText="All categories"/>
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarEditItem Content="SKU / Barcode" EditWidth="220" EditHeight="34" EditValue="{Binding SelectedProductSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings ItemsSource="{Binding ProductSkuStrList}" IsTextEditable="True" ImmediatePopup="False" NullText="Scan or enter exact SKU"/>
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarButtonItem Content="Search / Refresh" Glyph="{dx:DXImage 'Images/Actions/Refresh_32x32.png'}" GlyphSize="Large" Command="{Binding RefreshBarcodeCommand}"/>
                <dxb:BarButtonItem Content="Clear" Glyph="{dx:DXImage 'Images/Actions/Clear_32x32.png'}" GlyphSize="Large" Command="{Binding ResetFormCommand}"/>
                <dxb:BarItemSeparator Margin="4,0"/>
                <dxb:BarButtonItem x:Name="btnPrintGrid" Content="Export" Glyph="{dx:DXImage 'Images/Print/PrintViaPDF_32x32.png'}" GlyphSize="Large"/>
            </dxb:MainMenuControl>
        </dxb:BarContainerControl>

        <Border Grid.Row="1" Margin="0,6,0,8" Padding="10,7" CornerRadius="4" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ProductStockList.Count, StringFormat={}{0} record(s)}" Foreground="#64748B"/>
                <TextBlock Text="{Binding MaintenanceStatus}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsErrorStatus}" Value="True"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsPrintingTag}" Value="True"><Setter Property="Foreground" Value="#0369A1"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <dxg:GridControl Grid.Row="2" ItemsSource="{Binding ProductStockList}" AutoGenerateColumns="None"
                         x:Name="BarcodeGrid" SelectedItem="{Binding SelectedGridLine, Mode=TwoWay}">
            <dxmvvm:Interaction.Behaviors>
                <behavior:PrintGridBehavior BarButtonItem="{Binding ElementName=btnPrintGrid}"/>
            </dxmvvm:Interaction.Behaviors>
            <dxg:GridControl.View>
                <dxg:TableView ShowGroupPanel="False" AllowEditing="False" AllowGrouping="False"
                               ShowAutoFilterRow="True" AutoWidth="False" AllowBestFit="True"
                               NavigationStyle="Row" VerticalScrollbarVisibility="Auto">
                    <dxg:TableView.RowStyle>
                        <Style TargetType="dxg:RowControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DuplicateFlag}" Value="D"><Setter Property="Background" Value="#FFF1F2"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:TableView.RowStyle>
                </dxg:TableView>
            </dxg:GridControl.View>
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="GKey" Header="Stock GKey" Width="90"/>
                <dxg:GridColumn FieldName="ProductSku" Header="Product SKU" Width="125" SortOrder="Ascending"/>
                <dxg:GridColumn FieldName="Category" Header="Category" Width="105"/>
                <dxg:GridColumn FieldName="GrossWeight" Header="Gross Weight" Width="105">
                    <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="n3" HorizontalContentAlignment="Right"/></dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="StoneWeight" Header="Stone Weight" Width="105">
                    <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="n3" HorizontalContentAlignment="Right"/></dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="NetWeight" Header="Net Weight" Width="105">
                    <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="n3" HorizontalContentAlignment="Right"/></dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="BalanceWeight" Header="Balance" Width="95">
                    <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="n3" HorizontalContentAlignment="Right"/></dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="Status" Header="Stock Status" Width="100"/>
                <dxg:GridColumn Header="Maintenance Eligibility" Width="210" AllowSorting="False">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RowData.Row, Converter={StaticResource EligibilityConverter}}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="IsProductSold" Header="Sold" Width="60"/>
                <dxg:GridColumn FieldName="IsBarcodePrinted" Header="Barcode Printed" Width="105"/>
                <dxg:GridColumn FieldName="DuplicateFlag" Header="Duplicate" Width="75"/>
                <dxg:GridColumn Header="Preview" Width="82" AllowSorting="False">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dx:SimpleButton Content="Preview" Padding="10,4"
                                Command="{Binding DataContext.PreviewTagCommand, RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                                CommandParameter="{Binding RowData.Row}"/>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Header="Reprint" Width="82" AllowSorting="False">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dx:SimpleButton Content="Reprint" Padding="10,4"
                                Command="{Binding DataContext.ReprintTagCommand, RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                                CommandParameter="{Binding RowData.Row}"/>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
        </dxg:GridControl>

        <GridSplitter Grid.Row="3" Height="7" Margin="0,4" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="#CBD5E1" ShowsPreview="True"/>

        <Border Grid.Row="4" MinHeight="210" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8">
            <TabControl>
                <TabItem Header="Tag Preview">
                    <Grid Background="#172033">
                        <TabControl Background="#172033" BorderThickness="0">
                            <TabControl.Style>
                                <Style TargetType="TabControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLabelPreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TabControl.Style>
                            <TabItem Header="Fit to Panel">
                                <Grid Background="#172033">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <controls:JewelleryTagPreview Source="{Binding LabelPreviewImage}" Zpl="{Binding LabelPreviewZpl}" Mode="Fit" Margin="10"/>
                                    <TextBlock Grid.Row="1" Text="Physical tag layout simulation &#x2014; printer alignment not calibrated."
                                               Foreground="#FBBF24" FontSize="10" TextWrapping="Wrap"
                                               TextAlignment="Center" HorizontalAlignment="Center" Margin="12,4,12,2"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Actual Pixels">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#172033">
                                    <StackPanel Margin="10">
                                        <controls:JewelleryTagPreview Width="1000" Height="130" HorizontalAlignment="Left"
                                                                      Source="{Binding LabelPreviewImage}" Zpl="{Binding LabelPreviewZpl}" Mode="ActualPixels"/>
                                        <TextBlock Text="Physical tag layout simulation &#x2014; printer alignment not calibrated."
                                                   Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="24" Focusable="False">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLabelPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Grid MinHeight="120">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#334155" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock Text="i" Foreground="#FBBF24" FontSize="24" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding PreviewStatusHeading}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding PreviewStatusMessage}" Foreground="#CBD5E1" FontSize="13"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Raw ZPL Preview">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Border Width="700" Height="250" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                            <controls:PixelPerfectImage Source="{Binding LabelPreviewImage}" Mode="ActualPixels"/>
                        </Border>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="ZPL Text">
                    <dxe:MemoEdit EditValue="{Binding LabelPreviewZpl}" IsReadOnly="True" FontFamily="Consolas"
                                  FontSize="11" ShowBorder="False" NullText="Preview a stock record to generate ZPL"/>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</dxwui:NavigationPage>
