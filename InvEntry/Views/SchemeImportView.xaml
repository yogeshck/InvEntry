<UserControl x:Class="InvEntry.Views.SchemeImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewmodels="clr-namespace:InvEntry.ViewModels"
             xmlns:ext="clr-namespace:InvEntry.Extension"
             d:DataContext="{d:DesignInstance Type=viewmodels:SchemeImportViewModel}"
             DataContext="{ext:DISource Type=viewmodels:SchemeImportViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1300">
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand EventName="Loaded"
                               Command="{Binding LoadPlansCommand}" />
    </dxmvvm:Interaction.Behaviors>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- PLAN AND ACTIONS -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Import into plan"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="0,0,8,0" />
            <dxe:ComboBoxEdit ItemsSource="{Binding Plans}"
                              EditValue="{Binding SelectedPlan, Mode=TwoWay}"
                              DisplayMember="PlanName"
                              IsTextEditable="False"
                              Width="280"
                              NullText="Amount plan with fixed monthly amount" />
            <Button Content="Preview"
                    Command="{Binding PreviewCommand}"
                    Width="110" Height="30" Margin="12,0,0,0"
                    FontWeight="SemiBold" />
            <Button Content="Import"
                    Command="{Binding ImportCommand}"
                    IsEnabled="{Binding CanImport}"
                    Width="110" Height="30" Margin="8,0,0,0"
                    FontWeight="SemiBold" />
            <Button Content="Clear"
                    Command="{Binding ClearCommand}"
                    Width="80" Height="30" Margin="8,0,0,0" />
            <TextBlock Text="Copy each sheet in Excel including its header row (Ctrl+A, Ctrl+C) and paste below. Nothing is saved until you press Import."
                       VerticalAlignment="Center"
                       Opacity="0.75"
                       Margin="16,0,0,0"
                       TextWrapping="Wrap"
                       MaxWidth="420" />
        </StackPanel>

        <!-- PASTED SHEETS -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,4,0">
                <TextBlock DockPanel.Dock="Top" Text="RD master (RD ID, MobileNumber, Scheme Duration, Monthly Amount, Start Date, ...)" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox Text="{Binding MasterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" FontSize="11"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Payment ledger (RD ID, Customer, Tran ID, Due Date, Paid Date, Amount Paid, Payment Mode, Receipt Number)" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox Text="{Binding PaymentsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" FontSize="11"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>

        <!-- SUMMARY -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Summary}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,10,0,4" />
        <!-- Own background so the messages stay readable on dark and light themes. -->
        <Border Grid.Row="3"
                Background="#FDECEA"
                BorderBrush="#E57373"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8,6"
                Margin="0,0,0,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Problems}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Problems}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Problems}"
                       Foreground="#FDECEA"
                       Background="Black"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <!-- RESULTS -->
        <dxg:GridControl Grid.Row="4"
                         ItemsSource="{Binding Results}"
                         AutoGenerateColumns="None">
            <dxg:GridControl.View>
                <dxg:TableView AllowEditing="False"
                               ShowGroupPanel="False"
                               NavigationStyle="Row"
                               AutoWidth="True" />
            </dxg:GridControl.View>
            <dxg:GridColumn FieldName="LegacyId" Header="RD ID" Width="110" />
            <dxg:GridColumn FieldName="Outcome" Header="Result" Width="120" />
            <dxg:GridColumn FieldName="CustomerName" Header="Customer" Width="140" />
            <dxg:GridColumn FieldName="MobileNumber" Header="Mobile" Width="100" />
            <dxg:GridColumn FieldName="MonthlyAmount" Header="Monthly" Width="80">
                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" /></dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="StartDate" Header="Start" Width="90" />
            <dxg:GridColumn FieldName="MaturityDate" Header="Matures" Width="90" />
            <dxg:GridColumn FieldName="PaymentCount" Header="Payments" Width="70" />
            <dxg:GridColumn FieldName="TotalPaid" Header="Paid" Width="90">
                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" /></dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="TotalDue" Header="Scheme total" Width="90">
                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" /></dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="Outstanding" Header="Still to pay" Width="90">
                <dxg:GridColumn.EditSettings><dxe:TextEditSettings DisplayFormat="N0" /></dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="InstallmentsPaid" Header="Paid inst." Width="70" />
            <dxg:GridColumn FieldName="IssueText" Header="Errors and warnings" Width="420" />
        </dxg:GridControl>
    </Grid>
</UserControl>
